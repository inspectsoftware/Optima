<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Optima.Watchdog</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.18" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Optima.Core\Optima.Core.csproj" />
  </ItemGroup>

  <!-- The helper starts Optima Shield only when the file beside it is the one this build was made
       with, so that file's SHA-256 is written into the helper here. Without the file (a build from
       source) nothing is written, and the helper refuses the command. -->
  <Target Name="StampShield" BeforeTargets="GetAssemblyAttributes" Condition="Exists('..\..\vendor\shield\Optima.Shield.exe')">
    <GetFileHash Files="..\..\vendor\shield\Optima.Shield.exe" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="ShieldSha256" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyMetadata Include="ShieldSha256" Value="$(ShieldSha256)" />
    </ItemGroup>
  </Target>
</Project>
