<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:COPSBootstrapper.App.Converters">

  <!-- Shared converters -->
  <BooleanToVisibilityConverter x:Key="BoolToVis" />
  <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
  <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
  <conv:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />
  <conv:StatusKindToBrushConverter x:Key="StatusKindBrush" />
  <conv:DiagnosticStatusToBrushConverter x:Key="DiagStatusBrush" />
  <conv:DiagnosticStatusToTextConverter x:Key="DiagStatusText" />
  <conv:LogLevelToBrushConverter x:Key="LogLevelBrush" />

  <!-- One STATUS row: label · value · colored dot -->
  <DataTemplate x:Key="StatusItemTemplate">
    <Grid Margin="0,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
               Fill="{Binding Kind, Converter={StaticResource StatusKindBrush}}" />
      <TextBlock Grid.Column="1" Text="{Binding Label}"
                 Foreground="#FF9AA3B2" FontSize="13" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="13" FontWeight="Medium"
                 Foreground="#FFE8EAEF" VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <!-- Base text -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="Text.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style x:Key="Text.Value" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style x:Key="Text.Metric" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
  </Style>

  <!-- Card -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <!-- Sidebar nav button -->
  <Style x:Key="NavButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="14,10" Margin="8,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5"
                      Background="Transparent" Margin="0,0,10,0" />
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
              <Setter TargetName="Indicator" Property="Background" Value="{StaticResource Brush.Accent}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Primary (PLAY) button -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Foreground" Value="#FF140904" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="28,14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Secondary button -->
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6"
                  BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ComboBox / ListBox / TextBox / CheckBox restyled minimally for dark mode -->
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CaretBrush" Value="{StaticResource Brush.Text}" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="6" />
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Background" Value="{StaticResource Brush.Border}" />
    <Setter Property="Margin" Value="0,10" />
  </Style>

  <!-- Scrollbar slimming -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
</ResourceDictionary>
