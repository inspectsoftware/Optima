<UserControl x:Class="COPSBootstrapper.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="DIAGNOSTICS" Style="{StaticResource Text.PageTitle}" />
      <Grid Margin="0,0,0,20">
        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Brush.TextMuted}" FontSize="13"
                   VerticalAlignment="Center" />
        <Button Style="{StaticResource SecondaryButton}" Content="Run all checks" HorizontalAlignment="Right"
                Command="{Binding RunAllCommand}" />
      </Grid>

      <ProgressBar IsIndeterminate="True" Margin="0,0,0,12"
                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

      <ItemsControl ItemsSource="{Binding Results}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="66" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Background="{Binding Status, Converter={StaticResource DiagStatusBrush}}"
                        CornerRadius="4" Padding="0,3" Width="52" Height="24"
                        VerticalAlignment="Top" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Status, Converter={StaticResource DiagStatusText}}"
                             FontSize="11" FontWeight="Bold" Foreground="#FF10131A"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding CheckName}" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" Margin="0,3,0,0" />
                  <TextBlock Text="{Binding RecommendedFix, StringFormat=Fix: {0}}" TextWrapping="Wrap"
                             Foreground="{StaticResource Brush.Warning}" FontSize="12" Margin="0,4,0,0"
                             Visibility="{Binding RecommendedFix, Converter={StaticResource EmptyToCollapsed}}" />
                  <Expander Header="Details" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,4,0,0"
                            Visibility="{Binding Details, Converter={StaticResource EmptyToCollapsed}}">
                    <TextBlock Text="{Binding Details}" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                  </Expander>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
