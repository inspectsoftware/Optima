<UserControl x:Class="COPSBootstrapper.App.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:COPSBootstrapper.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRoot}" MaxWidth="900" HorizontalAlignment="Left">

      <TextBlock Text="PLAY" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="pick a profile · everything is restored when the game exits"
                 Style="{StaticResource Text.PageSubtitle}" />

      <HeaderedContentControl Style="{StaticResource Section}" Header="PROFILE">
        <StackPanel>
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                    DisplayMemberPath="Name" Width="340" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding SelectedProfile.Description}" Style="{StaticResource Text.Prose}"
                     Margin="0,10,0,0" MaxWidth="700" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding SelectedProfileSummary}" Style="{StaticResource Text.Value}"
                     Margin="0,8,0,0" />
        </StackPanel>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="LAUNCH">
        <StackPanel>
          <Button Style="{StaticResource PrimaryButton}" MinHeight="54" HorizontalAlignment="Stretch"
                  Content="{Binding PlayButtonText}" Command="{Binding PlayCommand}" />

          <Grid Margin="0,12,0,0" Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ctl:AsciiSpinner Cells="14" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="{Binding PhaseText}" Style="{StaticResource Text.Value}"
                       Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="cancel session"
                    Command="{Binding CancelCommand}" />
          </Grid>
        </StackPanel>
      </HeaderedContentControl>

      <!-- Session result -->
      <HeaderedContentControl Style="{StaticResource Section}" Header="LAST SESSION"
                              Visibility="{Binding LastSession, Converter={StaticResource NullToCollapsed}}">
        <StackPanel>
          <UniformGrid Columns="5">
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="DURATION" Style="{StaticResource Text.Label}" />
              <TextBlock Text="{Binding LastSession.Duration, StringFormat={}{0:hh\\:mm\\:ss}}"
                         Style="{StaticResource Text.Metric}" FontSize="20" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="AVG FPS" Style="{StaticResource Text.Label}" />
              <TextBlock Text="{Binding LastSession.Stats.AverageFps, StringFormat={}{0:F0}}"
                         Style="{StaticResource Text.Metric}" FontSize="20" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="1% LOW" Style="{StaticResource Text.Label}" />
              <TextBlock Text="{Binding LastSession.Stats.OnePercentLowFps, StringFormat={}{0:F0}}"
                         Style="{StaticResource Text.Metric}" FontSize="20"
                         Foreground="{StaticResource Brush.Text}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="0.1% LOW" Style="{StaticResource Text.Label}" />
              <TextBlock Text="{Binding LastSession.Stats.PointOnePercentLowFps, StringFormat={}{0:F0}}"
                         Style="{StaticResource Text.Metric}" FontSize="20"
                         Foreground="{StaticResource Brush.Text}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="P99 FRAMETIME" Style="{StaticResource Text.Label}" />
              <TextBlock Text="{Binding LastSession.Stats.P99FrametimeMs, StringFormat={}{0:F1} ms}"
                         Style="{StaticResource Text.Metric}" FontSize="20"
                         Foreground="{StaticResource Brush.Text}" />
            </StackPanel>
          </UniformGrid>
          <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0" MaxWidth="700" HorizontalAlignment="Left"
                     Text="FPS data needs frametime capture enabled in Settings, plus one approval of the administrator prompt."
                     Visibility="{Binding LastSession.Stats.HasData, Converter={StaticResource InverseBoolToVis}}" />
        </StackPanel>
      </HeaderedContentControl>

      <!-- Friendly error -->
      <HeaderedContentControl Style="{StaticResource Section}" Header="ERROR"
                              Visibility="{Binding LastError, Converter={StaticResource NullToCollapsed}}">
        <Border Style="{StaticResource Callout}" BorderBrush="{StaticResource Brush.Fail}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="[FAIL]" Foreground="{StaticResource Brush.Fail}"
                         FontSize="{StaticResource Type.Label}" Margin="0,0,10,0" />
              <TextBlock Text="{Binding LastError.Title}" FontSize="{StaticResource Type.Title}"
                         Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding LastError.Explanation}" Style="{StaticResource Text.Prose}"
                       Margin="0,8,0,0" MaxWidth="720" HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding LastError.SuggestedFixes}" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="&#x2514;" Foreground="{StaticResource Brush.Hairline}" Margin="0,0,8,0"
                               VerticalAlignment="Top" />
                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Prose}"
                               Foreground="{StaticResource Brush.Warn}" MaxWidth="680" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding LastError.Code, StringFormat='code: {0}'}"
                       Style="{StaticResource Text.Micro}" Margin="0,10,0,0" />
            <Expander Header="developer details" Margin="0,8,0,0"
                      Visibility="{Binding LastError.DeveloperDetails, Converter={StaticResource EmptyToCollapsed}}">
              <TextBox Text="{Binding LastError.DeveloperDetails, Mode=OneWay}" IsReadOnly="True"
                       FontSize="{StaticResource Type.Micro}" TextWrapping="Wrap"
                       MaxHeight="220" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
            </Expander>
          </StackPanel>
        </Border>
      </HeaderedContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
