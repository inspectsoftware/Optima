<UserControl x:Class="COPSBootstrapper.App.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24" MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Text="PLAY" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Pick a profile, press play — everything is restored when the game exits."
                 Foreground="{StaticResource Brush.TextMuted}" FontSize="13" Margin="0,0,0,20" />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="PROFILE" Style="{StaticResource Text.SectionHeader}" />
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                    DisplayMemberPath="Name" MaxWidth="380" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding SelectedProfile.Description}" Style="{StaticResource Text.Label}"
                     TextWrapping="Wrap" Margin="0,10,0,0" />
          <TextBlock Text="{Binding SelectedProfileSummary}" Style="{StaticResource Text.Value}"
                     Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <Button Style="{StaticResource PrimaryButton}" FontSize="18" MinHeight="58"
                  Content="{Binding PlayButtonText}" Command="{Binding PlayCommand}" />
          <ProgressBar IsIndeterminate="True" Margin="0,14,0,0"
                       Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}}" />
          <Grid Margin="0,10,0,0"
                Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding PhaseText}" Foreground="{StaticResource Brush.Accent}" FontSize="13"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Cancel session"
                    Command="{Binding CancelCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Session result -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0"
              Visibility="{Binding LastSession, Converter={StaticResource NullToCollapsed}}">
        <StackPanel>
          <TextBlock Text="LAST SESSION" Style="{StaticResource Text.SectionHeader}" />
          <UniformGrid Columns="5">
            <StackPanel>
              <TextBlock Text="Duration" Style="{StaticResource Text.Label}" />
              <TextBlock Text="{Binding LastSession.Duration, StringFormat={}{0:hh\\:mm\\:ss}}"
                         Style="{StaticResource Text.Metric}" FontSize="20" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Average FPS" Style="{StaticResource Text.Label}" />
              <TextBlock Text="{Binding LastSession.Stats.AverageFps, StringFormat={}{0:F0}}"
                         Style="{StaticResource Text.Metric}" FontSize="20" Foreground="{StaticResource Brush.Accent}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="1% Low" Style="{StaticResource Text.Label}" />
              <TextBlock Text="{Binding LastSession.Stats.OnePercentLowFps, StringFormat={}{0:F0}}"
                         Style="{StaticResource Text.Metric}" FontSize="20" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="0.1% Low" Style="{StaticResource Text.Label}" />
              <TextBlock Text="{Binding LastSession.Stats.PointOnePercentLowFps, StringFormat={}{0:F0}}"
                         Style="{StaticResource Text.Metric}" FontSize="20" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="P99 Frametime" Style="{StaticResource Text.Label}" />
              <TextBlock Text="{Binding LastSession.Stats.P99FrametimeMs, StringFormat={}{0:F1} ms}"
                         Style="{StaticResource Text.Metric}" FontSize="20" />
            </StackPanel>
          </UniformGrid>
          <TextBlock Text="FPS data needs frametime capture (Settings → frametime capture) and the elevated helper."
                     Style="{StaticResource Text.Label}" FontSize="11" Margin="0,10,0,0"
                     Visibility="{Binding LastSession.Stats.HasData, Converter={StaticResource InverseBoolToVis}}" />
        </StackPanel>
      </Border>

      <!-- Friendly error (§24) -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0"
              BorderBrush="{StaticResource Brush.Error}"
              Visibility="{Binding LastError, Converter={StaticResource NullToCollapsed}}">
        <StackPanel>
          <TextBlock Text="{Binding LastError.Title}" FontSize="15" FontWeight="SemiBold"
                     Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LastError.Explanation}" Style="{StaticResource Text.Label}"
                     TextWrapping="Wrap" Margin="0,6,0,0" />
          <ItemsControl ItemsSource="{Binding LastError.SuggestedFixes}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StringFormat=•  {0}}" Style="{StaticResource Text.Value}"
                           TextWrapping="Wrap" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding LastError.Code, StringFormat=Error code: {0}}"
                     Style="{StaticResource Text.Label}" FontSize="11" Margin="0,8,0,0" />
          <Expander Header="Developer details" Foreground="{StaticResource Brush.TextMuted}" Margin="0,8,0,0"
                    Visibility="{Binding LastError.DeveloperDetails, Converter={StaticResource EmptyToCollapsed}}">
            <TextBox Text="{Binding LastError.DeveloperDetails, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="{StaticResource Font.Mono}" FontSize="11" TextWrapping="Wrap"
                     MaxHeight="200" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
          </Expander>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
