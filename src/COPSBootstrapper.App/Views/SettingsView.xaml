<UserControl x:Class="COPSBootstrapper.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="SETTINGS" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Stored in %LOCALAPPDATA%\COPSBootstrapper"
                 Foreground="{StaticResource Brush.TextMuted}" FontSize="13" Margin="0,0,0,20" />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="GENERAL" Style="{StaticResource Text.SectionHeader}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Text="Virtual display provider" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,5" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding Provider}"
                      Width="200" HorizontalAlignment="Left" Margin="0,5" />

            <TextBlock Grid.Row="1" Text="Frametime capture (ETW)" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,5" />
            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding EnableFrametimeCapture}" VerticalAlignment="Center" Margin="0,5"
                      Content="Collect FPS externally via Windows event tracing (needs the elevated helper)" />

            <TextBlock Grid.Row="2" Text="Minimum log level" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,5" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding LogLevel}"
                      Width="200" HorizontalAlignment="Left" Margin="0,5" />

            <TextBlock Grid.Row="3" Text="Developer mode" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,5" />
            <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding DeveloperMode}" VerticalAlignment="Center" Margin="0,5"
                      Content="Show the DEVELOPER page with raw detection data" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="PATH OVERRIDES" Style="{StaticResource Text.SectionHeader}" />
          <TextBlock Text="Leave empty for automatic detection. These are the fallbacks for unusual installs (§29)."
                     Style="{StaticResource Text.Label}" FontSize="11" Margin="0,0,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Text="Google Play Games folder" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,5" />
            <TextBox Grid.Column="1" Text="{Binding ManualInstallPath}" Margin="0,5" />

            <TextBlock Grid.Row="1" Text="VDD settings XML" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,5" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VddSettingsPath}" Margin="0,5"
                     ToolTip="Default: C:\VirtualDisplayDriver\vdd_settings.xml" />

            <TextBlock Grid.Row="2" Text="Custom launch command" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,5" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomLaunchCommand}" Margin="0,5"
                     ToolTip="Used as the last launch strategy. Placeholders: {uri} and {package}" />
          </Grid>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <Button Style="{StaticResource PrimaryButton}" Padding="18,8" FontSize="13" Content="Save settings"
                Command="{Binding SaveCommand}" />
        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.Success}" FontSize="12"
                   VerticalAlignment="Center" Margin="12,0,0,0" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
