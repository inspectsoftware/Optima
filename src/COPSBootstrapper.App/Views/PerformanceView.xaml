<UserControl x:Class="COPSBootstrapper.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24" MaxWidth="980" HorizontalAlignment="Left">
      <TextBlock Text="PERFORMANCE" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Profiles, session history and benchmark comparison"
                 Foreground="{StaticResource Brush.TextMuted}" FontSize="13" Margin="0,0,0,20" />

      <!-- Profile editor -->
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>

          <StackPanel>
            <TextBlock Text="PROFILES" Style="{StaticResource Text.SectionHeader}" />
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                     Background="Transparent" BorderThickness="0" MaxHeight="260">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="2,4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Brush.TextMuted}"
                               FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Style="{StaticResource SecondaryButton}" Content="Import"
                      Command="{Binding ImportProfileCommand}" Margin="0,0,8,0" />
              <Button Style="{StaticResource SecondaryButton}" Content="Export"
                      Command="{Binding ExportProfileCommand}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="EDIT" Style="{StaticResource Text.SectionHeader}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                <RowDefinition /><RowDefinition /><RowDefinition />
              </Grid.RowDefinitions>

              <TextBlock Text="Name" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
              <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

              <TextBlock Grid.Row="1" Text="Virtual display" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
              <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding EditVirtualDisplay}" VerticalAlignment="Center" Margin="0,4"
                        ToolTip="Enables the virtual display driver and applies the resolution below for the session." />

              <TextBlock Grid.Row="2" Text="Resolution" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                <TextBox Text="{Binding EditWidth}" Width="70" />
                <TextBlock Text="×" Margin="6,0" VerticalAlignment="Center" />
                <TextBox Text="{Binding EditHeight}" Width="70" />
                <TextBlock Text="@" Margin="6,0" VerticalAlignment="Center" />
                <TextBox Text="{Binding EditRefreshRate}" Width="52" />
                <TextBlock Text="Hz" Margin="6,0" VerticalAlignment="Center" />
              </StackPanel>

              <TextBlock Grid.Row="3" Text="Power plan" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding PowerPlanOptions}"
                        SelectedItem="{Binding EditPowerPlan}" Width="220" HorizontalAlignment="Left" Margin="0,4" />

              <TextBlock Grid.Row="4" Text="Process priority" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding PriorityOptions}"
                        SelectedItem="{Binding EditPriority}" Width="220" HorizontalAlignment="Left" Margin="0,4" />

              <TextBlock Grid.Row="5" Text="Power throttling" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
              <CheckBox Grid.Row="5" Grid.Column="1" Content="Disable for game processes"
                        IsChecked="{Binding EditDisableThrottling}" VerticalAlignment="Center" Margin="0,4" />

              <TextBlock Grid.Row="6" Text="Close before launch" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4"
                         ToolTip="Comma-separated process names. Only these are ever closed, and only when this profile runs." />
              <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding EditCleanupList}" Margin="0,4"
                       ToolTip="e.g. Discord, SteamWebHelper — never system or Google Play Games processes" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Style="{StaticResource PrimaryButton}" Padding="18,8" FontSize="13" Content="Save profile"
                      Command="{Binding SaveProfileCommand}" Margin="0,0,8,0" />
              <Button Style="{StaticResource SecondaryButton}" Content="Delete"
                      Command="{Binding DeleteProfileCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding EditorStatus}" Foreground="{StaticResource Brush.Warning}" FontSize="12" Margin="0,8,0,0"
                       Visibility="{Binding EditorStatus, Converter={StaticResource EmptyToCollapsed}}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Setting explanations (§8) -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="WHAT EACH SETTING DOES" Style="{StaticResource Text.SectionHeader}" />
          <ItemsControl ItemsSource="{Binding Explanations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Expander Foreground="{StaticResource Brush.Text}" Margin="0,2">
                  <Expander.Header>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                  </Expander.Header>
                  <Grid Margin="18,6,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Changes" Style="{StaticResource Text.Label}" Margin="0,2" />
                    <TextBlock Grid.Column="1" Text="{Binding WhatItChanges}" TextWrapping="Wrap" FontSize="12" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="Benefit" Style="{StaticResource Text.Label}" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PotentialBenefit}" TextWrapping="Wrap" FontSize="12" Margin="0,2" />
                    <TextBlock Grid.Row="2" Text="Downside" Style="{StaticResource Text.Label}" Margin="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PotentialDownside}" TextWrapping="Wrap" FontSize="12" Margin="0,2" />
                    <TextBlock Grid.Row="3" Text="Requires" Style="{StaticResource Text.Label}" Margin="0,2" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                      <TextBlock Text="restart" FontSize="12" Foreground="{StaticResource Brush.Warning}" Margin="0,0,10,0"
                                 Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}" />
                      <TextBlock Text="administrator" FontSize="12" Foreground="{StaticResource Brush.Warning}"
                                 Visibility="{Binding RequiresAdministrator, Converter={StaticResource BoolToVis}}" />
                      <TextBlock Text="nothing special" FontSize="12" Foreground="{StaticResource Brush.TextMuted}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                  <Condition Binding="{Binding RequiresRestart}" Value="False" />
                                  <Condition Binding="{Binding RequiresAdministrator}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                              </MultiDataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Benchmark compare (§14) -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="BENCHMARK COMPARISON" Style="{StaticResource Text.SectionHeader}" />
          <StackPanel Orientation="Horizontal">
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding CompareProfileA}"
                      DisplayMemberPath="Name" Width="200" />
            <TextBlock Text="vs" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding CompareProfileB}"
                      DisplayMemberPath="Name" Width="200" />
            <Button Style="{StaticResource SecondaryButton}" Content="Compare" Command="{Binding CompareCommand}"
                    Margin="12,0,0,0" />
          </StackPanel>

          <StackPanel Visibility="{Binding Comparison, Converter={StaticResource NullToCollapsed}}" Margin="0,14,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition />
              </Grid.RowDefinitions>
              <TextBlock Grid.Column="1" Text="{Binding Comparison.ProfileA}" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Grid.Column="2" Text="{Binding Comparison.ProfileB}" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Grid.Row="1" Text="Average FPS" Style="{StaticResource Text.Label}" Margin="0,4" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Comparison.StatsA.AverageFps, StringFormat={}{0:F0}}" Margin="0,4" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Comparison.StatsB.AverageFps, StringFormat={}{0:F0}}" Margin="0,4" />
              <TextBlock Grid.Row="2" Text="1% Low" Style="{StaticResource Text.Label}" Margin="0,4" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Comparison.StatsA.OnePercentLowFps, StringFormat={}{0:F0}}" Margin="0,4" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Comparison.StatsB.OnePercentLowFps, StringFormat={}{0:F0}}" Margin="0,4" />
            </Grid>
            <TextBlock Text="{Binding Comparison.Verdict}" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Comparison.IsStatisticallyMeaningful}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Session history (§13) -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <Grid>
            <TextBlock Text="SESSION HISTORY" Style="{StaticResource Text.SectionHeader}" />
            <Button Style="{StaticResource SecondaryButton}" Content="Refresh" HorizontalAlignment="Right"
                    Command="{Binding RefreshSessionsCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Sessions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150" /><ColumnDefinition Width="170" /><ColumnDefinition Width="90" />
                      <ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StartedAt, StringFormat={}{0:MM-dd HH:mm}}" FontSize="12"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <TextBlock Grid.Column="1" Text="{Binding ProfileName}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{Binding Duration, StringFormat={}{0:hh\\:mm\\:ss}}" FontSize="12" />
                    <TextBlock Grid.Column="3" Text="{Binding Stats.AverageFps, StringFormat=avg {0:F0} fps}" FontSize="12" />
                    <TextBlock Grid.Column="4" Text="{Binding Stats.OnePercentLowFps, StringFormat=1% {0:F0}}" FontSize="12" />
                    <TextBlock Grid.Column="5" Text="{Binding Stats.P99FrametimeMs, StringFormat=p99 {0:F1} ms}" FontSize="12" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No sessions recorded yet — play a round first." Margin="0,8,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
