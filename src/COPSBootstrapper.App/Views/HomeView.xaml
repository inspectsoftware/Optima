<UserControl x:Class="COPSBootstrapper.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24">
      <TextBlock Text="CRITICAL OPS" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Custom bootstrapper for Google Play Games on PC"
                 Foreground="{StaticResource Brush.TextMuted}" FontSize="13" Margin="0,0,0,20" />

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- STATUS -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="STATUS" Style="{StaticResource Text.SectionHeader}" />
            <ContentControl Content="{Binding Status.GooglePlayGames}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            <ContentControl Content="{Binding Status.CriticalOps}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            <ContentControl Content="{Binding Status.VirtualDisplay}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            <ContentControl Content="{Binding Status.Virtualization}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            <ContentControl Content="{Binding Status.Display}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            <Button Style="{StaticResource SecondaryButton}" Content="Refresh"
                    Command="{Binding Status.RefreshCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
          </StackPanel>
        </Border>

        <!-- SYSTEM + PERFORMANCE -->
        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="SYSTEM" Style="{StaticResource Text.SectionHeader}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="GPU" Style="{StaticResource Text.Label}" Margin="0,3" />
                <TextBlock Grid.Column="1" Text="{Binding GpuText}" Style="{StaticResource Text.Value}" Margin="0,3" />
                <TextBlock Grid.Row="1" Text="CPU" Style="{StaticResource Text.Label}" Margin="0,3" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CpuText}" Style="{StaticResource Text.Value}" Margin="0,3" />
                <TextBlock Grid.Row="2" Text="RAM" Style="{StaticResource Text.Label}" Margin="0,3" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamText}" Style="{StaticResource Text.Value}" Margin="0,3" />
                <TextBlock Grid.Row="3" Text="Windows" Style="{StaticResource Text.Label}" Margin="0,3" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WindowsText}" Style="{StaticResource Text.Value}" Margin="0,3" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="PERFORMANCE" Style="{StaticResource Text.SectionHeader}" />
              <UniformGrid Columns="5">
                <StackPanel>
                  <TextBlock Text="CPU" Style="{StaticResource Text.Label}" />
                  <TextBlock Text="{Binding CpuUsage}" Style="{StaticResource Text.Metric}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="GPU" Style="{StaticResource Text.Label}" />
                  <TextBlock Text="{Binding GpuUsage}" Style="{StaticResource Text.Metric}" />
                  <TextBlock Text="{Binding GpuTempText}" Style="{StaticResource Text.Label}" FontSize="11" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="RAM" Style="{StaticResource Text.Label}" />
                  <TextBlock Text="{Binding RamUsage}" Style="{StaticResource Text.Metric}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="FPS" Style="{StaticResource Text.Label}" />
                  <TextBlock Text="{Binding FpsText}" Style="{StaticResource Text.Metric}"
                             Foreground="{StaticResource Brush.Accent}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Frametime" Style="{StaticResource Text.Label}" />
                  <TextBlock Text="{Binding FrametimeText}" Style="{StaticResource Text.Metric}" FontSize="18"
                             Margin="0,5,0,0" />
                </StackPanel>
              </UniformGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- PLAY -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Play.SelectedProfile.Name, FallbackValue=No profile}"
                       FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Play.SelectedProfileSummary}"
                       Style="{StaticResource Text.Label}" Margin="0,2,0,0" />
            <TextBlock Text="{Binding Play.PhaseText}" Foreground="{StaticResource Brush.Accent}"
                       FontSize="12" Margin="0,6,0,0"
                       Visibility="{Binding Play.PhaseText, Converter={StaticResource EmptyToCollapsed}}" />
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                  Content="{Binding Play.PlayButtonText}"
                  Command="{Binding Play.PlayCommand}" MinWidth="260" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
