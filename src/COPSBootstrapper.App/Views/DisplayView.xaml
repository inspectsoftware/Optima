<UserControl x:Class="COPSBootstrapper.App.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="DISPLAY" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Virtual display control and attached monitors"
                 Foreground="{StaticResource Brush.TextMuted}" FontSize="13" Margin="0,0,0,20" />

      <!-- Virtual display -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="VIRTUAL DISPLAY" Style="{StaticResource Text.SectionHeader}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding ProviderName}" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ProviderCapabilities}" Style="{StaticResource Text.Label}" FontSize="11" Margin="0,3,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{StaticResource Brush.TextMuted}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding VirtualDisplayActive}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding VirtualDisplayModeText}" Style="{StaticResource Text.Value}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Style="{StaticResource SecondaryButton}" Content="Enable"
                      Command="{Binding EnableVirtualDisplayCommand}" Margin="0,0,8,0" />
              <Button Style="{StaticResource SecondaryButton}" Content="Disable"
                      Command="{Binding DisableVirtualDisplayCommand}" />
            </StackPanel>
          </Grid>

          <Separator />

          <TextBlock Text="MODE PRESETS" Style="{StaticResource Text.SectionHeader}" />
          <StackPanel Orientation="Horizontal">
            <ComboBox ItemsSource="{Binding ModePresets}" SelectedItem="{Binding SelectedPreset}" Width="220" />
            <Button Style="{StaticResource SecondaryButton}" Content="Apply preset"
                    Command="{Binding ApplyPresetCommand}" Margin="10,0,0,0" />
          </StackPanel>

          <TextBlock Text="CUSTOM MODE" Style="{StaticResource Text.SectionHeader}" Margin="0,16,0,8" />
          <StackPanel Orientation="Horizontal">
            <TextBox Text="{Binding CustomWidth}" Width="70" />
            <TextBlock Text="×" Margin="6,0" VerticalAlignment="Center" />
            <TextBox Text="{Binding CustomHeight}" Width="70" />
            <TextBlock Text="@" Margin="6,0" VerticalAlignment="Center" />
            <TextBox Text="{Binding CustomRefreshRate}" Width="52" />
            <TextBlock Text="Hz" Margin="6,0" VerticalAlignment="Center" />
            <Button Style="{StaticResource SecondaryButton}" Content="Apply custom mode"
                    Command="{Binding ApplyCustomModeCommand}" Margin="10,0,0,0" />
          </StackPanel>

          <ProgressBar IsIndeterminate="True" Margin="0,12,0,0"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.Warning}" FontSize="12"
                     TextWrapping="Wrap" Margin="0,10,0,0"
                     Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToCollapsed}}" />

          <Border Background="#221A0E" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1"
                  CornerRadius="6" Padding="12" Margin="0,12,0,0"
                  Visibility="{Binding CanEmergencyRestore, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Display configuration was changed this session. If anything looks wrong, restore the previous layout."
                         FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="EMERGENCY RESTORE"
                      Command="{Binding EmergencyRestoreCommand}" Margin="10,0,0,0" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- Attached displays -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <Grid>
            <TextBlock Text="ATTACHED DISPLAYS" Style="{StaticResource Text.SectionHeader}" />
            <Button Style="{StaticResource SecondaryButton}" Content="Refresh" HorizontalAlignment="Right"
                    Command="{Binding RefreshCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Displays}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" /><ColumnDefinition /><ColumnDefinition Width="150" />
                      <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DeviceName}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding AdapterName}" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="{Binding CurrentMode}" FontSize="12" />
                    <TextBlock Grid.Column="3" FontSize="12" Foreground="{StaticResource Brush.TextMuted}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Setter Property="Text" Value="inactive" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                              <Setter Property="Text" Value="primary" />
                              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsActive}" Value="True" />
                                <Condition Binding="{Binding IsPrimary}" Value="False" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Text" Value="active" />
                              <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
