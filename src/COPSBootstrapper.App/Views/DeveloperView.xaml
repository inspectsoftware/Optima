<UserControl x:Class="COPSBootstrapper.App.Views.DeveloperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <DataTemplate x:Key="DevInfoRowTemplate">
      <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Foreground="#FF9AA3B2" FontSize="12" />
        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" FontFamily="Cascadia Mono, Consolas"
                   Foreground="#FFE8EAEF" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24" MaxWidth="940" HorizontalAlignment="Left">
      <TextBlock Text="DEVELOPER" Style="{StaticResource Text.PageTitle}" />
      <Grid Margin="0,0,0,20">
        <TextBlock Text="Raw detection data for troubleshooting after Google Play Games updates"
                   Foreground="{StaticResource Brush.TextMuted}" FontSize="13" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource SecondaryButton}" Content="Ping helper" Command="{Binding PingHelperCommand}" Margin="0,0,8,0" />
          <Button Style="{StaticResource SecondaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="TRACKED PROCESSES" Style="{StaticResource Text.SectionHeader}" />
          <ItemsControl ItemsSource="{Binding TrackedProcesses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" /><ColumnDefinition Width="220" />
                    <ColumnDefinition Width="110" /><ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ProcessId}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                  <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="12" Foreground="{StaticResource Brush.Accent}" />
                  <TextBlock Grid.Column="3" Text="{Binding MainWindowTitle}" FontSize="12"
                             Foreground="{StaticResource Brush.TextSecondary}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="RESOLVED PATHS" Style="{StaticResource Text.SectionHeader}" />
          <ItemsControl ItemsSource="{Binding ResolvedPaths}" ItemTemplate="{StaticResource DevInfoRowTemplate}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="DRIVER PROVIDER" Style="{StaticResource Text.SectionHeader}" />
          <ItemsControl ItemsSource="{Binding ProviderInfo}" ItemTemplate="{StaticResource DevInfoRowTemplate}" />
          <TextBlock Text="{Binding HelperStatus, StringFormat=Elevated helper: {0}}" FontSize="12" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="ACTIVE DETECTION RULES" Style="{StaticResource Text.SectionHeader}" />
          <TextBlock Text="Override by editing %LOCALAPPDATA%\COPSBootstrapper\detection.json (§29)."
                     Style="{StaticResource Text.Label}" FontSize="11" Margin="0,0,0,8" />
          <TextBox Text="{Binding DetectionRulesJson, Mode=OneWay}" IsReadOnly="True"
                   FontFamily="{StaticResource Font.Mono}" FontSize="11" TextWrapping="Wrap"
                   MaxHeight="320" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
