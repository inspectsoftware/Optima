<UserControl x:Class="COPSBootstrapper.App.Views.DeveloperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRoot}" MaxWidth="980" HorizontalAlignment="Left">

      <TextBlock Text="DEVELOPER" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="raw detection data · first place to look after a google play games update"
                 Style="{StaticResource Text.PageSubtitle}" />

      <HeaderedContentControl Style="{StaticResource Section}" Header="TRACKED PROCESSES">
        <HeaderedContentControl.Tag>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource GhostButton}" Content="ping helper" Command="{Binding PingHelperCommand}" Padding="6,0" />
            <Button Style="{StaticResource GhostButton}" Content="refresh" Command="{Binding RefreshCommand}" Padding="6,0" />
          </StackPanel>
        </HeaderedContentControl.Tag>
        <ItemsControl ItemsSource="{Binding TrackedProcesses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource TableRow}" Padding="0,4">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding ProcessId}" Style="{StaticResource Text.CellDim}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Cell}" />
                  <TextBlock Grid.Column="2" Text="{Binding Kind}" Style="{StaticResource Text.Cell}"
                             Foreground="{StaticResource Brush.Info}" />
                  <TextBlock Grid.Column="3" Text="{Binding MainWindowTitle}" Style="{StaticResource Text.CellDim}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="RESOLVED PATHS">
        <ItemsControl ItemsSource="{Binding ResolvedPaths}" ItemTemplate="{StaticResource InfoRowTemplate}" />
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="DRIVER PROVIDER">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding ProviderInfo}" ItemTemplate="{StaticResource InfoRowTemplate}" />
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="16" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Elevated helper" Style="{StaticResource Text.Label}" />
            <Rectangle Grid.Column="1" Style="{StaticResource Leader}" />
            <TextBlock Grid.Column="2" Text="{Binding HelperStatus, StringFormat='[ {0} ]'}"
                       Style="{StaticResource Text.Value}" />
          </Grid>
        </StackPanel>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="ACTIVE DETECTION RULES">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Prose}" Margin="0,0,0,8" MaxWidth="720" HorizontalAlignment="Left"
                     Text="Override these by editing detection.json in the application data folder — process names and paths are matched from configuration, never hardcoded." />
          <Border Background="#FF050608" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1" Padding="12">
            <TextBox Text="{Binding DetectionRulesJson, Mode=OneWay}" IsReadOnly="True"
                     FontSize="{StaticResource Type.Micro}" TextWrapping="Wrap"
                     MaxHeight="300" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                     Background="Transparent" />
          </Border>
        </StackPanel>
      </HeaderedContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
