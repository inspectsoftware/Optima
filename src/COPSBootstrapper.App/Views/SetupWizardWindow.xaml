<Window x:Class="COPSBootstrapper.App.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to COPS Bootstrapper"
        Width="640" Height="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Background}" ResizeMode="NoResize">
  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock FontSize="22" FontWeight="Bold">
        <Run Text="COPS" Foreground="{StaticResource Brush.Accent}" /><Run Text=" BOOTSTRAPPER" />
      </TextBlock>
      <TextBlock Text="{Binding Headline}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="14" Margin="0,6,0,0" />
      <ProgressBar IsIndeterminate="True" Margin="0,14,0,0"
                   Visibility="{Binding IsDetecting, Converter={StaticResource BoolToVis}}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="DETECTION" Style="{StaticResource Text.SectionHeader}" />
            <ContentControl Content="{Binding Status.GooglePlayGames}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            <ContentControl Content="{Binding Status.CriticalOps}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            <ContentControl Content="{Binding Status.VirtualDisplay}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            <ContentControl Content="{Binding Status.Virtualization}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            <ContentControl Content="{Binding Status.Display}" ContentTemplate="{StaticResource StatusItemTemplate}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="ENVIRONMENT CHECKS" Style="{StaticResource Text.SectionHeader}" />
            <ItemsControl ItemsSource="{Binding Diagnostics.Results}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="56" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status, Converter={StaticResource DiagStatusText}}"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{Binding Status, Converter={StaticResource DiagStatusBrush}}" />
                    <TextBlock Grid.Column="1" Text="{Binding CheckName}" FontSize="12" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="Default profiles (Default, Balanced, Competitive 1080p240, Competitive 1440p165) are ready. Everything can be changed later in PERFORMANCE and SETTINGS."
                   Style="{StaticResource Text.Label}" TextWrapping="Wrap" Margin="4,14,4,0" />
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="GET STARTED"
            Command="{Binding FinishCommand}" HorizontalAlignment="Right" Margin="0,16,0,0" MinWidth="180" />
  </Grid>
</Window>
