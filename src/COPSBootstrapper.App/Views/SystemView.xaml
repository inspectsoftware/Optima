<UserControl x:Class="COPSBootstrapper.App.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <DataTemplate x:Key="InfoRowTemplate">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="230" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Foreground="#FF9AA3B2" FontSize="13" />
        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="Medium"
                   Foreground="#FFE8EAEF" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="SYSTEM" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Hardware inventory and virtualization state"
                 Foreground="{StaticResource Brush.TextMuted}" FontSize="13" Margin="0,0,0,20" />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <TextBlock Text="HARDWARE" Style="{StaticResource Text.SectionHeader}" />
            <Button Style="{StaticResource SecondaryButton}" Content="Refresh" HorizontalAlignment="Right"
                    Command="{Binding RefreshCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding HardwareRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="VIRTUALIZATION" Style="{StaticResource Text.SectionHeader}" />
          <ItemsControl ItemsSource="{Binding VirtualizationRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
          <TextBlock Text="If firmware virtualization is disabled, it must be enabled in the BIOS/UEFI — Windows cannot change it."
                     Style="{StaticResource Text.Label}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="MONITORS" Style="{StaticResource Text.SectionHeader}" />
          <ItemsControl ItemsSource="{Binding Displays}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" /><ColumnDefinition /><ColumnDefinition Width="160" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding DeviceName}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding FriendlyName}" FontSize="12" />
                  <TextBlock Grid.Column="2" Text="{Binding CurrentMode}" FontSize="12" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
