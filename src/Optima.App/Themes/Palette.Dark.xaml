<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Dark palette (default). HUD glass language: a true neutral black ground carrying the
    in-app ambient field, glass strips that refract it, one warm accent (Aureum gold by
    default; the user's accent replaces it at runtime via ThemeService) and a red/blue
    chroma split on leading edges. Text steps keep the WCAG AA floor against the ground.
    Every key here must exist in Palette.Light.xaml with a theme-appropriate value.
  -->

  <!-- Ground and surfaces -->
  <Color x:Key="Color.Background">#FF050505</Color>
  <Color x:Key="Color.WindowGround">#F2050505</Color>
  <Color x:Key="Color.Surface">#FF0E0E0E</Color>
  <Color x:Key="Color.SurfaceRaised">#FF141414</Color>
  <Color x:Key="Color.SurfaceHover">#FF1D1D1D</Color>
  <Color x:Key="Color.Hairline">#FF262626</Color>
  <Color x:Key="Color.HairlineStrong">#FF3A3A3A</Color>
  <Color x:Key="Color.Deep">#FF000000</Color>

  <!-- Text -->
  <Color x:Key="Color.TextMuted">#FF8F8F8F</Color>
  <Color x:Key="Color.TextSecondary">#FFB4B4B4</Color>
  <Color x:Key="Color.Text">#FFEDEDED</Color>

  <!-- Accent (design-time default; ThemeService overrides from settings) -->
  <Color x:Key="Color.Accent">#FFE8B45A</Color>
  <Color x:Key="Color.OnAccent">#FF16130B</Color>

  <!-- Status hues -->
  <Color x:Key="Color.Ok">#FF82C097</Color>
  <Color x:Key="Color.Warn">#FFD9B36A</Color>
  <Color x:Key="Color.Fail">#FFE08A8A</Color>
  <Color x:Key="Color.Info">#FF8FA8CC</Color>

  <!-- Chroma split on leading edges and PLAY -->
  <Color x:Key="Color.ChromaRed">#FFFF5A46</Color>
  <Color x:Key="Color.ChromaBlue">#FF5A96FF</Color>

  <!-- Glass tint the shader mixes over the refracted backdrop (alpha = strength). -->
  <Color x:Key="Color.Glass.Tint">#0CFFFFFF</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="Brush.Background" Color="{DynamicResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.WindowGround" Color="{DynamicResource Color.WindowGround}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{DynamicResource Color.SurfaceRaised}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{DynamicResource Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.Hairline" Color="{DynamicResource Color.Hairline}" />
  <SolidColorBrush x:Key="Brush.HairlineStrong" Color="{DynamicResource Color.HairlineStrong}" />
  <SolidColorBrush x:Key="Brush.Deep" Color="{DynamicResource Color.Deep}" />

  <SolidColorBrush x:Key="Brush.TextMuted" Color="{DynamicResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{DynamicResource Color.Text}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{DynamicResource Color.OnAccent}" />

  <SolidColorBrush x:Key="Brush.Ok" Color="{DynamicResource Color.Ok}" />
  <SolidColorBrush x:Key="Brush.Warn" Color="{DynamicResource Color.Warn}" />
  <SolidColorBrush x:Key="Brush.Fail" Color="{DynamicResource Color.Fail}" />
  <SolidColorBrush x:Key="Brush.Info" Color="{DynamicResource Color.Info}" />
  <SolidColorBrush x:Key="Brush.ChromaRed" Color="{DynamicResource Color.ChromaRed}" />
  <SolidColorBrush x:Key="Brush.ChromaBlue" Color="{DynamicResource Color.ChromaBlue}" />

  <!-- Glass layers: white-alpha over the ground; the shader adds refraction and light. -->
  <SolidColorBrush x:Key="Brush.Glass.Surface1" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="Brush.Glass.Surface2" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="Brush.Glass.Surface3" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="Brush.Glass.Border" Color="#2BFFFFFF" />
  <SolidColorBrush x:Key="Brush.Glass.Highlight" Color="#59FFFFFF" />

  <!-- Strip rim lines: light catches the top edge, the bottom edge falls into shadow. -->
  <SolidColorBrush x:Key="Brush.Strip.Top" Color="#38FFFFFF" />
  <SolidColorBrush x:Key="Brush.Strip.Bottom" Color="#99000000" />
  <!-- Leading edge: red to accent to blue (ThemeService rebuilds it from the live accent). -->
  <LinearGradientBrush x:Key="Brush.Strip.Edge" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#99FF5A46" Offset="0" />
    <GradientStop Color="#FFE8B45A" Offset="0.4" />
    <GradientStop Color="#995A96FF" Offset="1" />
  </LinearGradientBrush>
  <!-- Active nav row: accent bleeding in from the leading edge. -->
  <LinearGradientBrush x:Key="Brush.Nav.Active" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#29E8B45A" Offset="0" />
    <GradientStop Color="#00E8B45A" Offset="1" />
  </LinearGradientBrush>

  <!-- Recessed surfaces inside glass: fields, tiles, tracks. -->
  <SolidColorBrush x:Key="Brush.Field" Color="#59000000" />
  <SolidColorBrush x:Key="Brush.Field.Outline" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="Brush.Tile" Color="#4D000000" />
  <SolidColorBrush x:Key="Brush.Scrim" Color="#4D000000" />

  <!-- HUD progress fill: 6 px of accent, 2 px dim (ThemeService rebuilds from the accent). -->
  <DrawingBrush x:Key="Brush.TrackFill" TileMode="Tile"
                Viewport="0,0,8,4" ViewportUnits="Absolute"
                Viewbox="0,0,8,4" ViewboxUnits="Absolute" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FFE8B45A"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,6,4" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#59E8B45A"><GeometryDrawing.Geometry><RectangleGeometry Rect="6,0,2,4" /></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- HUD grid behind the shell: 48 px cells, one pixel lines. -->
  <DrawingBrush x:Key="Brush.Grid" TileMode="Tile"
                Viewport="0,0,48,48" ViewportUnits="Absolute"
                Viewbox="0,0,48,48" ViewboxUnits="Absolute" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#09FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,48,1" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#09FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,48" /></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Specular rim for the few remaining rounded glass cards. -->
  <LinearGradientBrush x:Key="Brush.Glass.Specular" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#66FFFFFF" Offset="0" />
    <GradientStop Color="#2BFFFFFF" Offset="0.25" />
    <GradientStop Color="#1FFFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- Accent companions (ThemeService rewrites these from the user's accent). -->
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFF0C475" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FFD1A251" />
  <SolidColorBrush x:Key="Brush.AccentGlow" Color="#59E8B45A" />

  <!-- Legacy aliases so older markup keeps resolving. -->
  <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Hairline}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Ok}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warn}" />
  <SolidColorBrush x:Key="Brush.Error" Color="{DynamicResource Color.Fail}" />

  <!-- Dot leader (retired from the layouts; kept so nothing fails to resolve). -->
  <DrawingBrush x:Key="Brush.DotLeader"
                TileMode="Tile"
                Viewport="0,0,5,5" ViewportUnits="Absolute"
                Viewbox="0,0,5,5" ViewboxUnits="Absolute"
                AlignmentX="Left" AlignmentY="Bottom" Stretch="None">
    <DrawingBrush.Drawing>
      <GeometryDrawing>
        <GeometryDrawing.Brush>
          <SolidColorBrush Color="#FF2E2E2E" />
        </GeometryDrawing.Brush>
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="0,2,1.4,1.4" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>
