<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Dark palette (default). Glass-terminal language: a true neutral black ground with
    real acrylic bleed (the window ground is 80% black, not 95%), translucent
    white-alpha surfaces with a specular top rim, and one warm accent (Aureum gold by
    default; the user's accent replaces it at runtime via ThemeService). No blue tint
    anywhere: every gray is neutral. Text steps keep the WCAG AA floor: muted 6.4:1,
    secondary 9.8:1, primary 16.9:1 against Color.Background.
    Every key here must exist in Palette.Light.xaml with a theme-appropriate value.
  -->

  <!-- Ground and surfaces -->
  <Color x:Key="Color.Background">#FF040404</Color>
  <Color x:Key="Color.WindowGround">#CC000000</Color>
  <Color x:Key="Color.Surface">#FF0E0E0E</Color>
  <Color x:Key="Color.SurfaceRaised">#FF151515</Color>
  <Color x:Key="Color.SurfaceHover">#FF1D1D1D</Color>
  <Color x:Key="Color.Hairline">#FF262626</Color>
  <Color x:Key="Color.HairlineStrong">#FF3A3A3A</Color>
  <!-- Recessed pane, darker than the ground: log surfaces, raw-data wells. -->
  <Color x:Key="Color.Deep">#FF000000</Color>

  <!-- Text -->
  <Color x:Key="Color.TextMuted">#FF8F8F8F</Color>
  <Color x:Key="Color.TextSecondary">#FFB4B4B4</Color>
  <Color x:Key="Color.Text">#FFEDEDED</Color>

  <!-- Accent (design-time default; ThemeService overrides from settings) -->
  <Color x:Key="Color.Accent">#FFE8B45A</Color>
  <Color x:Key="Color.OnAccent">#FF16130B</Color>

  <!-- Status hues -->
  <Color x:Key="Color.Ok">#FF82C097</Color>
  <Color x:Key="Color.Warn">#FFD9B36A</Color>
  <Color x:Key="Color.Fail">#FFE08A8A</Color>
  <Color x:Key="Color.Info">#FF8FA8CC</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="Brush.Background" Color="{DynamicResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.WindowGround" Color="{DynamicResource Color.WindowGround}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{DynamicResource Color.SurfaceRaised}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{DynamicResource Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.Hairline" Color="{DynamicResource Color.Hairline}" />
  <SolidColorBrush x:Key="Brush.HairlineStrong" Color="{DynamicResource Color.HairlineStrong}" />
  <SolidColorBrush x:Key="Brush.Deep" Color="{DynamicResource Color.Deep}" />

  <SolidColorBrush x:Key="Brush.TextMuted" Color="{DynamicResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{DynamicResource Color.Text}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{DynamicResource Color.OnAccent}" />

  <SolidColorBrush x:Key="Brush.Ok" Color="{DynamicResource Color.Ok}" />
  <SolidColorBrush x:Key="Brush.Warn" Color="{DynamicResource Color.Warn}" />
  <SolidColorBrush x:Key="Brush.Fail" Color="{DynamicResource Color.Fail}" />
  <SolidColorBrush x:Key="Brush.Info" Color="{DynamicResource Color.Info}" />

  <!-- Glass layers: white-alpha over the ground so backdrop light bleeds through.
       Stronger than v0.2.0 on purpose: over true black, timid alpha reads as flat. -->
  <SolidColorBrush x:Key="Brush.Glass.Surface1" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="Brush.Glass.Surface2" Color="#1CFFFFFF" />
  <SolidColorBrush x:Key="Brush.Glass.Surface3" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="Brush.Glass.Border" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="Brush.Glass.Highlight" Color="#59FFFFFF" />

  <!-- Specular rim for glass cards: light catches the top edge and falls away.
       Lives per palette because a GradientStop is a Freezable and cannot resolve
       DynamicResource; the wholesale palette swap keeps it theme-correct. -->
  <LinearGradientBrush x:Key="Brush.Glass.Specular" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#66FFFFFF" Offset="0" />
    <GradientStop Color="#2BFFFFFF" Offset="0.25" />
    <GradientStop Color="#1FFFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- Accent companions (ThemeService rewrites these from the user's accent). -->
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFF0C475" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FFD1A251" />
  <SolidColorBrush x:Key="Brush.AccentGlow" Color="#59E8B45A" />

  <!-- Legacy aliases so older markup keeps resolving. -->
  <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Hairline}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Ok}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warn}" />
  <SolidColorBrush x:Key="Brush.Error" Color="{DynamicResource Color.Fail}" />

  <!-- Dot-leader lives per palette because a Freezable cannot resolve DynamicResource. -->
  <DrawingBrush x:Key="Brush.DotLeader"
                TileMode="Tile"
                Viewport="0,0,5,5" ViewportUnits="Absolute"
                Viewbox="0,0,5,5" ViewboxUnits="Absolute"
                AlignmentX="Left" AlignmentY="Bottom" Stretch="None">
    <DrawingBrush.Drawing>
      <GeometryDrawing>
        <GeometryDrawing.Brush>
          <SolidColorBrush Color="#FF2E2E2E" />
        </GeometryDrawing.Brush>
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="0,2,1.4,1.4" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>
