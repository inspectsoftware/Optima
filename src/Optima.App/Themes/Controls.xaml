<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Optima.App.Converters"
                    xmlns:ctl="clr-namespace:Optima.App.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    Control templates in the HUD glass language: chamfered vessels, recessed square
    fields, a leading edge that carries the chroma split, one accent family. Every
    interactive control is re-templated so no stock Aero chrome survives. Brush and color
    lookups are DynamicResource throughout (live theme/accent swaps repaint in place);
    structural tokens (fonts, sizes, chamfers) stay StaticResource on purpose.
  -->

  <!-- ============================================================== CONVERTERS -->
  <BooleanToVisibilityConverter x:Key="BoolToVis" />
  <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
  <conv:InverseBoolConverter x:Key="InverseBool" />
  <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
  <conv:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />
  <conv:StatusKindToBrushConverter x:Key="StatusKindBrush" />
  <conv:DiagnosticStatusToBrushConverter x:Key="DiagStatusBrush" />
  <conv:DiagnosticStatusToTextConverter x:Key="DiagStatusText" />
  <conv:DiagnosticStatusToTagConverter x:Key="DiagStatusTag" />
  <conv:DiagnosticStatusIsProblemConverter x:Key="DiagStatusIsProblem" />
  <conv:LogLevelToBrushConverter x:Key="LogLevelBrush" />
  <conv:NavItemVisibilityConverter x:Key="NavItemVisibility" />
  <conv:HexToBrushConverter x:Key="HexToBrush" />
  <conv:IconKeyConverter x:Key="IconKey" />

  <!-- =========================================================== FOCUS VISUAL -->
  <Style x:Key="Focus.Ring">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" Margin="-3" Opacity="0.7" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================== ICON -->
  <Style TargetType="ctl:Icon">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:Icon">
          <Viewbox Width="{TemplateBinding Size}" Height="{TemplateBinding Size}" Stretch="Uniform">
            <Canvas Width="24" Height="24">
              <Path Data="{TemplateBinding Symbol}" Stroke="{TemplateBinding Foreground}"
                    StrokeThickness="{TemplateBinding StrokeThickness}"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================================================================== TEXT -->
  <!--
    Deliberately NOT an implicit TargetType="TextBlock" style (it would also hit the
    TextBlock a ContentPresenter generates inside every control template). App-wide text
    defaults are inheritable TextElement values on the window root; these keyed styles
    handle specific roles. UI text is the grotesk; values and data are monospace.
  -->
  <Style x:Key="Text.Base" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Type.Display}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="32" />
  </Style>

  <Style x:Key="Text.PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Margin" Value="0,4,0,14" />
  </Style>

  <Style x:Key="Text.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>

  <Style x:Key="Text.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <Style x:Key="Text.Metric" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Data}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <Style x:Key="Text.Micro" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Micro}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>

  <!-- Running prose is the one place long-form proportional text is expected. -->
  <Style x:Key="Text.Prose" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Prose}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
    <Setter Property="LineHeight" Value="19" />
  </Style>

  <!-- Badge text: monospace, small, on a leading-edge badge. -->
  <Style x:Key="Text.Badge" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Micro}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- =================================================================== BADGE -->
  <!-- A status word with a 2 px leading edge in its status color; set BorderBrush and the
       inner TextBlock Foreground to the same brush. -->
  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Glass.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="7,2,7,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ================================================================ SCROLLBAR -->
  <Style x:Key="ScrollBar.PageButton" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" Background="{DynamicResource Brush.HairlineStrong}" Margin="3,0" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.TextMuted}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBar.ThumbHorizontal" TargetType="Thumb" BasedOn="{StaticResource ScrollBar.Thumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" Background="{DynamicResource Brush.HairlineStrong}" Margin="0,3" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.TextMuted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBar.PageButton}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollBar.Thumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBar.PageButton}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBar.PageButton}" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.ThumbHorizontal}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBar.PageButton}" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="PanningMode" Value="VerticalOnly" />
  </Style>

  <!-- ================================================================== BUTTONS -->
  <!-- Primary: the accent fill, chamfered. The single strongest object on screen. -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="22,10" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ctl:ChamferBorder x:Name="Root" Background="{TemplateBinding Background}"
                             Chamfer="{StaticResource Chamfer.Control}" Padding="{TemplateBinding Padding}"
                             TopLine="{DynamicResource Brush.Glass.Highlight}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </ctl:ChamferBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="Transparent" />
              <Setter TargetName="Root" Property="TopLine" Value="{x:Null}" />
              <Setter TargetName="Root" Property="Outline" Value="{DynamicResource Brush.Field.Outline}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Secondary: chamfered glass. -->
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Brush.Glass.Surface1}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ctl:ChamferBorder x:Name="Root" Background="{TemplateBinding Background}"
                             Chamfer="{StaticResource Chamfer.Control}" Padding="{TemplateBinding Padding}"
                             TopLine="{DynamicResource Brush.Glass.Border}" BottomLine="{DynamicResource Brush.Strip.Bottom}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </ctl:ChamferBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Glass.Surface2}" />
              <Setter TargetName="Root" Property="LeadingEdge" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Glass.Surface3}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
              <Setter TargetName="Root" Property="Background" Value="Transparent" />
              <Setter TargetName="Root" Property="TopLine" Value="{x:Null}" />
              <Setter TargetName="Root" Property="BottomLine" Value="{x:Null}" />
              <Setter TargetName="Root" Property="Outline" Value="{DynamicResource Brush.Hairline}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Danger: the terminate action. -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fail}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ctl:ChamferBorder x:Name="Root" Background="#1AE08A8A"
                             Chamfer="{StaticResource Chamfer.Control}" Padding="{TemplateBinding Padding}"
                             TopLine="#59E08A8A">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </ctl:ChamferBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#33E08A8A" />
              <Setter TargetName="Root" Property="LeadingEdge" Value="{DynamicResource Brush.Fail}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
              <Setter TargetName="Root" Property="Background" Value="Transparent" />
              <Setter TargetName="Root" Property="TopLine" Value="{x:Null}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tertiary: text only. -->
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Glass.Surface1}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Hairline}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chip: a selectable option (profiles). Bind Tag to a bool for the selected state. -->
  <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ctl:ChamferBorder x:Name="Root" Background="{DynamicResource Brush.Glass.Surface1}"
                             Chamfer="{StaticResource Chamfer.Chip}" Padding="{TemplateBinding Padding}"
                             Outline="{DynamicResource Brush.Field.Outline}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </ctl:ChamferBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Glass.Surface2}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <Trigger Property="Tag">
              <Trigger.Value>
                <sys:Boolean>True</sys:Boolean>
              </Trigger.Value>
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Root" Property="Outline" Value="{x:Null}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Window caption buttons for the custom title bar. -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Width" Value="38" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" Margin="2,2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Glass.Surface2}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CaptionButton.Close" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="Transparent" Margin="2,2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Fail}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Background}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================================================== NAV (sidebar rows) -->
  <!--
    Driven by the bound NavItem's IsActive rather than the control's own checked state,
    so the active treatment follows navigation from any source. Tag carries the icon key.
    Active = accent bleeding in from a 2 px leading edge. With the rail collapsed the
    label hides and the row becomes an icon with a tooltip.
  -->
  <Style x:Key="NavButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ctl:ChamferBorder x:Name="Root" Background="Transparent" Chamfer="0" Padding="12,7,10,7" Margin="0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition x:Name="Gap" Width="12" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <ctl:Icon Size="17" Foreground="{TemplateBinding Foreground}"
                        Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconKey}}" />
              <ContentPresenter x:Name="Label" Grid.Column="2" VerticalAlignment="Center" />
            </Grid>
          </ctl:ChamferBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Glass.Surface1}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Nav.Active}" />
              <Setter TargetName="Root" Property="LeadingEdge" Value="{DynamicResource Brush.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.RailCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Gap" Property="Width" Value="0" />
              <Setter TargetName="Root" Property="Padding" Value="13,8,13,8" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding DataContext.RailCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
        <Setter Property="ToolTip" Value="{Binding Label}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ================================================================= TEXTBOX -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="SelectionOpacity" Value="0.35" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Field.Outline}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" Focusable="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.HairlineStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Root" Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ CHECKBOX -->
  <!-- A small chamfered box; checked fills with the accent and inks the check. -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <ctl:ChamferBorder x:Name="Box" Width="16" Height="16" Chamfer="{StaticResource Chamfer.Box}"
                               Background="{DynamicResource Brush.Field}" Outline="{DynamicResource Brush.Field.Outline}"
                               VerticalAlignment="Center">
              <ctl:Icon x:Name="Mark" Symbol="{StaticResource Icon.Check}" Size="12" StrokeThickness="2.5"
                        Foreground="{DynamicResource Brush.OnAccent}" Opacity="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ctl:ChamferBorder>
            <ContentPresenter x:Name="Label" Margin="9,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Box" Property="Outline" Value="{x:Null}" />
              <Setter TargetName="Mark" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Outline" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
              <Setter TargetName="Box" Property="Outline" Value="{DynamicResource Brush.Hairline}" />
              <Setter TargetName="Box" Property="Background" Value="Transparent" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================= COMBOBOX -->
  <Style x:Key="ComboBox.ToggleButton" TargetType="ToggleButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root" Background="{DynamicResource Brush.Field}"
                  BorderBrush="{DynamicResource Brush.Field.Outline}" BorderThickness="1"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="26" />
              </Grid.ColumnDefinitions>
              <ctl:Icon x:Name="Arrow" Grid.Column="1" Symbol="{StaticResource Icon.ChevronDown}" Size="14"
                        Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.HairlineStrong}" />
              <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
              <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="0,1"
                  BorderThickness="2,0,0,0" BorderBrush="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Glass.Surface2}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboBox.ToggleButton}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter x:Name="Content"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              IsHitTestVisible="False"
                              VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Text="none"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       VerticalAlignment="Center" Visibility="Collapsed" />
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                   Placement="Bottom" HorizontalOffset="-12" VerticalOffset="-8"
                   PopupAnimation="None"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <ctl:ChamferBorder Background="{DynamicResource Brush.SurfaceRaised}"
                                 Chamfer="{StaticResource Chamfer.Control}"
                                 TopLine="{DynamicResource Brush.Glass.Highlight}" Padding="4"
                                 Margin="12" Effect="{StaticResource Shadow.Popup}"
                                 MinWidth="{TemplateBinding ActualWidth}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ItemsPresenter />
                </ScrollViewer>
              </ctl:ChamferBorder>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================== LISTBOX -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Root" Background="Transparent" Margin="0,1"
                  BorderThickness="2,0,0,0" BorderBrush="Transparent"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Glass.Surface1}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Nav.Active}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================= EXPANDER -->
  <Style x:Key="Expander.Toggle" TargetType="ToggleButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent" Padding="0,3">
            <StackPanel Orientation="Horizontal">
              <ctl:Icon x:Name="Glyph" Symbol="{StaticResource Icon.ChevronRight}" Size="13" Margin="0,0,6,0"
                        Foreground="{DynamicResource Brush.TextMuted}" RenderTransformOrigin="0.5,0.5" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Glyph" Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="90" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton Style="{StaticResource Expander.Toggle}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Content="{TemplateBinding Header}"
                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                          Foreground="{TemplateBinding Foreground}"
                          FontFamily="{TemplateBinding FontFamily}"
                          FontSize="{TemplateBinding FontSize}" />
            <ContentPresenter x:Name="Body" Margin="19,4,0,6" Visibility="Collapsed" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================== PROGRESSBAR -->
  <!-- Determinate: a recessed track with the HUD dashed accent fill. -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Brush.Glass.Surface2}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TrackFill}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border Background="{TemplateBinding Background}" />
            <Rectangle x:Name="PART_Track" />
            <Border HorizontalAlignment="Left">
              <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =================================================================== SLIDER -->
  <Style x:Key="Slider.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Knob" Background="{DynamicResource Brush.Text}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="Height" Value="20" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="4" Background="{DynamicResource Brush.Glass.Surface2}" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource ScrollBar.PageButton}">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" Background="{DynamicResource Brush.Accent}" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource Slider.Thumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource ScrollBar.PageButton}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =================================================================== MISC -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <ctl:ChamferBorder Background="{TemplateBinding Background}" Chamfer="{StaticResource Chamfer.Chip}"
                             TopLine="{DynamicResource Brush.Glass.Highlight}" Margin="12"
                             Effect="{StaticResource Shadow.Popup}"
                             Padding="{TemplateBinding Padding}" MaxWidth="420">
            <ContentPresenter />
          </ctl:ChamferBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Rectangle Height="1" Fill="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tray icon menu (TrayService): solid with glass cues, since a popup has nothing in-app
       behind it to refract. -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <ctl:ChamferBorder Background="{TemplateBinding Background}" Chamfer="{StaticResource Chamfer.Control}"
                             TopLine="{DynamicResource Brush.Glass.Highlight}" BottomLine="{DynamicResource Brush.Strip.Bottom}"
                             Margin="12" Effect="{StaticResource Shadow.Popup}" Padding="0,6" MinWidth="190">
            <ItemsPresenter />
          </ctl:ChamferBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Root" Background="Transparent" Padding="14,7" BorderThickness="2,0,0,0" BorderBrush="Transparent">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Nav.Active}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
