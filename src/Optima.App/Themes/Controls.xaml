<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Optima.App.Converters">

  <!--
    Control templates. Every interactive WPF control is re-templated here, because a palette
    swap alone leaves stock Aero chrome (light ComboBox popups, blue ListBox selection,
    light CheckBox glyphs, gray scrollbars) which is invisible on a gray theme but
    glaring on black.
  -->

  <!-- ============================================================== CONVERTERS -->
  <BooleanToVisibilityConverter x:Key="BoolToVis" />
  <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
  <conv:InverseBoolConverter x:Key="InverseBool" />
  <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
  <conv:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />
  <conv:StatusKindToBrushConverter x:Key="StatusKindBrush" />
  <conv:DiagnosticStatusToBrushConverter x:Key="DiagStatusBrush" />
  <conv:DiagnosticStatusToTextConverter x:Key="DiagStatusText" />
  <conv:DiagnosticStatusToTagConverter x:Key="DiagStatusTag" />
  <conv:DiagnosticStatusIsProblemConverter x:Key="DiagStatusIsProblem" />
  <conv:LogLevelToBrushConverter x:Key="LogLevelBrush" />
  <conv:NavItemVisibilityConverter x:Key="NavItemVisibility" />

  <!-- ==================================================================== TEXT -->
  <!--
    Deliberately NOT an implicit TargetType="TextBlock" style. An implicit style would
    also hit the TextBlock that a ContentPresenter generates for string content inside
    every control template, and a style setter beats property inheritance, so button,
    checkbox and combo item text would be forced to this foreground instead of the
    control's own. App-wide text defaults are set as inheritable TextElement values on
    the window root instead; these keyed styles handle specific roles.
  -->
  <Style x:Key="Text.Base" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Type.Display}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
  </Style>

  <Style x:Key="Text.PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="Margin" Value="0,3,0,16" />
  </Style>

  <Style x:Key="Text.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Type.Micro}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
  </Style>

  <Style x:Key="Text.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
  </Style>

  <Style x:Key="Text.Metric" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Type.Data}" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
  </Style>

  <Style x:Key="Text.Micro" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Type.Micro}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
  </Style>

  <!-- Running prose is the one place the proportional face is allowed. -->
  <Style x:Key="Text.Prose" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Prose}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
    <Setter Property="LineHeight" Value="18" />
  </Style>

  <!-- ================================================================ SCROLLBAR -->
  <Style x:Key="ScrollBar.PageButton" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" Background="{StaticResource Brush.HairlineStrong}" Margin="3,0" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.TextMuted}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.TextSecondary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollBar.ThumbHorizontal" TargetType="Thumb" BasedOn="{StaticResource ScrollBar.Thumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" Background="{StaticResource Brush.HairlineStrong}" Margin="0,3" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.TextMuted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBar.PageButton}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollBar.Thumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBar.PageButton}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBar.PageButton}" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar.ThumbHorizontal}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBar.PageButton}" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="PanningMode" Value="VerticalOnly" />
  </Style>

  <!-- ================================================================== BUTTONS -->
  <!-- Primary: solid white. The single brightest object on screen, used once per page. -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="24,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Text}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.TextSecondary}" />
            </Trigger>
            <!-- Disabled (e.g. a session is running): drops to outlined so its visual
                 weight falls away exactly when it can no longer be acted on. -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="Transparent" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.HairlineStrong}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Secondary: outlined. -->
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource Brush.HairlineStrong}" BorderThickness="1"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.TextMuted}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Hairline}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tertiary: text only. -->
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.Hairline}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Window caption buttons for the custom title bar. -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Width" Value="42" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CaptionButton.Close" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ====================================================== NAV (sidebar rows) -->
  <!--
    Driven by the bound NavItem's IsActive rather than the control's own checked state,
    so the '>' marker follows navigation from any source: click, Alt+N, or code.
  -->
  <Style x:Key="NavButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="Transparent" Padding="14,6,12,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Marker" Text="&gt;" Foreground="{StaticResource Brush.Accent}"
                         FontSize="{StaticResource Type.Label}" Opacity="0" VerticalAlignment="Center" />
              <TextBlock x:Name="Index" Grid.Column="1" Text="{TemplateBinding Tag}"
                         Foreground="{StaticResource Brush.Hairline}"
                         FontSize="{StaticResource Type.Micro}" VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Surface}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
              <Setter TargetName="Index" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
              <Setter TargetName="Marker" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="Index" Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================= TEXTBOX -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="CaretBrush" Value="{StaticResource Brush.Accent}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="SelectionOpacity" Value="0.45" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Hairline}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Root" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" Focusable="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.HairlineStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.TextMuted}" />
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Root" Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ CHECKBOX -->
  <!-- Rendered as literal [X] / [ ], the most terminal-native form, and it sidesteps
       glyph-alignment problems entirely. -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <TextBlock x:Name="Box" Text="[ ]" Foreground="{StaticResource Brush.TextMuted}"
                       FontFamily="{StaticResource Font.Mono}"
                       FontSize="{StaticResource Type.Label}" VerticalAlignment="Center" />
            <ContentPresenter x:Name="Label" Margin="8,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Text" Value="[X]" />
              <Setter TargetName="Box" Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Foreground" Value="{StaticResource Brush.Accent}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
              <Setter TargetName="Box" Property="Foreground" Value="{StaticResource Brush.Hairline}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================= COMBOBOX -->
  <Style x:Key="ComboBox.ToggleButton" TargetType="ToggleButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root" Background="{StaticResource Brush.SurfaceRaised}"
                  BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="22" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Arrow" Grid.Column="1" Text="v" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}"
                         FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Micro}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.HairlineStrong}" />
              <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.TextMuted}" />
              <Setter TargetName="Arrow" Property="Text" Value="^" />
              <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Marker" Text="&gt;" Opacity="0"
                         Foreground="{StaticResource Brush.Accent}"
                         FontFamily="{StaticResource Font.Mono}"
                         FontSize="{StaticResource Type.Label}" />
              <ContentPresenter Grid.Column="1" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
              <Setter TargetName="Marker" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Marker" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboBox.ToggleButton}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter x:Name="Content"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              IsHitTestVisible="False"
                              VerticalAlignment="Center" HorizontalAlignment="Left" />
            <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Text="---"
                       Foreground="{StaticResource Brush.TextMuted}"
                       VerticalAlignment="Center" Visibility="Collapsed" />
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                   Placement="Bottom" PopupAnimation="None"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Background="{StaticResource Brush.SurfaceRaised}"
                      BorderBrush="{StaticResource Brush.HairlineStrong}" BorderThickness="1"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      SnapsToDevicePixels="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================== LISTBOX -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Root" Background="Transparent"
                  BorderBrush="Transparent" BorderThickness="2,0,0,0"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Surface}" />
            </Trigger>
            <!-- Selection is a left rule + raised ground, never the Windows blue fill. -->
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================= EXPANDER -->
  <Style x:Key="Expander.Toggle" TargetType="ToggleButton">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent" Padding="0,3">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="Glyph" Text="&#x25B8;" Width="14"
                         Foreground="{StaticResource Brush.TextMuted}"
                         FontFamily="{StaticResource Font.Mono}"
                         FontSize="{StaticResource Type.Micro}" VerticalAlignment="Center" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Glyph" Property="Text" Value="&#x25BE;" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton Style="{StaticResource Expander.Toggle}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Content="{TemplateBinding Header}"
                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                          Foreground="{TemplateBinding Foreground}"
                          FontFamily="{TemplateBinding FontFamily}"
                          FontSize="{TemplateBinding FontSize}" />
            <ContentPresenter x:Name="Body" Margin="14,4,0,6" Visibility="Collapsed" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================== PROGRESSBAR -->
  <!-- Determinate only; indeterminate work uses AsciiSpinner instead. -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="3" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{StaticResource Brush.Hairline}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Rectangle Fill="{TemplateBinding Background}" />
            <Rectangle x:Name="PART_Track" />
            <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =================================================================== MISC -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Micro}" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource Brush.HairlineStrong}" BorderThickness="1"
                  Padding="{TemplateBinding Padding}" MaxWidth="420">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Background" Value="{StaticResource Brush.Hairline}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Rectangle Height="1" Fill="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Used by the tray icon menu (TrayService); templates drop the stock icon/check
       gutter, which has no place in a text-only menu. -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource Brush.HairlineStrong}" BorderThickness="1"
                  Padding="4">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Root" Background="Transparent" Padding="10,6">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
