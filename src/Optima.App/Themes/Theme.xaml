<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <FontFamily x:Key="Font.Body">Space Grotesk, Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
  <FontFamily x:Key="Font.Prose">Segoe UI Variable Text, Segoe UI</FontFamily>
  <sys:Double x:Key="Type.Display">30</sys:Double>
  <sys:Double x:Key="Type.Title">20</sys:Double>
  <sys:Double x:Key="Type.Body">13</sys:Double>
  <sys:Double x:Key="Type.Value">12</sys:Double>
  <sys:Double x:Key="Type.Label">11</sys:Double>
  <sys:Double x:Key="Type.Micro">10.5</sys:Double>
  <sys:Double x:Key="Type.Data">26</sys:Double>
  <sys:Double x:Key="Space.1">4</sys:Double>
  <sys:Double x:Key="Space.2">8</sys:Double>
  <sys:Double x:Key="Space.3">12</sys:Double>
  <sys:Double x:Key="Space.4">16</sys:Double>
  <sys:Double x:Key="Space.5">24</sys:Double>
  <Thickness x:Key="Pad.Section">0,0,0,12</Thickness>
  <Thickness x:Key="Pad.Page">24,14,24,24</Thickness>
  <Thickness x:Key="Pad.Row">0,4,0,4</Thickness>
  <sys:Double x:Key="Chamfer.Strip">10</sys:Double>
  <sys:Double x:Key="Chamfer.Control">8</sys:Double>
  <sys:Double x:Key="Chamfer.Chip">6</sys:Double>
  <sys:Double x:Key="Chamfer.Toggle">5</sys:Double>
  <sys:Double x:Key="Chamfer.Box">4</sys:Double>
  <CornerRadius x:Key="Radius.Control">0</CornerRadius>
  <CornerRadius x:Key="Radius.Card">0</CornerRadius>
  <CornerRadius x:Key="Radius.Chip">0</CornerRadius>
  <CornerRadius x:Key="Radius.Window">12</CornerRadius>
  <sys:Int32 x:Key="Motion.Page">220</sys:Int32>
  <sys:Int32 x:Key="Motion.Row">180</sys:Int32>
  <sys:Int32 x:Key="Motion.Launch">700</sys:Int32>
  <SolidColorBrush x:Key="Brush.Overlay.Ground" Color="#CC000000" />
  <SolidColorBrush x:Key="Brush.Overlay.Border" Color="#33FFFFFF" />

  <DropShadowEffect x:Key="Shadow.Card" Color="#000000" Opacity="0.45" BlurRadius="30" ShadowDepth="10" Direction="270" />
  <DropShadowEffect x:Key="Shadow.Popup" Color="#000000" Opacity="0.55" BlurRadius="30" ShadowDepth="10" Direction="270" />
</ResourceDictionary>
