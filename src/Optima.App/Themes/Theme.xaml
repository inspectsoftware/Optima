<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    Structural design tokens: type, spacing, shape. Nothing here depends on the
    active theme; colors and brushes live in Palette.Dark.xaml / Palette.Light.xaml
    (swapped at runtime by ThemeService, which also derives the accent family
    from the user's chosen color).
  -->

  <!-- Type: data and metrics stay monospace; navigation and prose are humanist. -->
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
  <FontFamily x:Key="Font.Prose">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI</FontFamily>

  <sys:Double x:Key="Type.Display">22</sys:Double>
  <sys:Double x:Key="Type.Title">15</sys:Double>
  <sys:Double x:Key="Type.Body">12.5</sys:Double>
  <sys:Double x:Key="Type.Label">11.5</sys:Double>
  <sys:Double x:Key="Type.Micro">10.5</sys:Double>
  <sys:Double x:Key="Type.Data">26</sys:Double>

  <!-- Spacing -->
  <sys:Double x:Key="Space.1">4</sys:Double>
  <sys:Double x:Key="Space.2">8</sys:Double>
  <sys:Double x:Key="Space.3">12</sys:Double>
  <sys:Double x:Key="Space.4">16</sys:Double>
  <sys:Double x:Key="Space.5">24</sys:Double>

  <Thickness x:Key="Pad.Section">0,0,0,20</Thickness>
  <Thickness x:Key="Pad.Page">26,20,26,26</Thickness>
  <Thickness x:Key="Pad.Row">0,4,0,4</Thickness>

  <!-- Shape: the glass language is soft. One token per tier. -->
  <CornerRadius x:Key="Radius.Control">10</CornerRadius>
  <CornerRadius x:Key="Radius.Card">14</CornerRadius>
  <CornerRadius x:Key="Radius.Chip">999</CornerRadius>
  <CornerRadius x:Key="Radius.Window">12</CornerRadius>

  <!--
    In-game overlay surfaces. Deliberately theme-INVARIANT: the overlay renders over
    live gameplay, where a light glass pane would be unreadable, so it keeps the dark
    ground in both themes. That is why these live here and not in the palettes.
  -->
  <SolidColorBrush x:Key="Brush.Overlay.Ground" Color="#CC0B0D12" />
  <SolidColorBrush x:Key="Brush.Overlay.Border" Color="#33FFFFFF" />

  <!--
    Depth shadows. Neutral black works over both palettes, and staying theme-free
    matters mechanically: an Effect is a Freezable, so it cannot resolve
    DynamicResource and would go stale on a live theme or accent change.
  -->
  <DropShadowEffect x:Key="Shadow.Card" Color="#000000" Opacity="0.35" BlurRadius="24" ShadowDepth="4" Direction="270" />
  <DropShadowEffect x:Key="Shadow.Popup" Color="#000000" Opacity="0.45" BlurRadius="32" ShadowDepth="8" Direction="270" />
</ResourceDictionary>
