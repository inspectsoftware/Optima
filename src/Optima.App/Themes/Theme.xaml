<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    Design tokens. Nothing in this file draws anything — it only names values.
    Palette is true monochrome: white is the accent, and hue appears ONLY inside
    status tags. Text steps are chosen so the dimmest one still clears WCAG AA
    (4.5:1) against Color.Background.
  -->

  <!-- ================================================================ SURFACES -->
  <Color x:Key="Color.Background">#FF07080A</Color>
  <Color x:Key="Color.Surface">#FF0D0F12</Color>
  <Color x:Key="Color.SurfaceRaised">#FF14171B</Color>
  <Color x:Key="Color.SurfaceHover">#FF1B1F25</Color>
  <Color x:Key="Color.Hairline">#FF1E2228</Color>
  <Color x:Key="Color.HairlineStrong">#FF2A2F36</Color>

  <!-- ==================================================================== TEXT -->
  <!-- Contrast vs Color.Background: muted 4.85:1, secondary 7.9:1, primary 15:1, accent 20:1 -->
  <Color x:Key="Color.TextMuted">#FF757D88</Color>
  <Color x:Key="Color.TextSecondary">#FF9AA3AE</Color>
  <Color x:Key="Color.Text">#FFD4D9DF</Color>
  <Color x:Key="Color.Accent">#FFFFFFFF</Color>
  <Color x:Key="Color.OnAccent">#FF07080A</Color>

  <!-- ============================================================ STATUS (hue) -->
  <!-- The only saturated values in the app. Used inside [ TAGS ] and log levels. -->
  <Color x:Key="Color.Ok">#FF6E9E7C</Color>
  <Color x:Key="Color.Warn">#FFB89A5E</Color>
  <Color x:Key="Color.Fail">#FFB87070</Color>
  <Color x:Key="Color.Info">#FF7C8FA6</Color>

  <!-- ================================================================= BRUSHES -->
  <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.Hairline" Color="{StaticResource Color.Hairline}" />
  <SolidColorBrush x:Key="Brush.HairlineStrong" Color="{StaticResource Color.HairlineStrong}" />

  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />

  <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}" />
  <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />
  <SolidColorBrush x:Key="Brush.Fail" Color="{StaticResource Color.Fail}" />
  <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />

  <!-- Legacy aliases so any not-yet-migrated markup still resolves. -->
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Hairline}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Ok}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warn}" />
  <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Fail}" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.TextSecondary}" />

  <!-- ==================================================================== TYPE -->
  <!-- Structure and data are monospace; only running prose uses the proportional face. -->
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
  <FontFamily x:Key="Font.Prose">Segoe UI Variable Text, Segoe UI</FontFamily>

  <sys:Double x:Key="Type.Display">21</sys:Double>
  <sys:Double x:Key="Type.Title">15</sys:Double>
  <sys:Double x:Key="Type.Body">12.5</sys:Double>
  <sys:Double x:Key="Type.Label">11.5</sys:Double>
  <sys:Double x:Key="Type.Micro">10.5</sys:Double>
  <sys:Double x:Key="Type.Data">26</sys:Double>

  <!-- ================================================================= SPACING -->
  <sys:Double x:Key="Space.1">4</sys:Double>
  <sys:Double x:Key="Space.2">8</sys:Double>
  <sys:Double x:Key="Space.3">12</sys:Double>
  <sys:Double x:Key="Space.4">16</sys:Double>
  <sys:Double x:Key="Space.5">24</sys:Double>

  <Thickness x:Key="Pad.Section">0,0,0,18</Thickness>
  <Thickness x:Key="Pad.Page">22,18,22,22</Thickness>
  <Thickness x:Key="Pad.Row">0,3,0,3</Thickness>

  <!-- Corners are square in this design; kept as a token so it stays one edit. -->
  <CornerRadius x:Key="Radius.Control">0</CornerRadius>

  <!-- ================================================================= LEADERS -->
  <!--
    Dot-leader fill used between a label and its value. Tiling a single dot in a
    DrawingBrush is robust at any width and any font metric; repeating "·" glyphs
    in a TextBlock is not (it wraps and clips unpredictably).
  -->
  <DrawingBrush x:Key="Brush.DotLeader"
                TileMode="Tile"
                Viewport="0,0,5,5" ViewportUnits="Absolute"
                Viewbox="0,0,5,5" ViewboxUnits="Absolute"
                AlignmentX="Left" AlignmentY="Bottom" Stretch="None">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="{StaticResource Brush.Hairline}">
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="0,2,1.4,1.4" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>
