<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:Optima.App.Controls">
  <Style x:Key="Section" TargetType="HeaderedContentControl">
    <Setter Property="Margin" Value="{StaticResource Pad.Section}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <ctl:GlassPanel Chamfer="{StaticResource Chamfer.Strip}" Padding="18,12,16,14"
                          Tint="{DynamicResource Color.Glass.Tint}"
                          TopLine="{DynamicResource Brush.Strip.Top}"
                          BottomLine="{DynamicResource Brush.Strip.Bottom}"
                          LeadingEdge="{DynamicResource Brush.Strip.Edge}">
            <ctl:GlassPanel.Child>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource Text.SectionHeader}" />
                  <ContentPresenter Grid.Column="2" Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
                </Grid>
                <ContentPresenter Margin="0,10,0,0" />
              </StackPanel>
            </ctl:GlassPanel.Child>
          </ctl:GlassPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GlassCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Tile}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Strip.Top}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Callout" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Tile}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource GlassCard}">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="12,9,12,10" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

  <Style x:Key="Leader" TargetType="Rectangle">
    <Setter Property="Height" Value="0" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Margin" Value="8,0" />
  </Style>

  <DataTemplate x:Key="InfoRowTemplate">
    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="16" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Text.Value}"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="StatusItemTemplate">
    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="16" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
      <Border Grid.Column="2" Style="{StaticResource Badge}"
              BorderBrush="{Binding Kind, Converter={StaticResource StatusKindBrush}}">
        <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Badge}"
                   Foreground="{Binding Kind, Converter={StaticResource StatusKindBrush}}" />
      </Border>
    </Grid>
  </DataTemplate>

  <Style x:Key="TableRow" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Text.TableHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="Text.Cell" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Text.CellDim" TargetType="TextBlock" BasedOn="{StaticResource Text.Cell}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>

  <Style TargetType="ctl:AsciiBar">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TrackFill}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="90" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:AsciiBar">
          <ProgressBar Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                       Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                       Foreground="{TemplateBinding Foreground}"
                       IsTabStop="False" Focusable="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ctl:AsciiSpinner">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:AsciiSpinner">
          <Border Background="{DynamicResource Brush.Glass.Surface2}" ClipToBounds="True">
            <Rectangle x:Name="SweepBar" Width="18" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PageRoot" TargetType="StackPanel">
    <Setter Property="Margin" Value="{StaticResource Pad.Page}" />
  </Style>
</ResourceDictionary>
