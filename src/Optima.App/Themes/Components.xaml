<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:Optima.App.Controls">

  <!--
    App-level composites built on the tokens and control templates. The Section is the
    strip: every grouped block on every page is a glass strip refracting the ambient
    field, so restyling it here restyles the whole app.
  -->

  <!-- ================================================================= SECTION -->
  <!--
    A glass strip: header label, an optional action slot (bind to Tag), then the body.
    Chamfered, with the chroma leading edge and the specular top line.
  -->
  <Style x:Key="Section" TargetType="HeaderedContentControl">
    <Setter Property="Margin" Value="{StaticResource Pad.Section}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <ctl:GlassPanel Chamfer="{StaticResource Chamfer.Strip}" Padding="18,12,16,14"
                          Tint="{DynamicResource Color.Glass.Tint}"
                          TopLine="{DynamicResource Brush.Strip.Top}"
                          BottomLine="{DynamicResource Brush.Strip.Bottom}"
                          LeadingEdge="{DynamicResource Brush.Strip.Edge}">
            <ctl:GlassPanel.Child>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource Text.SectionHeader}" />
                  <ContentPresenter Grid.Column="2" Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
                </Grid>
                <ContentPresenter Margin="0,10,0,0" />
              </StackPanel>
            </ctl:GlassPanel.Child>
          </ctl:GlassPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A recessed tile inside a strip: darker, top specular. -->
  <Style x:Key="GlassCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Tile}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Strip.Top}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- A framed variant for callouts that genuinely need an edge (warnings, errors):
       set BorderBrush to the status color; it becomes the leading edge. -->
  <Style x:Key="Callout" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Tile}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- Stat tile: label over a monospace number. -->
  <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource GlassCard}">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="12,9,12,10" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

  <!-- =============================================================== DOT LEADER -->
  <!-- Retired: label and value now sit on the same row with the value right-aligned.
       Kept as a style so existing rows keep their layout, drawing nothing. -->
  <Style x:Key="Leader" TargetType="Rectangle">
    <Setter Property="Height" Value="0" />
    <Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="Margin" Value="8,0" />
  </Style>

  <!-- ============================================================ LABEL / VALUE -->
  <DataTemplate x:Key="InfoRowTemplate">
    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="16" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Text.Value}"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <!-- Same row, value rendered as a status badge with a leading edge in its status color. -->
  <DataTemplate x:Key="StatusItemTemplate">
    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="16" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
      <Border Grid.Column="2" Style="{StaticResource Badge}"
              BorderBrush="{Binding Kind, Converter={StaticResource StatusKindBrush}}">
        <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Badge}"
                   Foreground="{Binding Kind, Converter={StaticResource StatusKindBrush}}" />
      </Border>
    </Grid>
  </DataTemplate>

  <!-- ================================================================== TABLES -->
  <Style x:Key="TableRow" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Text.TableHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="Text.Cell" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource Type.Value}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Text.CellDim" TargetType="TextBlock" BasedOn="{StaticResource Text.Cell}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>

  <!-- ================================================================== METERS -->
  <!--
    AsciiBar / AsciiSpinner keep their historical class names and API (Value, Maximum,
    Cells), so no view or view-model changes. The bar is a recessed HUD track; the spinner
    is an indeterminate light sweep along a short track.
  -->
  <Style TargetType="ctl:AsciiBar">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TrackFill}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="90" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:AsciiBar">
          <ProgressBar Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                       Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                       Foreground="{TemplateBinding Foreground}"
                       IsTabStop="False" Focusable="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ctl:AsciiSpinner">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:AsciiSpinner">
          <Border Background="{DynamicResource Brush.Glass.Surface2}" ClipToBounds="True">
            <Rectangle Width="18" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}">
              <Rectangle.RenderTransform>
                <TranslateTransform x:Name="Sweep" X="-18" />
              </Rectangle.RenderTransform>
            </Rectangle>
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="X"
                                   From="-18" To="44" Duration="0:0:1.1" RepeatBehavior="Forever" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =============================================================== PAGE SHELL -->
  <Style x:Key="PageRoot" TargetType="StackPanel">
    <Setter Property="Margin" Value="{StaticResource Pad.Page}" />
  </Style>
</ResourceDictionary>
