<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:Optima.App.Controls">

  <!--
    App-level composites built on the tokens and control templates. These exist so the
    same visual idea is expressed once: previously the label/value row had six separate
    hand-rolled implementations with seven different hardcoded column widths.
  -->

  <!-- ================================================================= SECTION -->
  <!--
    A borderless section: an all-caps header, a hairline rule running to the right
    edge, an optional action slot (bind to Tag), then the body.
    Replaces the bordered Card used 27 times.
  -->
  <Style x:Key="Section" TargetType="HeaderedContentControl">
    <Setter Property="Margin" Value="0,0,0,18" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource Text.SectionHeader}" />
              <Rectangle Grid.Column="1" Height="1" Margin="10,0,10,0" VerticalAlignment="Center"
                         Fill="{StaticResource Brush.Hairline}" />
              <ContentPresenter Grid.Column="2" Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
            </Grid>
            <ContentPresenter Margin="0,9,0,0" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A framed variant for callouts that genuinely need an edge (warnings, errors). -->
  <Style x:Key="Callout" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.HairlineStrong}" />
    <Setter Property="BorderThickness" Value="1,1,1,1" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- =============================================================== DOT LEADER -->
  <!--
    The connector between a label and its value. A tiled DrawingBrush rather than
    repeated "·" glyphs: it fills any width exactly and never wraps or clips.
  -->
  <Style x:Key="Leader" TargetType="Rectangle">
    <Setter Property="Fill" Value="{StaticResource Brush.DotLeader}" />
    <Setter Property="Height" Value="5" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="8,0,8,3" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ============================================================ LABEL / VALUE -->
  <!-- Binds to InfoRow (Label, Value). The single row implementation for the app. -->
  <DataTemplate x:Key="InfoRowTemplate">
    <Grid Margin="0,3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="16" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" />
      <Rectangle Grid.Column="1" Style="{StaticResource Leader}" />
      <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Text.Value}"
                 TextTrimming="CharacterEllipsis" />
    </Grid>
  </DataTemplate>

  <!-- Same row, value rendered as a bracket tag tinted by StatusKind. -->
  <DataTemplate x:Key="StatusItemTemplate">
    <Grid Margin="0,3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="16" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" />
      <Rectangle Grid.Column="1" Style="{StaticResource Leader}" />
      <TextBlock Grid.Column="2"
                 Text="{Binding Value, StringFormat='[ {0} ]'}"
                 FontSize="{StaticResource Type.Label}"
                 Foreground="{Binding Kind, Converter={StaticResource StatusKindBrush}}" />
    </Grid>
  </DataTemplate>

  <!-- ================================================================== TABLES -->
  <!-- Shared row chrome for the ItemsControl tables (processes, monitors, sessions). -->
  <Style x:Key="TableRow" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Text.TableHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Micro}">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="Text.Cell" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Text.CellDim" TargetType="TextBlock" BasedOn="{StaticResource Text.Cell}">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
  </Style>

  <!-- ============================================================ ASCII METERS -->
  <!--
    Filled run and track are separate runs so the lit portion can be white while the
    remainder stays a hairline gray, since a single-color bar reads as noise.
  -->
  <Style TargetType="ctl:AsciiBar">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:AsciiBar">
          <TextBlock FontFamily="{StaticResource Font.Mono}"
                     FontSize="{StaticResource Type.Label}"
                     TextTrimming="None" VerticalAlignment="Center">
            <Run Text="{Binding FilledText, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                 Foreground="{TemplateBinding Foreground}" />
            <Run Text="{Binding EmptyText, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                 Foreground="{StaticResource Brush.HairlineStrong}" />
          </TextBlock>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ctl:AsciiSpinner">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ctl:AsciiSpinner">
          <TextBlock Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                     Foreground="{TemplateBinding Foreground}"
                     FontFamily="{StaticResource Font.Mono}"
                     FontSize="{StaticResource Type.Label}"
                     TextTrimming="None" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =============================================================== PAGE SHELL -->
  <Style x:Key="PageRoot" TargetType="StackPanel">
    <Setter Property="Margin" Value="22,18,22,22" />
  </Style>
</ResourceDictionary>
