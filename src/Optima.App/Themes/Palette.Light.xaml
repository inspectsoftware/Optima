<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Background">#FFF2F1EE</Color>
  <Color x:Key="Color.WindowGround">#D9F2F1EE</Color>
  <Color x:Key="Color.Surface">#FFFAF9F7</Color>
  <Color x:Key="Color.SurfaceRaised">#FFFFFFFF</Color>
  <Color x:Key="Color.SurfaceHover">#FFEDEBE6</Color>
  <Color x:Key="Color.Hairline">#FFDDD9D2</Color>
  <Color x:Key="Color.HairlineStrong">#FFC9C4BA</Color>
  <Color x:Key="Color.Deep">#FFE9E7E2</Color>
  <Color x:Key="Color.TextMuted">#FF6B675E</Color>
  <Color x:Key="Color.TextSecondary">#FF55514A</Color>
  <Color x:Key="Color.Text">#FF26241F</Color>
  <Color x:Key="Color.Accent">#FFB07B1E</Color>
  <Color x:Key="Color.OnAccent">#FFFFFDF6</Color>
  <Color x:Key="Color.Ok">#FF39734C</Color>
  <Color x:Key="Color.Warn">#FF8A661C</Color>
  <Color x:Key="Color.Fail">#FFA84848</Color>
  <Color x:Key="Color.Info">#FF44618F</Color>
  <SolidColorBrush x:Key="Brush.Background" Color="{DynamicResource Color.Background}" />
  <SolidColorBrush x:Key="Brush.WindowGround" Color="{DynamicResource Color.WindowGround}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{DynamicResource Color.SurfaceRaised}" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{DynamicResource Color.SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.Hairline" Color="{DynamicResource Color.Hairline}" />
  <SolidColorBrush x:Key="Brush.HairlineStrong" Color="{DynamicResource Color.HairlineStrong}" />
  <SolidColorBrush x:Key="Brush.Deep" Color="{DynamicResource Color.Deep}" />

  <SolidColorBrush x:Key="Brush.TextMuted" Color="{DynamicResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Color.TextSecondary}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{DynamicResource Color.Text}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{DynamicResource Color.OnAccent}" />

  <SolidColorBrush x:Key="Brush.Ok" Color="{DynamicResource Color.Ok}" />
  <SolidColorBrush x:Key="Brush.Warn" Color="{DynamicResource Color.Warn}" />
  <SolidColorBrush x:Key="Brush.Fail" Color="{DynamicResource Color.Fail}" />
  <SolidColorBrush x:Key="Brush.Info" Color="{DynamicResource Color.Info}" />

  <SolidColorBrush x:Key="Brush.Glass.Surface1" Color="#0A000000" />
  <SolidColorBrush x:Key="Brush.Glass.Surface2" Color="#12000000" />
  <SolidColorBrush x:Key="Brush.Glass.Surface3" Color="#1A000000" />
  <SolidColorBrush x:Key="Brush.Glass.Border" Color="#1F000000" />
  <SolidColorBrush x:Key="Brush.Glass.Highlight" Color="#66FFFFFF" />

  <LinearGradientBrush x:Key="Brush.Glass.Specular" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#B3FFFFFF" Offset="0" />
    <GradientStop Color="#24000000" Offset="0.25" />
    <GradientStop Color="#1F000000" Offset="1" />
  </LinearGradientBrush>

  <Color x:Key="Color.ChromaRed">#FFD94A38</Color>
  <Color x:Key="Color.ChromaBlue">#FF3F78D6</Color>
  <Color x:Key="Color.Glass.Tint">#26FFFFFF</Color>
  <SolidColorBrush x:Key="Brush.ChromaRed" Color="{DynamicResource Color.ChromaRed}" />
  <SolidColorBrush x:Key="Brush.ChromaBlue" Color="{DynamicResource Color.ChromaBlue}" />
  <SolidColorBrush x:Key="Brush.Strip.Top" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="Brush.Strip.Bottom" Color="#33000000" />
  <LinearGradientBrush x:Key="Brush.Strip.Edge" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#99D94A38" Offset="0" />
    <GradientStop Color="#FFB07B1E" Offset="0.4" />
    <GradientStop Color="#993F78D6" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.Nav.Active" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#29B07B1E" Offset="0" />
    <GradientStop Color="#00B07B1E" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brush.Field" Color="#14000000" />
  <SolidColorBrush x:Key="Brush.Field.Outline" Color="#22000000" />
  <SolidColorBrush x:Key="Brush.Tile" Color="#0F000000" />
  <SolidColorBrush x:Key="Brush.Scrim" Color="#26FFFFFF" />
  <DrawingBrush x:Key="Brush.Grid" TileMode="Tile"
                Viewport="0,0,48,48" ViewportUnits="Absolute"
                Viewbox="0,0,48,48" ViewboxUnits="Absolute" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#0C000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,48,1" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#0C000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,48" /></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <DrawingBrush x:Key="Brush.TrackFill" TileMode="Tile"
                Viewport="0,0,8,4" ViewportUnits="Absolute"
                Viewbox="0,0,8,4" ViewboxUnits="Absolute" Stretch="None">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#FFB07B1E"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,6,4" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#59B07B1E"><GeometryDrawing.Geometry><RectangleGeometry Rect="6,0,2,4" /></GeometryDrawing.Geometry></GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFC08A2B" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF986A19" />
  <SolidColorBrush x:Key="Brush.AccentGlow" Color="#40B07B1E" />

  <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Hairline}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.Ok}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warn}" />
  <SolidColorBrush x:Key="Brush.Error" Color="{DynamicResource Color.Fail}" />

  <DrawingBrush x:Key="Brush.DotLeader"
                TileMode="Tile"
                Viewport="0,0,5,5" ViewportUnits="Absolute"
                Viewbox="0,0,5,5" ViewboxUnits="Absolute"
                AlignmentX="Left" AlignmentY="Bottom" Stretch="None">
    <DrawingBrush.Drawing>
      <GeometryDrawing>
        <GeometryDrawing.Brush>
          <SolidColorBrush Color="#FFDDD9D2" />
        </GeometryDrawing.Brush>
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="0,2,1.4,1.4" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>
