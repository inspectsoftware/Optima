<UserControl x:Class="Optima.App.Controls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             x:Name="Root" Height="32">
  <Border Background="{StaticResource Brush.Surface}"
          BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Brand -->
      <TextBlock Margin="14,0,0,0" VerticalAlignment="Center"
                 FontFamily="{StaticResource Font.Mono}"
                 FontSize="{StaticResource Type.Label}">
        <Run Text="OPTIMA" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold" />
        <Run Text="://" Foreground="{StaticResource Brush.Hairline}" />
        <Run Text="LAUNCHER" Foreground="{StaticResource Brush.TextMuted}" />
      </TextBlock>

      <!-- Breadcrumb for the current page -->
      <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                 Text="{Binding Breadcrumb, ElementName=Root}"
                 Foreground="{StaticResource Brush.TextMuted}"
                 FontFamily="{StaticResource Font.Mono}"
                 FontSize="{StaticResource Type.Micro}"
                 Visibility="{Binding Breadcrumb, ElementName=Root, Converter={StaticResource EmptyToCollapsed}}" />

      <!-- Session state, readable from any page -->
      <TextBlock Grid.Column="3" Margin="0,0,14,0" VerticalAlignment="Center"
                 Text="{Binding SessionTag, ElementName=Root}"
                 Foreground="{StaticResource Brush.TextMuted}"
                 FontFamily="{StaticResource Font.Mono}"
                 FontSize="{StaticResource Type.Micro}"
                 Visibility="{Binding SessionTag, ElementName=Root, Converter={StaticResource EmptyToCollapsed}}" />

      <!-- Caption buttons -->
      <StackPanel Grid.Column="4" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#x2500;"
                Click="OnMinimize" ToolTip="Minimize"
                Visibility="{Binding ShowMinimize, ElementName=Root, Converter={StaticResource BoolToVis}}" />
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#x25A1;"
                Click="OnMaximizeRestore" ToolTip="Maximize"
                Visibility="{Binding ShowMaximize, ElementName=Root, Converter={StaticResource BoolToVis}}" />
        <Button Style="{StaticResource CaptionButton.Close}" Content="&#x2715;"
                Click="OnClose" ToolTip="Close" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
