<UserControl x:Class="Optima.App.Controls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Optima.App.Controls"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             x:Name="Root" Height="28">
  <Grid Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
               Text="{Binding Breadcrumb, ElementName=Root}"
               Foreground="{DynamicResource Brush.TextMuted}"
               FontFamily="{StaticResource Font.Mono}"
               FontSize="{StaticResource Type.Label}" />

    <TextBlock Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center"
               Text="{Binding SessionTag, ElementName=Root}"
               Foreground="{DynamicResource Brush.Accent}"
               FontFamily="{StaticResource Font.Mono}"
               FontSize="{StaticResource Type.Label}"
               Visibility="{Binding SessionTag, ElementName=Root, Converter={StaticResource EmptyToCollapsed}}" />

    <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimize"
              Visibility="{Binding ShowMinimize, ElementName=Root, Converter={StaticResource BoolToVis}}">
        <ctl:Icon Symbol="{StaticResource Icon.Minimize}" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Button>
      <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnMaximizeRestore" ToolTip="Maximize"
              Visibility="{Binding ShowMaximize, ElementName=Root, Converter={StaticResource BoolToVis}}">
        <ctl:Icon x:Name="MaximizeGlyph" Symbol="{StaticResource Icon.Maximize}" Size="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Button>
      <Button Style="{StaticResource CaptionButton.Close}" Click="OnClose" ToolTip="Close">
        <ctl:Icon Symbol="{StaticResource Icon.Close}" Size="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
