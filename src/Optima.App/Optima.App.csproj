<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Optima.App</RootNamespace>
    <AssemblyName>Optima</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Optima.Core\Optima.Core.csproj" />
    <ProjectReference Include="..\Optima.Platform.Windows\Optima.Platform.Windows.csproj" />
    <ProjectReference Include="..\Optima.Driver\Optima.Driver.csproj" />
    <ProjectReference Include="..\Optima.Monitoring\Optima.Monitoring.csproj" />
    <!-- The elevated helper ships next to the app exe; not referenced at compile time. -->
    <ProjectReference Include="..\Optima.Elevated\Optima.Elevated.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Ship the bundled driver package (if the repo's drivers/ folder has one) next to the
       executable, so IDriverInstaller can find and install it at runtime. -->
  <ItemGroup>
    <None Include="..\..\drivers\**\*.*" Exclude="..\..\drivers\README.md"
          Link="drivers\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ship the elevated helper (and its dependencies) alongside the app executable.

       The helper's own assemblies are copied unconditionally on every build: a stale
       helper silently answers with old code, which is invisible because it runs in a
       separate elevated process.

       Its *dependencies* are only copied when absent, so the helper's older transitive
       assemblies (TraceEvent drags in 6.x Microsoft.Extensions.*) can never overwrite
       the app's own newer copies. -->
  <Target Name="CopyElevatedHelper" AfterTargets="Build">
    <ItemGroup>
      <ElevatedOwnFiles Include="..\Optima.Elevated\bin\$(Configuration)\$(TargetFramework)\Optima.Elevated.*" />
      <ElevatedDependencies Include="..\Optima.Elevated\bin\$(Configuration)\$(TargetFramework)\**\*.*"
                            Exclude="..\Optima.Elevated\bin\$(Configuration)\$(TargetFramework)\Optima.Elevated.*" />
      <ElevatedDependenciesToCopy Include="@(ElevatedDependencies)"
                                  Condition="!Exists('$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(ElevatedOwnFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ElevatedDependenciesToCopy)"
          DestinationFiles="@(ElevatedDependenciesToCopy->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
