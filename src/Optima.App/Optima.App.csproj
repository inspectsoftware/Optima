<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Optima.App</RootNamespace>
    <AssemblyName>Optima</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Optima.Core\Optima.Core.csproj" />
    <ProjectReference Include="..\Optima.Platform.Windows\Optima.Platform.Windows.csproj" />
    <ProjectReference Include="..\Optima.Driver\Optima.Driver.csproj" />
    <ProjectReference Include="..\Optima.Monitoring\Optima.Monitoring.csproj" />
    <!-- The elevated helper ships next to the app exe; not referenced at compile time. -->
    <ProjectReference Include="..\Optima.Elevated\Optima.Elevated.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Ship the elevated helper (and its dependencies) alongside the app executable.
       Only files the app output does not already provide are copied, so the helper's
       older transitive assemblies (e.g. TraceEvent's 6.x Microsoft.Extensions.*) can
       never clobber the app's own newer ones. -->
  <Target Name="CopyElevatedHelper" AfterTargets="Build">
    <ItemGroup>
      <ElevatedFiles Include="..\Optima.Elevated\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
      <ElevatedFilesToCopy Include="@(ElevatedFiles)"
                           Condition="!Exists('$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(ElevatedFilesToCopy)"
          DestinationFiles="@(ElevatedFilesToCopy->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
