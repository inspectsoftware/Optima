<Window x:Class="Optima.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Optima.App.ViewModels"
        xmlns:ctl="clr-namespace:Optima.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Optima"
        Icon="/Assets/optima.ico"
        Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                        CornerRadius="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.InputBindings>
    <KeyBinding Modifiers="Alt" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="HOME" />
    <KeyBinding Modifiers="Alt" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="PLAY" />
    <KeyBinding Modifiers="Alt" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="PERFORMANCE" />
    <KeyBinding Modifiers="Alt" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="SESSIONS" />
    <KeyBinding Modifiers="Alt" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="COMP" />
    <KeyBinding Modifiers="Alt" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="BOOST" />
    <KeyBinding Modifiers="Alt" Key="D7" Command="{Binding NavigateCommand}" CommandParameter="DISPLAY" />
    <KeyBinding Modifiers="Alt" Key="D8" Command="{Binding NavigateCommand}" CommandParameter="SETTINGS" />
    <KeyBinding Modifiers="Alt" Key="D9" Command="{Binding NavigateCommand}" CommandParameter="DEBUG" />
    <KeyBinding Modifiers="Alt" Key="N" Command="{Binding NavigateCommand}" CommandParameter="NEWS" />
    <KeyBinding Modifiers="Alt" Key="U" Command="{Binding NavigateCommand}" CommandParameter="UPDATES" />
    <KeyBinding Modifiers="Alt" Key="L" Command="{Binding NavigateCommand}" CommandParameter="LEGAL" />
    <KeyBinding Modifiers="Alt" Key="D" Command="{Binding NavigateCommand}" CommandParameter="DEVELOPER" />
    <KeyBinding Modifiers="Alt" Key="B" Command="{Binding ToggleRailCommand}" />
  </Window.InputBindings>

  <!-- Page views are built and cached by MainWindow.ShowCurrentPage instead of a DataTemplate: a
       template re-instantiates the whole page visual tree on every navigation, which is the most
       expensive thing a rail click can do. -->

  <Border x:Name="RootBorder" Background="{DynamicResource Brush.WindowGround}"
          TextElement.Foreground="{DynamicResource Brush.Text}"
          TextElement.FontFamily="{StaticResource Font.Body}"
          TextElement.FontSize="{StaticResource Type.Body}">
    <Grid>
      <ctl:AmbientField x:Name="Ambient" DrawGrid="False" />
      <Rectangle Fill="{DynamicResource Brush.Grid}" IsHitTestVisible="False">
        <Rectangle.OpacityMask>
          <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.75" RadiusY="0.75">
            <GradientStop Color="#FF000000" Offset="0" />
            <GradientStop Color="#00000000" Offset="1" />
          </RadialGradientBrush>
        </Rectangle.OpacityMask>
      </Rectangle>

      <Grid Margin="12" ctl:GlassPanel.Backdrop="{Binding ElementName=Ambient}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <ctl:GlassPanel x:Name="Rail" Width="200" Chamfer="{StaticResource Chamfer.Strip}" Padding="6,12,6,10"
                        Tint="{DynamicResource Color.Glass.Tint}"
                        BottomLine="{DynamicResource Brush.Strip.Bottom}"
                        LeadingEdge="{DynamicResource Brush.Strip.Edge}">
          <ctl:GlassPanel.Child>
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="10,2,6,10" Height="26">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <!-- The app's own mark, not a stand-in drawn from four borders: the rail is the first
                     thing the window shows, and it was still the old ring. It is painted through the
                     mark's alpha rather than shown as-is, so it takes the accent colour and stays
                     visible in the light palette, where the artwork's own silver would disappear. -->
                <Rectangle Width="20" Height="20" VerticalAlignment="Center"
                           Fill="{DynamicResource Brush.Accent}">
                  <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/optima-mark.png" Stretch="Uniform" />
                  </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Grid.Column="1" Text="Optima" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="11,0,0,0"
                           Visibility="{Binding RailCollapsed, Converter={StaticResource InverseBoolToVis}}" />
              </Grid>

              <Grid DockPanel.Dock="Bottom" Margin="6,8,2,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                  <Rectangle Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Rectangle.Style>
                      <Style TargetType="Rectangle">
                        <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Status.GameIsRunning}" Value="True">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Ok}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Rectangle.Style>
                  </Rectangle>
                  <TextBlock Visibility="{Binding RailCollapsed, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Micro}">
                        <Setter Property="Text" Value="idle" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Status.GameIsRunning}" Value="True">
                            <Setter Property="Text" Value="game running" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding ToggleRailCommand}"
                        ToolTip="Collapse or expand the rail (Alt+B)" Padding="6,4">
                  <ctl:Icon Symbol="{StaticResource Icon.Rail}" Size="15" Foreground="{DynamicResource Brush.TextMuted}" />
                </Button>
              </Grid>

              <Grid x:Name="NavArea" Margin="0,2,0,0">
              <!-- One marker for the whole rail, which glides to the row of the open page. -->
              <ctl:ChamferBorder x:Name="NavMarker" Chamfer="0" VerticalAlignment="Top" Height="0" Opacity="0"
                                 IsHitTestVisible="False"
                                 Background="{DynamicResource Brush.Nav.Active}"
                                 LeadingEdge="{DynamicResource Brush.Accent}">
                <ctl:ChamferBorder.RenderTransform>
                  <TranslateTransform x:Name="NavMarkerShift" />
                </ctl:ChamferBorder.RenderTransform>
              </ctl:ChamferBorder>
              <ItemsControl x:Name="NavList" ItemsSource="{Binding NavItems}" Loaded="OnNavListLoaded">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding SectionHeader}" Margin="12,10,0,4" Opacity="0.7">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Micro}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding SectionHeader}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding DataContext.RailCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Grid>
                        <Button Style="{StaticResource NavButton}"
                                Content="{Binding Label}" Tag="{Binding IconKey}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.NavigateCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Key}">
                          <Button.Visibility>
                            <MultiBinding Converter="{StaticResource NavItemVisibility}">
                              <Binding Path="Key" />
                              <Binding Path="DataContext.DeveloperModeVisible"
                                       RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                            </MultiBinding>
                          </Button.Visibility>
                        </Button>
                        <!-- How many things on the page want looking at. Over the row, not in it, so
                             it stays where it is when the rail is collapsed to icons. -->
                        <Border HorizontalAlignment="Right" MinWidth="17" Height="16" Padding="4,0" CornerRadius="8"
                                Background="{DynamicResource Brush.Fail}" IsHitTestVisible="False"
                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="VerticalAlignment" Value="Center" />
                              <Setter Property="Margin" Value="0,0,8,0" />
                              <Style.Triggers>
                                <!-- Collapsed, the row is barely wider than its icon: the count moves up
                                     into the corner instead of sitting on top of it. -->
                                <DataTrigger Binding="{Binding DataContext.RailCollapsed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                  <Setter Property="VerticalAlignment" Value="Top" />
                                  <Setter Property="Margin" Value="0,2,5,0" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding BadgeCount}" FontSize="{StaticResource Type.Micro}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Brush.Background}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </Grid>
            </DockPanel>
          </ctl:GlassPanel.Child>
        </ctl:GlassPanel>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
          </Grid.RowDefinitions>

          <ctl:TitleBar x:Name="Caption" Grid.Row="0"
                        Breadcrumb="{Binding Breadcrumb}"
                        SessionTag="{Binding Play.SessionTag}" />

          <!-- Account bar: always visible at the top of the page area. -->
          <Border Grid.Row="1" Height="30" Margin="0,2,0,0"
                  Background="{DynamicResource Brush.Surface}"
                  BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1"
                  CornerRadius="4">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                         Text="ACCOUNT" FontFamily="{StaticResource Font.Mono}"
                         FontSize="{StaticResource Type.Label}"
                         Foreground="{DynamicResource Brush.TextMuted}" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                        MinWidth="200" MaxWidth="360" Height="22" Margin="12,0,0,0"
                        FontSize="{StaticResource Type.Label}"
                        ItemsSource="{Binding SavedAccounts}"
                        SelectedItem="{Binding ActiveAccount, Mode=TwoWay}"
                        SelectionChanged="OnAccountSelectionChanged"
                        ToolTip="Switch the active player identity (saved in Settings, Player)">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding DisplayName}" />
                      <TextBlock Text="  [ACTIVE]" Foreground="{DynamicResource Brush.Accent}"
                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                      <!-- Takes the account off this list. Only in the open list (the closed box
                           shows the same template and is not the place for it), and not on the
                           "no other accounts" line, which is not an account. -->
                      <Button Content="&#x2715;" Padding="6,0" Margin="14,0,0,0" VerticalAlignment="Center"
                              ToolTip="Remove this account from the list. Add it again any time in Settings, Player."
                              Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                              CommandParameter="{Binding}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue={x:Null}}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Key}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center"
                         Style="{StaticResource Text.Micro}"
                         Foreground="{DynamicResource Brush.TextMuted}"
                         Text="switch identities from here · saved in Settings, Player" />
            </Grid>
          </Border>

          <ContentControl x:Name="PageHost" Grid.Row="2" Margin="0,4,0,0" />

          <!-- What Optima did by itself, and what it is about to do, said over whatever page is open. -->
          <ItemsControl Grid.Row="2" ItemsSource="{Binding Toasts.Toasts}" Focusable="False"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14" Width="400">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,8,0,0" Background="{DynamicResource Brush.Deep}" ctl:Flow.Arrive="14" ctl:Flow.Leave="{Binding Leaving}"
                        BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1">
                  <Border Padding="12,10" BorderThickness="2,0,0,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Info}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Kind}" Value="Ok">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ok}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Warn">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warn}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Value}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Micro}" TextWrapping="Wrap" Margin="0,4,0,0"
                                 Foreground="{DynamicResource Brush.TextSecondary}" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="{Binding ActionLabel}" Padding="6,0"
                                Command="{Binding ActionCommand}"
                                Visibility="{Binding ActionLabel, Converter={StaticResource EmptyToCollapsed}}" />
                        <Button Style="{StaticResource GhostButton}" Content="dismiss" Padding="6,0"
                                Command="{Binding DismissCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
