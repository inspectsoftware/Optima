<UserControl x:Class="Optima.App.Views.LogStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,1" Padding="22,7">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="level" Style="{StaticResource Text.Label}"
                   VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding SelectedLevel}"
                  Width="104" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="filter" Style="{StaticResource Text.Label}"
                   VerticalAlignment="Center" Margin="14,0,6,0" />
        <TextBox Grid.Column="3" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center" MaxWidth="360" HorizontalAlignment="Left" MinWidth="200"
                 ToolTip="Matches the message, the source and the exception, stack trace included" />

        <StackPanel Grid.Column="4" Orientation="Horizontal">
          <Button Style="{StaticResource GhostButton}" Content="open folder" Command="{Binding OpenLogFolderCommand}" />
          <Button Style="{StaticResource GhostButton}" Content="export" Command="{Binding ExportCommand}"
                  ToolTip="Every line with its date and whole exception, redacted" />
          <Button Style="{StaticResource GhostButton}" Content="clear" Command="{Binding ClearCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The log list owns the * row: a bounded viewport is what makes virtualization and its own
         scrollbar work. In an Auto row it would render every line and overflow the window. -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.Deep}">
      <ListBox x:Name="LogList" ItemsSource="{Binding FilteredView}"
               Background="Transparent" BorderThickness="0" Padding="16,8"
               SelectionChanged="OnSelectionChanged"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,1" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="66" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition />
                <ColumnDefinition Width="18" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding TimeText}" FontSize="{StaticResource Type.Micro}"
                         Foreground="{DynamicResource Brush.Hairline}" />
              <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="{StaticResource Type.Micro}"
                         Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
              <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="{StaticResource Type.Micro}"
                         Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="{StaticResource Type.Micro}"
                         Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" TextTrimming="None" />
              <!-- A line with an exception or an error code behind it: click the row to read it. -->
              <TextBlock Grid.Column="4" Text="+" FontSize="{StaticResource Type.Micro}" HorizontalAlignment="Right"
                         Foreground="{DynamicResource Brush.Accent}"
                         ToolTip="This line has more: click it for the full error"
                         Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Detail of the clicked line: everything the one-line row leaves out. Height-capped and
         scrolled inside its own pane, so a long stack trace never pushes the list off the window. -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,0" Padding="22,10,22,8"
            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Badge}" VerticalAlignment="Center"
                  BorderBrush="{Binding Selected.Level, Converter={StaticResource LogLevelBrush}}">
            <TextBlock Text="{Binding Selected.Level}" Style="{StaticResource Text.Badge}"
                       Foreground="{Binding Selected.Level, Converter={StaticResource LogLevelBrush}}" />
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding SelectedHeader}" Style="{StaticResource Text.Micro}"
                     Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Style="{StaticResource GhostButton}" Content="copy report" Command="{Binding CopySelectedCommand}"
                    ToolTip="Copies this line with its full error, the guide's entry for it and the lines before it, redacted. This is what to send when reporting a problem." />
            <Button Style="{StaticResource GhostButton}" Content="close" Command="{Binding CloseDetailCommand}" />
          </StackPanel>
        </Grid>

        <ScrollViewer x:Name="DetailScroll" Grid.Row="1" MaxHeight="230" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
          <StackPanel>
            <TextBox Text="{Binding SelectedMessage, Mode=OneWay}" Style="{StaticResource SelectableText}" />
            <TextBox Text="{Binding SelectedNativeText, Mode=OneWay}" Style="{StaticResource SelectableText}"
                     Foreground="{DynamicResource Brush.Warn}" Margin="0,4,0,0"
                     Visibility="{Binding SelectedNativeText, Converter={StaticResource EmptyToCollapsed}}" />

            <!-- The error guide's entry for the line's code, so the fix sits next to the failure. -->
            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding SelectedGuide, Converter={StaticResource NullToCollapsed}}">
              <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource Brush.Deep}" BorderBrush="{DynamicResource Brush.Hairline}"
                        BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedGuide.Code}" FontSize="{StaticResource Type.Micro}"
                             Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <TextBlock Text="{Binding SelectedGuide.Title}" Style="{StaticResource Text.Label}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBox Text="{Binding SelectedGuide.WhatHappened, Mode=OneWay}" Style="{StaticResource SelectableText}"
                       Margin="0,6,0,0" />
              <TextBox Text="{Binding SelectedGuide.WhyItHappens, Mode=OneWay, StringFormat='Why: {0}'}"
                       Style="{StaticResource SelectableText}" Margin="0,4,0,0" />
              <TextBlock Text="HOW TO FIX" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.Accent}"
                         Margin="0,6,0,2" />
              <ItemsControl ItemsSource="{Binding SelectedGuide.HowToFix}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBox Text="{Binding Mode=OneWay, StringFormat='- {0}'}" Style="{StaticResource SelectableText}"
                             Margin="0,1,0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding SelectedExceptionText, Converter={StaticResource EmptyToCollapsed}}">
              <TextBlock Text="EXCEPTION" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.Accent}" />
              <TextBox Text="{Binding SelectedExceptionText, Mode=OneWay}" Style="{StaticResource SelectableText}"
                       FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding SelectedArgumentsText, Converter={StaticResource EmptyToCollapsed}}">
              <TextBlock Text="ARGUMENTS" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.Accent}" />
              <TextBox Text="{Binding SelectedArgumentsText, Mode=OneWay}" Style="{StaticResource SelectableText}"
                       FontFamily="{StaticResource Font.Mono}" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,0" Padding="22,6">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Micro}" />
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Micro}"
                     Foreground="{DynamicResource Brush.Ok}" Margin="14,0,0,0" />
        </StackPanel>
        <CheckBox HorizontalAlignment="Right" IsChecked="{Binding TailEnabled}"
                  Content="TAIL" FontSize="{StaticResource Type.Micro}"
                  ToolTip="Follow new log entries as they arrive. Paused while a line's detail is open." />
      </Grid>
    </Border>
  </Grid>
</UserControl>
