<Window x:Class="Optima.App.Views.DiscordLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Optima.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Optima"
        Width="640" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0"
                        CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border Background="{DynamicResource Brush.Background}"
          TextElement.Foreground="{DynamicResource Brush.Text}"
          TextElement.FontFamily="{StaticResource Font.Body}"
          TextElement.FontSize="{StaticResource Type.Body}">
    <Grid>
      <ctl:AmbientField x:Name="Ambient" />
      <Grid Margin="12" ctl:GlassPanel.Backdrop="{Binding ElementName=Ambient}">
        <Grid.RowDefinitions>
          <RowDefinition Height="28" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ctl:TitleBar Grid.Row="0" ShowMinimize="False" ShowMaximize="False" Breadcrumb="OPTIMA · LINK DISCORD" />

        <ctl:GlassPanel Grid.Row="1" Chamfer="{StaticResource Chamfer.Strip}" Padding="20,16,20,16"
                        Tint="{DynamicResource Color.Glass.Tint}"
                        TopLine="{DynamicResource Brush.Strip.Top}"
                        BottomLine="{DynamicResource Brush.Strip.Bottom}"
                        LeadingEdge="{DynamicResource Brush.Strip.Edge}">
          <ctl:GlassPanel.Child>
            <StackPanel>
              <TextBlock Text="Link your Critical Ops account" FontSize="{StaticResource Type.Title}" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Text.Micro}" Margin="0,6,0,0" TextWrapping="Wrap"
                         Text="In Discord, run /link with OptimaBot. It answers with a code that works once, for a few minutes; type that code here and Optima binds the Critical Ops account it already tracks to your Discord account. The bot never sees your Discord password, and Discord never sees your game account." />

              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="link code" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                <TextBox x:Name="CodeBox" Grid.Column="1" Margin="12,0,0,0" MaxLength="12"
                         CharacterCasing="Upper" FontFamily="{StaticResource Font.Mono}"
                         ToolTip="The code /link sent you, like OPT-7F3KQ" />
              </Grid>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="tracker" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                <TextBlock x:Name="TrackerText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Text.Micro}" TextWrapping="Wrap" />
              </Grid>

              <TextBlock x:Name="IdentityText" Style="{StaticResource Text.Micro}" Margin="0,10,0,0" TextWrapping="Wrap" />

              <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource Brush.Accent}" />

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CopyButton" Content="copy code from Discord" Style="{StaticResource GhostButton}"
                        MinWidth="180" Margin="0,0,8,0" Visibility="Collapsed" Click="OnOpenDiscord"
                        ToolTip="Opens the Optima Discord server, where /link answers" />
                <Button Content="Close" Style="{StaticResource GhostButton}" MinWidth="90" Margin="0,0,8,0"
                        IsCancel="True" />
                <Button x:Name="LinkButton" Content="Link account" Style="{StaticResource PrimaryButton}" MinWidth="160"
                        IsDefault="True" Click="OnLink" />
              </StackPanel>
            </StackPanel>
          </ctl:GlassPanel.Child>
        </ctl:GlassPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
