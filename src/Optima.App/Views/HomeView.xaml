<UserControl x:Class="Optima.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Optima.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRoot}" MaxWidth="1010" HorizontalAlignment="Left">

      <TextBlock Text="Critical Ops" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Google Play Games · custom bootstrapper" Style="{StaticResource Text.PageSubtitle}" />

      <!-- STATUS / SYSTEM side by side -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <HeaderedContentControl Style="{StaticResource Section}" Header="STATUS">
          <HeaderedContentControl.Tag>
            <Button Style="{StaticResource GhostButton}" Content="refresh"
                    Command="{Binding Status.RefreshCommand}" Padding="6,0" />
          </HeaderedContentControl.Tag>
          <StackPanel>
            <ContentControl Content="{Binding Status.GooglePlayGames}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            <ContentControl Content="{Binding Status.CriticalOps}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            <ContentControl Content="{Binding Status.VirtualDisplay}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            <ContentControl Content="{Binding Status.Virtualization}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            <ContentControl Content="{Binding Status.Display}" ContentTemplate="{StaticResource StatusItemTemplate}" />
          </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Grid.Column="2" Style="{StaticResource Section}" Header="SYSTEM">
          <StackPanel>
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="16" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="GPU" Style="{StaticResource Text.Label}" />
              <Rectangle Grid.Column="1" Style="{StaticResource Leader}" />
              <TextBlock Grid.Column="2" Text="{Binding GpuText}" Style="{StaticResource Text.Value}" MaxWidth="330" />
            </Grid>
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="16" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="CPU" Style="{StaticResource Text.Label}" />
              <Rectangle Grid.Column="1" Style="{StaticResource Leader}" />
              <TextBlock Grid.Column="2" Text="{Binding CpuText}" Style="{StaticResource Text.Value}" MaxWidth="330" />
            </Grid>
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="16" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="RAM" Style="{StaticResource Text.Label}" />
              <Rectangle Grid.Column="1" Style="{StaticResource Leader}" />
              <TextBlock Grid.Column="2" Text="{Binding RamText}" Style="{StaticResource Text.Value}" MaxWidth="330" />
            </Grid>
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="16" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="OS" Style="{StaticResource Text.Label}" />
              <Rectangle Grid.Column="1" Style="{StaticResource Leader}" />
              <TextBlock Grid.Column="2" Text="{Binding WindowsText}" Style="{StaticResource Text.Value}" MaxWidth="330" />
            </Grid>
          </StackPanel>
        </HeaderedContentControl>
      </Grid>

      <!-- Live meters -->
      <HeaderedContentControl Style="{StaticResource Section}" Header="PERFORMANCE">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition /><RowDefinition />
          </Grid.RowDefinitions>

          <!-- CPU -->
          <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="CPU" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
            <ctl:AsciiBar Grid.Column="1" Value="{Binding CpuPercent}" Maximum="100" Cells="18" />
            <TextBlock Grid.Column="2" Text="{Binding CpuUsage}" Style="{StaticResource Text.Value}" Margin="10,0,0,0" MinWidth="46" VerticalAlignment="Center" />
          </Grid>
          <!-- GPU -->
          <Grid Grid.Column="2" Margin="0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="GPU" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
            <ctl:AsciiBar Grid.Column="1" Value="{Binding GpuPercent}" Maximum="100" Cells="18" />
            <TextBlock Grid.Column="2" Text="{Binding GpuUsage}" Style="{StaticResource Text.Value}" Margin="10,0,0,0" MinWidth="46" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding GpuTempText}" Style="{StaticResource Text.Micro}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <!-- RAM -->
          <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="RAM" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
            <ctl:AsciiBar Grid.Row="0" Grid.Column="1" Value="{Binding RamPercent}" Maximum="100" Cells="18" />
            <TextBlock Grid.Column="2" Text="{Binding RamUsage}" Style="{StaticResource Text.Value}" Margin="10,0,0,0" MinWidth="46" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </HeaderedContentControl>

      <!-- Primary action -->
      <HeaderedContentControl Style="{StaticResource Section}" Header="LAUNCH">
        <HeaderedContentControl.Tag>
          <Button Style="{StaticResource GhostButton}" Content="kill game" Padding="6,0"
                  Command="{Binding Play.KillGameCommand}"
                  ToolTip="Instantly terminates the Critical Ops emulator process tree (Ctrl+Alt+K works anywhere)" />
        </HeaderedContentControl.Tag>
        <Border Style="{StaticResource Callout}" Padding="16,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Play.SelectedProfile.Name, FallbackValue='NO PROFILE'}"
                         FontSize="{StaticResource Type.Title}" Foreground="{DynamicResource Brush.Accent}" />
              <TextBlock Text="{Binding Play.SelectedProfileSummary}" Style="{StaticResource Text.Label}"
                         Margin="0,4,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                          Visibility="{Binding Play.IsSessionActive, Converter={StaticResource BoolToVis}}">
                <ctl:AsciiSpinner Cells="12" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Play.PhaseText}" Style="{StaticResource Text.Micro}"
                           Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Play.KillStatusText}" Style="{StaticResource Text.Micro}"
                         Foreground="{DynamicResource Brush.Warn}" Margin="0,6,0,0"
                         Visibility="{Binding Play.KillStatusText, Converter={StaticResource EmptyToCollapsed}}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                    Content="{Binding Play.PlayButtonText}"
                    Command="{Binding Play.PlayCommand}" MinWidth="270" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </HeaderedContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
