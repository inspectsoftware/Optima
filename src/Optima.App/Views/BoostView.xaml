<UserControl x:Class="Optima.App.Views.BoostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Optima.App.Controls">
  <UserControl.Resources>
    <!-- Boost's energy: molten amber, the same in both themes because it reads on either ground. -->
    <LinearGradientBrush x:Key="Boost.Molten" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FFE8B45A" Offset="0" />
      <GradientStop Color="#FFFF7A1A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Boost.MoltenUp" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFB347" Offset="0" />
      <GradientStop Color="#FFB8862B" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Boost.Hot" Color="#FFFF9A3C" />
    <SolidColorBrush x:Key="Boost.HotWash" Color="#14FFB347" />
    <SolidColorBrush x:Key="Boost.OnMolten" Color="#FF16130B" />
    <!-- Held back by Boost: grey diagonal hatch. -->
    <DrawingBrush x:Key="Boost.Hatch" TileMode="Tile" Stretch="None"
                  Viewport="0,0,8,8" ViewportUnits="Absolute" Viewbox="0,0,8,8" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#33AAB2BA" Geometry="M0,0 H8 V8 H0 Z" />
          <GeometryDrawing Brush="#CCAAB2BA" Geometry="M0,8 L8,0 V3 L3,8 Z M0,3 L3,0 H0 Z M5,8 L8,5 V8 Z" />
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="Boost.Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Boost.Well" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Field}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Height" Value="104" />
      <Setter Property="Margin" Value="0,12,0,0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style x:Key="Boost.Kicker" TargetType="TextBlock" BasedOn="{StaticResource Text.Micro}">
      <Setter Property="FontSize" Value="{StaticResource Type.Label}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Boost.Detail" TargetType="TextBlock" BasedOn="{StaticResource Text.Prose}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="17" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style x:Key="Boost.Foot" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="0,10,0,0" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style x:Key="Boost.Name" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A boost's state: filled while it is doing something, outlined while it waits, grey when off. -->
    <Style x:Key="Boost.Pill" TargetType="Label">
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Label">
            <Border x:Name="Pill" Padding="7,2,7,3" BorderThickness="1" BorderBrush="{DynamicResource Brush.Accent}" SnapsToDevicePixels="True">
              <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Style="{StaticResource Text.Badge}"
                         Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Content" Value="OFF">
                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Brush.HairlineStrong}" />
                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
              </Trigger>
              <Trigger Property="Content" Value="HOLDING">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Boost.Hot}" />
                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Boost.Hot}" />
                <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Boost.OnMolten}" />
              </Trigger>
              <Trigger Property="Content" Value="RUNNING">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Boost.Hot}" />
                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Boost.Hot}" />
                <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Boost.OnMolten}" />
              </Trigger>
              <Trigger Property="Content" Value="ACTIVE">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Boost.Hot}" />
                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Boost.Hot}" />
                <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Boost.OnMolten}" />
              </Trigger>
              <Trigger Property="Content" Value="WATCHING">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Boost.Hot}" />
                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Boost.Hot}" />
                <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Boost.OnMolten}" />
              </Trigger>
              <Trigger Property="Content" Value="AWAKE">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Boost.Hot}" />
                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Boost.Hot}" />
                <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Boost.OnMolten}" />
              </Trigger>
              <Trigger Property="Content" Value="SET">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Boost.Hot}" />
                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Boost.Hot}" />
                <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Boost.OnMolten}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A part's label, shown only where it fits whole: one that is too wide wraps past the one-pixel
         spacer onto a second line, and the panel's height cuts that line off. -->
    <DataTemplate x:Key="Boost.PartLabel">
      <WrapPanel Height="20" ClipToBounds="True" Margin="7,0,0,0">
        <Rectangle Width="1" Height="20" />
        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Font.Mono}" FontSize="{StaticResource Type.Micro}"
                   VerticalAlignment="Center" Margin="0,0,6,0" />
      </WrapPanel>
    </DataTemplate>

    <!-- A stacked resource bar; the columns are the shares, so the parts always fill the bar exactly. -->
    <DataTemplate x:Key="Boost.FlowBar">
      <Border Background="{DynamicResource Brush.Field}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1" Padding="2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Game.Width}" />
            <ColumnDefinition Width="{Binding HeldBack.Width}" />
            <ColumnDefinition Width="{Binding Other.Width}" />
            <ColumnDefinition Width="{Binding Standby.Width}" />
            <ColumnDefinition Width="{Binding Freed.Width}" />
            <ColumnDefinition Width="{Binding Idle.Width}" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource Boost.Molten}" Margin="0,0,2,0">
            <ContentControl Content="{Binding Game}" ContentTemplate="{StaticResource Boost.PartLabel}" Focusable="False"
                            FontWeight="SemiBold" Foreground="{StaticResource Boost.OnMolten}" />
          </Border>
          <Border Grid.Column="1" Background="{StaticResource Boost.Hatch}" Margin="0,0,2,0">
            <ContentControl Content="{Binding HeldBack}" ContentTemplate="{StaticResource Boost.PartLabel}" Focusable="False"
                            FontWeight="SemiBold" Foreground="{StaticResource Boost.OnMolten}" />
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource Brush.HairlineStrong}" Margin="0,0,2,0">
            <ContentControl Content="{Binding Other}" ContentTemplate="{StaticResource Boost.PartLabel}" Focusable="False"
                            Foreground="{DynamicResource Brush.TextSecondary}" />
          </Border>
          <Border Grid.Column="3" Background="{DynamicResource Brush.Hairline}" Margin="0,0,2,0">
            <ContentControl Content="{Binding Standby}" ContentTemplate="{StaticResource Boost.PartLabel}" Focusable="False"
                            Foreground="{DynamicResource Brush.TextSecondary}" />
          </Border>
          <Border Grid.Column="4" Background="{DynamicResource Brush.Ok}" Margin="0,0,2,0">
            <ContentControl Content="{Binding Freed}" ContentTemplate="{StaticResource Boost.PartLabel}" Focusable="False"
                            FontWeight="SemiBold" Foreground="{DynamicResource Brush.Background}" />
          </Border>
          <Border Grid.Column="5" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1">
            <ContentControl Content="{Binding Idle}" ContentTemplate="{StaticResource Boost.PartLabel}" Focusable="False"
                            Foreground="{DynamicResource Brush.TextMuted}" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- The same bar without its labels, for the memory cleaner's card. -->
    <DataTemplate x:Key="Boost.FlowBarPlain">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding Game.Width}" />
          <ColumnDefinition Width="{Binding HeldBack.Width}" />
          <ColumnDefinition Width="{Binding Other.Width}" />
          <ColumnDefinition Width="{Binding Standby.Width}" />
          <ColumnDefinition Width="{Binding Freed.Width}" />
          <ColumnDefinition Width="{Binding Idle.Width}" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Boost.Molten}" Margin="0,0,2,0" />
        <Border Grid.Column="2" Background="{DynamicResource Brush.HairlineStrong}" Margin="0,0,2,0" />
        <Border Grid.Column="3" Background="{DynamicResource Brush.TextMuted}" Opacity="0.55" Margin="0,0,2,0" />
        <Border Grid.Column="4" Background="{DynamicResource Brush.Ok}" Margin="0,0,2,0" />
        <Border Grid.Column="5" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1" />
      </Grid>
    </DataTemplate>

    <!-- One tick of a timer comb; the brush's viewport sets the spacing. -->
    <GeometryDrawing x:Key="Boost.CombTick" Brush="Black" Geometry="M0,0 H0.3 V1 H0 Z" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!-- A column that takes the whole width up to its maximum and stays on the left: the page is
         made of bars and grids that should fill it, not shrink to their text. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="1168" />
      </Grid.ColumnDefinitions>
      <StackPanel Style="{StaticResource PageRoot}">

        <!-- Header with the live status. -->
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Boost" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Style="{StaticResource Text.PageSubtitle}" Margin="0,4,16,0" TextWrapping="Wrap" TextTrimming="None"
                       Text="Every boost, live: what it holds, what it frees, and what it keeps out of the game's way" />
          </StackPanel>
          <Border Grid.Column="1" VerticalAlignment="Bottom" Padding="14,9" Background="{DynamicResource Brush.Surface}"
                  BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource Brush.HairlineStrong}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding BoostPhase}" Value="ARMED">
                        <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding BoostPhase}" Value="ENGAGED">
                        <Setter Property="Fill" Value="{StaticResource Boost.Hot}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding HeaderStatusText}" Style="{StaticResource Text.Value}" Margin="10,0,0,0"
                         Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Hero: the master dial and the six numbers. The view puts the numbers under the dial when
             the two do not fit side by side. -->
        <Grid x:Name="Hero" Margin="0,0,0,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="520*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border x:Name="DialPanel" Style="{StaticResource Boost.Card}" Padding="20,30,20,22" ClipToBounds="True">
            <Grid>
              <Border Margin="-20,-30,-20,-22" IsHitTestVisible="False">
                <Border.Background>
                  <RadialGradientBrush Center="0.5,0.44" GradientOrigin="0.5,0.44" RadiusX="0.6" RadiusY="0.55">
                    <GradientStop Color="#24FF8C28" Offset="0" />
                    <GradientStop Color="#00FF8C28" Offset="1" />
                  </RadialGradientBrush>
                </Border.Background>
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding BoostOn}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>
              <StackPanel HorizontalAlignment="Center">
                <ctl:BoostDial Width="380" Height="380"
                               IsOn="{Binding BoostOn, Mode=OneWay}"
                               IsEngaged="{Binding BoostEngaged, Mode=OneWay}"
                               FeatureCount="{Binding BoostFeatureCount, Mode=OneWay}"
                               ArmedMask="{Binding ArmedMask, Mode=OneWay}"
                               Command="{Binding ToggleBoostCommand}"
                               AutomationProperties.Name="Boost master switch" />
                <TextBlock Style="{StaticResource Text.Micro}" Margin="0,18,0,0" MaxWidth="380" LineHeight="17"
                           TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None">
                  <Run Text="{Binding BoostSummaryText, Mode=OneWay}" /><Run Text=" · runs only while Critical Ops is on screen · off again every time Optima starts" />
                </TextBlock>
              </StackPanel>
            </Grid>
          </Border>

          <ItemsControl x:Name="TileGrid" Grid.Column="2" Margin="-6" Tag="2" ItemsSource="{Binding Tiles}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Boost.Card}" Margin="6" Padding="0" ClipToBounds="True">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Edge" Background="{DynamicResource Brush.Hairline}" />
                    <DockPanel Grid.Column="1" Margin="14,14,16,14">
                      <DockPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="LiveMark" DockPanel.Dock="Right" Text="LIVE" Style="{StaticResource Text.Micro}"
                                   Foreground="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                        <TextBlock Text="{Binding Kicker}" Style="{StaticResource Text.Micro}" />
                      </DockPanel>
                      <ProgressBar DockPanel.Dock="Bottom" Value="{Binding Bar, Mode=OneWay}" Maximum="100" Margin="0,10,0,0"
                                   Background="{DynamicResource Brush.Hairline}" Foreground="{StaticResource Boost.Molten}" />
                      <StackPanel>
                      <TextBlock Margin="0,6,0,0">
                        <Run x:Name="Value" Text="{Binding Value, Mode=OneWay}" FontFamily="{StaticResource Font.Body}" FontSize="30" FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.TextMuted}" />
                        <Run Text="{Binding Unit, Mode=OneWay}" FontFamily="{StaticResource Font.Body}" FontSize="13"
                             Foreground="{DynamicResource Brush.TextSecondary}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Line}" Style="{StaticResource Text.Prose}" FontSize="12" LineHeight="16" Margin="0,2,0,0" />
                      </StackPanel>
                    </DockPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Live}" Value="True">
                    <Setter TargetName="Edge" Property="Background" Value="{StaticResource Boost.MoltenUp}" />
                    <Setter TargetName="LiveMark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <!-- Resource flow: where the processor and memory go right now. -->
        <Border Style="{StaticResource Boost.Card}" Padding="20" Margin="0,0,0,22">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="RESOURCE FLOW" Style="{StaticResource Boost.Kicker}" Margin="0,0,18,0" />
              <TextBlock Style="{StaticResource Text.Label}" HorizontalAlignment="Right" TextWrapping="Wrap" TextTrimming="None"
                         Text="Where the processor and memory go right now. Hatched is held back by Boost, green is what it freed." />
            </DockPanel>
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="176" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="14" />
                <RowDefinition Height="30" />
              </Grid.RowDefinitions>
              <TextBlock Text="Processor" Style="{StaticResource Text.Value}" VerticalAlignment="Center" />
              <ContentControl Grid.Column="1" Content="{Binding ProcessorFlow}" ContentTemplate="{StaticResource Boost.FlowBar}" Focusable="False" />
              <TextBlock Grid.Column="2" Text="{Binding ProcessorFlow.Note}" Style="{StaticResource Text.Micro}" FontSize="11.5"
                         Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              <TextBlock Grid.Row="2" Text="Memory" Style="{StaticResource Text.Value}" VerticalAlignment="Center" />
              <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding MemoryFlow}" ContentTemplate="{StaticResource Boost.FlowBar}" Focusable="False" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MemoryFlow.Note}" Style="{StaticResource Text.Micro}" FontSize="11.5"
                         Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <WrapPanel Margin="0,16,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                <Border Width="10" Height="10" Background="{StaticResource Boost.Molten}" />
                <TextBlock Text="Critical Ops" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="6,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                <Border Width="10" Height="10" Background="{StaticResource Boost.Hatch}" />
                <TextBlock Text="held back by Boost" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="6,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                <Border Width="10" Height="10" Background="{DynamicResource Brush.HairlineStrong}" />
                <TextBlock Text="Windows and other apps" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="6,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                <Border Width="10" Height="10" Background="{DynamicResource Brush.Hairline}" />
                <TextBlock Text="standby cache" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="6,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                <Border Width="10" Height="10" Background="{DynamicResource Brush.Ok}" />
                <TextBlock Text="freed by Boost's last purge" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="6,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                <Border Width="10" Height="10" BorderBrush="{DynamicResource Brush.HairlineStrong}" BorderThickness="1" />
                <TextBlock Text="idle or free" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="6,0,0,0" />
              </StackPanel>
            </WrapPanel>
            <DockPanel Margin="0,14,0,6">
              <TextBlock DockPanel.Dock="Right" Text="{Binding GameShareText}" Style="{StaticResource Text.Micro}" />
              <TextBlock Text="GAME SHARE OF THE PROCESSOR · LAST 60 S" Style="{StaticResource Text.Micro}" />
            </DockPanel>
            <Border Height="56" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1">
              <ctl:Sparkline Values="{Binding GameShareHistory}" Minimum="0" Stroke="{StaticResource Boost.Hot}" />
            </Border>
          </StackPanel>
        </Border>

        <!-- The six boosts. -->
        <DockPanel Margin="0,0,0,12">
          <TextBlock Text="THE SIX BOOSTS · ONE GEAR EACH" Style="{StaticResource Boost.Kicker}" Margin="0,0,18,0" />
          <TextBlock Style="{StaticResource Text.Label}" HorizontalAlignment="Right" TextWrapping="Wrap" TextTrimming="None"
                     Text="Tick what the master switch drives. Each one reports what it is doing this second." />
        </DockPanel>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- 01 Priority guard -->
          <Border Style="{StaticResource Boost.Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="01" Style="{StaticResource Text.Micro}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding PriorityGuardEnabled}"
                          AutomationProperties.Name="Priority guard" Margin="10,0,0,0" />
                <Label DockPanel.Dock="Right" Style="{StaticResource Boost.Pill}" Content="{Binding GuardStateText}" />
                <TextBlock Text="Priority guard" Style="{StaticResource Boost.Name}" />
              </DockPanel>
              <Border Style="{StaticResource Boost.Well}">
                <ItemsControl ItemsSource="{Binding Rungs}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="4,0">
                        <TextBlock x:Name="Label" DockPanel.Dock="Bottom" Text="{Binding Name}" Style="{StaticResource Text.Micro}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <Border x:Name="Bar" Height="{Binding Height}" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Hairline}" />
                      </DockPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Chosen}" Value="True">
                          <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.AccentGlow}" />
                          <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Lit}" Value="True">
                          <Setter TargetName="Bar" Property="Background" Value="{StaticResource Boost.MoltenUp}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <TextBlock Text="{Binding GuardDetailText}" Style="{StaticResource Boost.Detail}" />
              <Border Style="{StaticResource Boost.Foot}">
                <TextBlock Style="{StaticResource Text.Micro}" TextWrapping="Wrap" TextTrimming="None"
                           Text="checks every 10 s · the original priority comes back on exit" />
              </Border>
              <Expander Header="settings" Margin="0,8,0,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="game priority" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <ComboBox ItemsSource="{Binding GamePriorityOptions}" SelectedItem="{Binding GamePriority}"
                              Width="180" HorizontalAlignment="Left" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource Text.Micro}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None"
                             Text="CPU priority for the Google Play Games process that runs Critical Ops. The guard looks every ten seconds: a game opened without Optima, an emulator that restarted and a priority another program lowered are all put right. Unchanged leaves the choice to the launch profile; a session started with PLAY applies it even with the guard off. The original priority is put back when the guard is switched off or Optima closes. High is the ceiling on purpose; Realtime can starve Windows itself." />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <!-- 02 Memory cleaner -->
          <Border Grid.Column="2" Style="{StaticResource Boost.Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="02" Style="{StaticResource Text.Micro}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding CleanerEnabled}"
                          AutomationProperties.Name="Memory cleaner" Margin="10,0,0,0" />
                <Label DockPanel.Dock="Right" Style="{StaticResource Boost.Pill}" Content="{Binding CleanerStateText}" />
                <TextBlock Text="Memory cleaner" Style="{StaticResource Boost.Name}" />
              </DockPanel>
              <Border Style="{StaticResource Boost.Well}">
                <StackPanel>
                  <ContentControl Height="22" Content="{Binding MemoryFlow}" ContentTemplate="{StaticResource Boost.FlowBarPlain}" Focusable="False" />
                  <Grid Margin="0,8,0,0">
                    <TextBlock Text="in use" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Text="{Binding CleanerStandbyText}" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.TextSecondary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CleanerFreeText}" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.TextSecondary}"
                               HorizontalAlignment="Right" />
                  </Grid>
                  <Grid Height="24" Margin="0,6,0,0">
                    <Rectangle Height="1" VerticalAlignment="Top" Stroke="{DynamicResource Brush.Hairline}" StrokeDashArray="3 3" SnapsToDevicePixels="True" />
                    <ItemsControl ItemsSource="{Binding PurgeTicks}" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Grid />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="{Binding Before}" />
                              <ColumnDefinition Width="{Binding After}" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="1" Width="2" Height="10" Margin="-1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Fill="{DynamicResource Brush.Ok}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="purges · last 30 min" Style="{StaticResource Text.Micro}" FontSize="10"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding CleanerDetailText}" Style="{StaticResource Boost.Detail}" />
              <Border Style="{StaticResource Boost.Foot}">
                <TextBlock Style="{StaticResource Text.Micro}" TextWrapping="Wrap" TextTrimming="None">
                  <Run Text="free below" />
                  <Run Text="{Binding CleanerFreeBelowMb, Mode=OneWay}" /><Run Text=" MB and standby above" />
                  <Run Text="{Binding CleanerStandbyAboveMb, Mode=OneWay}" /><Run Text=" MB · purge now works any time" />
                </TextBlock>
              </Border>
              <Expander Header="settings" Margin="0,8,0,0">
                <StackPanel>
                  <WrapPanel>
                    <TextBlock Text="when free memory is below" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,6">
                      <TextBox Text="{Binding CleanerFreeBelowMb}" Width="80" />
                      <TextBlock Text="MB" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="and the standby list is above" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,10,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                      <TextBox Text="{Binding CleanerStandbyAboveMb}" Width="80" />
                      <TextBlock Text="MB" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                  </WrapPanel>
                  <TextBlock Text="{Binding CleanerMemoryText}" Style="{StaticResource Text.Value}" Margin="0,6,0,0"
                             Visibility="{Binding CleanerMemoryText, Converter={StaticResource EmptyToCollapsed}}" />
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="purge now" Command="{Binding PurgeNowCommand}"
                            IsEnabled="{Binding CleanerBusy, Converter={StaticResource InverseBool}}" />
                    <Button Style="{StaticResource SecondaryButton}" Content="start the helper" Command="{Binding StartHelperCommand}" Margin="10,0,0,0"
                            Visibility="{Binding CleanerNeedsHelper, Converter={StaticResource BoolToVis}}"
                            IsEnabled="{Binding CleanerBusy, Converter={StaticResource InverseBool}}" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource Text.Micro}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None"
                             Text="Windows keeps recently used files in memory (the standby list) and normally hands that memory back on demand. On some systems it does so late, and the game stutters while it waits. The cleaner empties the list only when both conditions hold, which is what ISLC does; 1024 and 1024 are ISLC's defaults. It works on Windows' own cache, never on the game's memory, and a purge cannot be undone: Windows simply refills the cache as files are read again. It needs Optima's elevated helper, so switching it on, PLAY and purge now may each show one administrator prompt per Optima run. The cleaner never asks for it for a game opened without Optima (Auto-attach may ask once, for the virtual display); the page says when the helper is missing." />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <!-- 03 Timer resolution -->
          <Border Grid.Row="2" Style="{StaticResource Boost.Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="03" Style="{StaticResource Text.Micro}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding TimerEnabled}"
                          AutomationProperties.Name="Timer resolution" Margin="10,0,0,0" />
                <Label DockPanel.Dock="Right" Style="{StaticResource Boost.Pill}" Content="{Binding TimerStateText}" />
                <TextBlock Text="Timer resolution" Style="{StaticResource Boost.Name}" />
              </DockPanel>
              <Border Style="{StaticResource Boost.Well}">
                <StackPanel VerticalAlignment="Center">
                  <DockPanel>
                    <TextBlock Width="104" Text="Windows 15.6 ms" Style="{StaticResource Text.Micro}" VerticalAlignment="Center" />
                    <Rectangle Height="18" Fill="{DynamicResource Brush.TextMuted}">
                      <Rectangle.OpacityMask>
                        <DrawingBrush TileMode="Tile" Stretch="Fill" Viewport="0,0,0.15625,1" ViewportUnits="RelativeToBoundingBox"
                                      Viewbox="0,0,15.625,1" ViewboxUnits="Absolute" Drawing="{StaticResource Boost.CombTick}" />
                      </Rectangle.OpacityMask>
                    </Rectangle>
                  </DockPanel>
                  <DockPanel Margin="0,12,0,0">
                    <TextBlock Width="104" Text="{Binding TimerHeldText}" Style="{StaticResource Text.Micro}" VerticalAlignment="Center" />
                    <Rectangle Height="18">
                      <Rectangle.OpacityMask>
                        <DrawingBrush TileMode="Tile" Stretch="Fill" Viewport="{Binding TimerHeldTick}" ViewportUnits="RelativeToBoundingBox"
                                      Viewbox="{Binding TimerHeldBox}" ViewboxUnits="Absolute" Drawing="{StaticResource Boost.CombTick}" />
                      </Rectangle.OpacityMask>
                      <Rectangle.Style>
                        <Style TargetType="Rectangle">
                          <Setter Property="Fill" Value="{DynamicResource Brush.HairlineStrong}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding TimerHeldLive}" Value="True">
                              <Setter Property="Fill" Value="{StaticResource Boost.Hot}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Rectangle.Style>
                    </Rectangle>
                  </DockPanel>
                  <TextBlock Text="both combs span 100 ms" Style="{StaticResource Text.Micro}" FontSize="10" HorizontalAlignment="Right" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding TimerDetailText}" Style="{StaticResource Boost.Detail}" />
              <Border Style="{StaticResource Boost.Foot}">
                <TextBlock Style="{StaticResource Text.Micro}" TextWrapping="Wrap" TextTrimming="None"
                           Text="held only while the game is on screen · released the moment it leaves" />
              </Border>
              <Expander Header="settings" Margin="0,8,0,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="resolution" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <ComboBox ItemsSource="{Binding TimerChoices}" SelectedItem="{Binding TimerChoice}" Width="100" HorizontalAlignment="Left" />
                    <TextBlock Text="ms" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="10,0,0,0" />
                  </StackPanel>
                  <TextBlock Text="{Binding TimerWindowsText}" Style="{StaticResource Text.Label}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None" />
                  <StackPanel Margin="0,10,0,0" Visibility="{Binding TimerGlobalSwitchAvailable, Converter={StaticResource BoolToVis}}">
                    <CheckBox IsChecked="{Binding TimerGlobalSwitchOn}" Content="system-wide timer requests" />
                    <TextBlock Text="Windows 11 · administrator · needs a restart" Style="{StaticResource Text.Micro}" Margin="25,2,0,0" />
                    <TextBlock Text="{Binding TimerGlobalSwitchText}" Style="{StaticResource Text.Micro}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                               Visibility="{Binding TimerGlobalSwitchText, Converter={StaticResource EmptyToCollapsed}}" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource Text.Micro}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None"
                             Text="Windows wakes sleeping threads on a tick, 15.6 ms apart by default. A finer tick makes frame pacing and input timing more even, at the cost of some battery life, so it is held only while the game is on screen and released when it leaves. The card reports what Windows applied, not what was asked for. 1.0 ms is the documented step; 0.5 ms uses the same system call other timer tools use. Lower is not always better: if 0.5 ms feels no different, stay on 1.0." />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <!-- 04 Background programs -->
          <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Boost.Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="04" Style="{StaticResource Text.Micro}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding DemotionEnabled}"
                          AutomationProperties.Name="Background programs" Margin="10,0,0,0" />
                <Label DockPanel.Dock="Right" Style="{StaticResource Boost.Pill}" Content="{Binding DemotionStateText}" />
                <TextBlock Text="Background programs" Style="{StaticResource Boost.Name}" />
              </DockPanel>
              <Border Style="{StaticResource Boost.Well}">
                <Grid>
                  <ItemsControl ItemsSource="{Binding HeldBackRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,5">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.Text}" />
                          <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource Text.Micro}" HorizontalAlignment="Right" />
                          <ProgressBar Grid.Column="2" Height="6" Margin="8,0" VerticalAlignment="Center"
                                       Value="{Binding Cpu, Mode=OneWay}" Maximum="{Binding Scale, Mode=OneWay}"
                                       Background="{DynamicResource Brush.Hairline}" Foreground="{StaticResource Boost.Hatch}" />
                          <TextBlock Grid.Column="3" Text="{Binding CpuText}" Style="{StaticResource Text.Micro}"
                                     Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding HeldBackEmptyText}" Style="{StaticResource Text.Prose}" FontSize="12" VerticalAlignment="Center"
                             Visibility="{Binding HeldBackEmptyText, Converter={StaticResource EmptyToCollapsed}}" />
                </Grid>
              </Border>
              <TextBlock Text="{Binding DemotionDetailText}" Style="{StaticResource Boost.Detail}" />
              <Border Style="{StaticResource Boost.Foot}">
                <TextBlock Style="{StaticResource Text.Micro}" TextWrapping="Wrap" TextTrimming="None"
                           Text="read each second · new ones caught within 20 s · nothing is closed" />
              </Border>
              <Expander Header="settings" Margin="0,8,0,0">
                <StackPanel>
                  <TextBox Text="{Binding DemotionNames}" AcceptsReturn="True" TextWrapping="NoWrap"
                           VerticalScrollBarVisibility="Auto" Height="132" Width="280" HorizontalAlignment="Left" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="back to the built-in list" Padding="6,0"
                            Command="{Binding ResetDemotionNamesCommand}" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource Text.Micro}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None"
                             Text="One process name per line, with or without .exe. While Critical Ops is on screen each listed program runs at below-normal priority in Windows' efficiency mode, so it gets processor time only when the game is not asking for it; programs that start mid-game are caught within twenty seconds. When the game leaves, the switch is turned off or Optima closes, each one gets back exactly the priority it had, and if Optima itself dies mid-game the next start puts them back. Windows, the game, Google Play Games and Optima are never touched, whatever the list says. Voice and music apps are left out of the built-in list on purpose: a demoted Discord is a stuttering call." />
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>

          <!-- 05 Core parking -->
          <Border Grid.Row="4" Style="{StaticResource Boost.Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="05" Style="{StaticResource Text.Micro}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding KeepCoresAwake}"
                          AutomationProperties.Name="Core parking off" Margin="10,0,0,0" />
                <Label DockPanel.Dock="Right" Style="{StaticResource Boost.Pill}" Content="{Binding CoresStateText}" />
                <TextBlock Text="Core parking off" Style="{StaticResource Boost.Name}" />
              </DockPanel>
              <Border Style="{StaticResource Boost.Well}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Bottom" Text="{Binding CoresCellsText}" Style="{StaticResource Text.Micro}" FontSize="10" Margin="0,6,0,0"
                             TextWrapping="Wrap" TextTrimming="None" />
                  <ItemsControl ItemsSource="{Binding CoreCells}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="16" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="2" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1">
                          <Border Background="{StaticResource Boost.MoltenUp}" Visibility="{Binding Converter={StaticResource BoolToVis}}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </Border>
              <TextBlock Text="{Binding CoresDetailText}" Style="{StaticResource Boost.Detail}" />
              <Border Style="{StaticResource Boost.Foot}">
                <TextBlock Style="{StaticResource Text.Micro}" TextWrapping="Wrap" TextTrimming="None"
                           Text="no change on High or Ultimate Performance plans · per-core load is not measured" />
              </Border>
              <Expander Header="about" Margin="0,8,0,0">
                <TextBlock Style="{StaticResource Text.Micro}" TextWrapping="Wrap" TextTrimming="None"
                           Text="Core parking puts idle cores to sleep and wakes them on demand; the wake-up is a small hitch at exactly the wrong moment. The switch sets the active power plan to keep all cores awake for the match and writes the plan's own value back afterwards. It changes nothing on High or Ultimate Performance, which already do this, and it costs battery on a laptop." />
              </Expander>
            </StackPanel>
          </Border>

          <!-- 06 Graphics adapter -->
          <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource Boost.Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="06" Style="{StaticResource Text.Micro}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding GpuHighPerformance}"
                          AutomationProperties.Name="Graphics adapter" Margin="10,0,0,0" />
                <Label DockPanel.Dock="Right" Style="{StaticResource Boost.Pill}" Content="{Binding GpuStateText}" />
                <TextBlock Text="Graphics adapter" Style="{StaticResource Boost.Name}" />
              </DockPanel>
              <!-- Grows past the other wells' height: a desktop can have three graphics adapters, and the
                   preference line under them must not be cut off. -->
              <Border Style="{StaticResource Boost.Well}" Height="Auto" MinHeight="104">
                <StackPanel VerticalAlignment="Center">
                  <ItemsControl ItemsSource="{Binding AdapterRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="10,4" Margin="0,0,0,4" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" Style="{StaticResource Text.Micro}" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}" FontSize="12.5" />
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Padding="10,4" BorderThickness="1">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding GpuPreferenceSet}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Boost.Hot}" />
                            <Setter Property="Background" Value="{StaticResource Boost.HotWash}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <DockPanel>
                      <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Brush.HairlineStrong}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding GpuPreferenceSet}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource Boost.Hot}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <TextBlock Text="{Binding GpuPreferenceText}" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.Text}" />
                    </DockPanel>
                  </Border>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding GpuDetailText}" Style="{StaticResource Boost.Detail}" />
              <Border Style="{StaticResource Boost.Foot}">
                <TextBlock Style="{StaticResource Text.Micro}" TextWrapping="Wrap" TextTrimming="None"
                           Text="a standing Windows setting · removed when switched off here" />
              </Border>
              <Expander Header="about" Margin="0,8,0,0">
                <TextBlock Style="{StaticResource Text.Micro}" TextWrapping="Wrap" TextTrimming="None"
                           Text="The same per-app choice as Windows Settings, Display, Graphics: it matters on a PC with two graphics adapters (most gaming laptops) and does nothing on a PC with one. It is a standing Windows setting, so it stays until you switch it off here, and Windows reads it the next time the game starts." />
              </Expander>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
