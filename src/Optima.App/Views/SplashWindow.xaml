<Window x:Class="Optima.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" Height="320"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="True" Topmost="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <!-- Opera-GX-style launch card: true-black glass, the Optima mark breathing over an
       accent sweep, status text cycling while the host builds. Honors the motion switch:
       with animations off everything renders as a static frame. -->
  <Grid>
    <Border CornerRadius="10" Background="#07080A" BorderBrush="#33E8B45A" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="#000000" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- The Optima mark, breathing on an opacity cycle. -->
        <Image x:Name="Mark" Grid.Row="0" Source="pack://application:,,,/Assets/optima-presence.png"
               Width="104" Height="104" Margin="0,36,0,0"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <TextBlock Grid.Row="1" Text="OPTIMA" HorizontalAlignment="Center"
                   FontFamily="Cascadia Mono" FontSize="24" FontWeight="SemiBold"
                   Foreground="#E8B45A" Margin="0,4,0,0" />

        <!-- Accent sweep: the progress line, an indeterminate highlight running across. -->
        <Grid Grid.Row="2" Height="2" Width="280" Margin="0,24,0,0" HorizontalAlignment="Center">
          <Rectangle Fill="#22E8B45A" />
          <Rectangle x:Name="Sweep" Width="96" HorizontalAlignment="Left" RadiusX="1" RadiusY="1">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00E8B45A" Offset="0" />
                <GradientStop Color="#E8B45A" Offset="0.5" />
                <GradientStop Color="#00E8B45A" Offset="1" />
              </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
              <TranslateTransform x:Name="SweepTransform" />
            </Rectangle.RenderTransform>
          </Rectangle>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,14,0,0" HorizontalAlignment="Center">
          <TextBlock x:Name="StatusText" HorizontalAlignment="Center"
                     FontFamily="Cascadia Mono" FontSize="11"
                     Foreground="#757D88" Text="starting" />
          <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,6,0,0"
                     FontFamily="Cascadia Mono" FontSize="10"
                     Foreground="#3F4750" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
