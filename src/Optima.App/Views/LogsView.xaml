<UserControl x:Class="Optima.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The one page where the terminal metaphor is literal rather than decorative:
    full-bleed pane, prompt-style filter line, and a tail toggle.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="22,18,22,0">
      <TextBlock Text="LOGS" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="structured application log · newest at the bottom · alt+f9 toggles the floating console"
                 Style="{StaticResource Text.PageSubtitle}" />
    </StackPanel>

    <!-- Filter line, styled as a command prompt -->
    <Border Grid.Row="1" Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,1,0,1" Padding="22,7">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="&gt;" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"
                   FontSize="{StaticResource Type.Label}" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Text="--level" Style="{StaticResource Text.Label}"
                   VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding SelectedLevel}"
                  Width="104" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="--grep" Style="{StaticResource Text.Label}"
                   VerticalAlignment="Center" Margin="14,0,6,0" />
        <TextBox Grid.Column="4" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Center" MaxWidth="360" HorizontalAlignment="Left" MinWidth="200" />

        <StackPanel Grid.Column="5" Orientation="Horizontal">
          <Button Style="{StaticResource GhostButton}" Content="open folder" Command="{Binding OpenLogFolderCommand}" />
          <Button Style="{StaticResource GhostButton}" Content="export" Command="{Binding ExportCommand}" />
          <Button Style="{StaticResource GhostButton}" Content="clear" Command="{Binding ClearCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Log surface: darker than the app ground so it reads as a device, not a page -->
    <Border Grid.Row="2" Background="#FF050608">
      <ListBox x:Name="LogList" ItemsSource="{Binding FilteredView}"
               Background="Transparent" BorderThickness="0" Padding="16,8"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="4,1" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="66" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding TimeText}" FontSize="{StaticResource Type.Micro}"
                         Foreground="{StaticResource Brush.Hairline}" />
              <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="{StaticResource Type.Micro}"
                         Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}" />
              <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="{StaticResource Type.Micro}"
                         Foreground="{StaticResource Brush.TextMuted}" />
              <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="{StaticResource Type.Micro}"
                         Foreground="{StaticResource Brush.Text}" TextWrapping="Wrap" TextTrimming="None" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Status strip -->
    <Border Grid.Row="3" Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,1,0,0" Padding="22,6">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding LineCount, StringFormat='{}{0} lines'}" Style="{StaticResource Text.Micro}" />
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Micro}"
                     Foreground="{StaticResource Brush.Ok}" Margin="14,0,0,0" />
        </StackPanel>
        <CheckBox HorizontalAlignment="Right" IsChecked="{Binding TailEnabled}"
                  Content="TAIL" FontSize="{StaticResource Type.Micro}"
                  ToolTip="Follow new log entries as they arrive" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
