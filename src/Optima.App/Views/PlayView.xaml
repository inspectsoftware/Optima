<UserControl x:Class="Optima.App.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Optima.App.Controls">
  <UserControl.Resources>
    <DataTemplate x:Key="StepRow">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ctl:Icon Size="15" StrokeThickness="2">
          <ctl:Icon.Style>
            <Style TargetType="ctl:Icon" BasedOn="{StaticResource {x:Type ctl:Icon}}">
              <Setter Property="Symbol" Value="{StaticResource Icon.Circle}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.HairlineStrong}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Done">
                  <Setter Property="Symbol" Value="{StaticResource Icon.Check}" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Live">
                  <Setter Property="Symbol" Value="{StaticResource Icon.Dot}" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                  <Setter Property="Symbol" Value="{StaticResource Icon.Close}" />
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Fail}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ctl:Icon.Style>
        </ctl:Icon>
        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
              <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Done">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Live">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Fail}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Text.Micro}"
                   VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRoot}" MaxWidth="1040" HorizontalAlignment="Left">
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Session" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Grid.Column="1" Text="EVERYTHING IS RESTORED WHEN THE GAME EXITS" Style="{StaticResource Text.PageSubtitle}"
                   Margin="0,0,4,0" VerticalAlignment="Bottom" />
      </Grid>

      <HeaderedContentControl Style="{StaticResource Section}" Header="LAUNCH STEPS">
        <HeaderedContentControl.Tag>
          <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue=''}" Style="{StaticResource Text.Micro}" />
        </HeaderedContentControl.Tag>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="300" />
          </Grid.ColumnDefinitions>

          <StackPanel>
            <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepRow}" />
            <ProgressBar Value="{Binding SessionProgress, Mode=OneWay}" Maximum="1" Margin="24,4,0,0" />
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="elapsed" Style="{StaticResource Text.Label}" />
            <TextBlock Text="{Binding ElapsedText}" Margin="0,2,0,12">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metric}">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Micro}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="The window hides to the tray while the game runs and returns when the session ends. Pick the profile on Home." />
            <WrapPanel>
              <Button Style="{StaticResource PrimaryButton}" Content="{Binding PlayButtonText}" Command="{Binding PlayCommand}"
                      Margin="0,0,8,8" />
              <Button Style="{StaticResource SecondaryButton}" Content="Cancel session" Command="{Binding CancelCommand}"
                      Margin="0,0,8,8" Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}}" />
              <Button Style="{StaticResource DangerButton}" Content="Terminate process" Command="{Binding KillGameCommand}"
                      Margin="0,0,8,8"
                      ToolTip="Instantly terminates the Critical Ops emulator process tree (Ctrl+Alt+K works anywhere)" />
            </WrapPanel>
            <TextBlock Text="{Binding KillStatusText}" Style="{StaticResource Text.Micro}"
                       Foreground="{DynamicResource Brush.Warn}" TextWrapping="Wrap"
                       Visibility="{Binding KillStatusText, Converter={StaticResource EmptyToCollapsed}}" />
          </StackPanel>
        </Grid>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="LAST SESSION"
                              Visibility="{Binding LastSession, Converter={StaticResource NullToCollapsed}}">
        <StackPanel>
          <UniformGrid Columns="5">
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="duration" Style="{StaticResource Text.Label}" />
                <TextBlock Text="{Binding LastSession.Duration, StringFormat={}{0:hh\\:mm\\:ss}}" Style="{StaticResource Text.Metric}" FontSize="22" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="avg fps" Style="{StaticResource Text.Label}" />
                <TextBlock Text="{Binding LastSession.Stats.AverageFps, StringFormat={}{0:F0}}" Style="{StaticResource Text.Metric}" FontSize="22" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="1% low" Style="{StaticResource Text.Label}" />
                <TextBlock Text="{Binding LastSession.Stats.OnePercentLowFps, StringFormat={}{0:F0}}" Style="{StaticResource Text.Metric}" FontSize="22" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="0.1% low" Style="{StaticResource Text.Label}" />
                <TextBlock Text="{Binding LastSession.Stats.PointOnePercentLowFps, StringFormat={}{0:F0}}" Style="{StaticResource Text.Metric}" FontSize="22" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}" Margin="0">
              <StackPanel>
                <TextBlock Text="p99 frametime" Style="{StaticResource Text.Label}" />
                <TextBlock Text="{Binding LastSession.Stats.P99FrametimeMs, StringFormat={}{0:F1} ms}" Style="{StaticResource Text.Metric}" FontSize="22" />
              </StackPanel>
            </Border>
          </UniformGrid>
          <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0" MaxWidth="700" HorizontalAlignment="Left"
                     Text="FPS data needs frametime capture enabled in Settings, plus one approval of the administrator prompt."
                     Visibility="{Binding LastSession.Stats.HasData, Converter={StaticResource InverseBoolToVis}}" />
        </StackPanel>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="ERROR"
                              Visibility="{Binding LastError, Converter={StaticResource NullToCollapsed}}">
        <Border Style="{StaticResource Callout}" BorderBrush="{DynamicResource Brush.Fail}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}" BorderBrush="{DynamicResource Brush.Fail}" Margin="0,0,10,0">
                <TextBlock Text="FAILED" Style="{StaticResource Text.Badge}" Foreground="{DynamicResource Brush.Fail}" />
              </Border>
              <TextBlock Text="{Binding LastError.Title}" FontSize="{StaticResource Type.Title}"
                         Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding LastError.Explanation}" Style="{StaticResource Text.Prose}"
                       Margin="0,8,0,0" MaxWidth="720" HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding LastError.SuggestedFixes}" Margin="0,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Brush.Warn}" BorderThickness="2,0,0,0" Padding="10,2" Margin="0,2">
                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Prose}"
                               Foreground="{DynamicResource Brush.Warn}" MaxWidth="680" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding LastError.Code, StringFormat='code: {0}'}"
                       Style="{StaticResource Text.Micro}" Margin="0,10,0,0" />
            <Expander Header="developer details" Margin="0,8,0,0"
                      Visibility="{Binding LastError.DeveloperDetails, Converter={StaticResource EmptyToCollapsed}}">
              <TextBox Text="{Binding LastError.DeveloperDetails, Mode=OneWay}" IsReadOnly="True"
                       FontSize="{StaticResource Type.Micro}" TextWrapping="Wrap"
                       MaxHeight="220" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
            </Expander>
          </StackPanel>
        </Border>
      </HeaderedContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
