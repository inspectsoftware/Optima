<UserControl x:Class="Optima.App.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRoot}" MaxWidth="920" HorizontalAlignment="Left">

      <TextBlock Text="System" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Hardware inventory and virtualization state" Style="{StaticResource Text.PageSubtitle}" />

      <HeaderedContentControl Style="{StaticResource Section}" Header="HARDWARE">
        <HeaderedContentControl.Tag>
          <Button Style="{StaticResource GhostButton}" Content="refresh" Command="{Binding RefreshCommand}" Padding="6,0" />
        </HeaderedContentControl.Tag>
        <ItemsControl ItemsSource="{Binding HardwareRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="VIRTUALIZATION">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding VirtualizationRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
          <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0" MaxWidth="720" HorizontalAlignment="Left"
                     Text="If firmware virtualization is disabled it must be enabled in the BIOS/UEFI. Windows cannot change it, and this application never modifies firmware or boot settings." />
        </StackPanel>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="NETWORK">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="16" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Connection quality" Style="{StaticResource Text.Label}" />
            <Rectangle Grid.Column="1" Style="{StaticResource Leader}" />
            <TextBlock Grid.Column="2" Text="{Binding NetworkStatus}" Style="{StaticResource Text.Value}" />
          </Grid>
          <TextBlock Style="{StaticResource Text.Prose}" Margin="0,10,0,0" MaxWidth="720" HorizontalAlignment="Left"
                     Text="Measured passively with pings while a game session runs. Game endpoints are preferred; when none answer, the reference host from Settings is measured instead and the readout reflects link quality rather than game-server latency." />
        </StackPanel>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="MONITORS">
        <ItemsControl ItemsSource="{Binding Displays}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource TableRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="170" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding DeviceName}" Style="{StaticResource Text.CellDim}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Cell}" />
                  <TextBlock Grid.Column="2" Text="{Binding Mode}" Style="{StaticResource Text.Cell}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </HeaderedContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
