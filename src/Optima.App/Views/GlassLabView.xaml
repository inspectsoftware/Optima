<UserControl x:Class="Optima.App.Views.GlassLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Optima.App.Controls"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="380" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="Stage" ClipToBounds="True" Background="Transparent" MouseMove="OnStageMouseMove">
      <Grid x:Name="Plane" Background="#FF040404">
        <Ellipse x:Name="Blob1" Width="720" Height="600" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-240,0,0">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#7AE8B45A" Offset="0" />
              <GradientStop Color="#00E8B45A" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Blob2" Width="680" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-220,-260">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#3A8FA8CC" Offset="0" />
              <GradientStop Color="#008FA8CC" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Blob3" Width="460" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#16FFFFFF" Offset="0" />
              <GradientStop Color="#00FFFFFF" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>

        <Grid Margin="32">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Ready to play" FontSize="30" FontWeight="SemiBold" Foreground="#FFEDEDED" />
            <TextBlock Text="Critical Ops via Google Play Games" FontSize="12.5" Foreground="#FF8F8F8F" Margin="0,4,0,18" />
            <ItemsControl x:Name="Rows">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="160" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="#FF8F8F8F" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" Foreground="#FFEDEDED" FontFamily="{StaticResource Font.Mono}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Grid Grid.Column="1" Margin="24,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="140" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="FPS, last 60 s" FontSize="12" Foreground="#FF8F8F8F" Margin="0,0,0,8" />
            <Canvas x:Name="ChartCanvas" Grid.Row="1" ClipToBounds="True">
              <Polyline x:Name="Spark" Stroke="#FFE8B45A" StrokeThickness="1.75" StrokeLineJoin="Round" />
            </Canvas>
            <TextBlock Grid.Row="2" Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="18" FontSize="12.5" Foreground="#FFB4B4B4"
                       Text="Drag the panel over this text. The glass should blur it, bend it at the rim with a faint red and blue split, and carry a highlight that follows the pointer. Text inside the panel must stay crisp." />
          </Grid>
        </Grid>
      </Grid>

      <Canvas x:Name="Overlay">
        <ctl:GlassPanel x:Name="Panel" Canvas.Left="120" Canvas.Top="90" Width="440" Height="250"
                        ctl:GlassPanel.Backdrop="{Binding ElementName=Plane}" Chamfer="0" CornerRadius="22" BlurRadius="36" Downsample="2"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="OnPanelDown" MouseMove="OnPanelMove" MouseLeftButtonUp="OnPanelUp">
          <ctl:GlassPanel.Child>
            <StackPanel Margin="26,22">
              <TextBlock Text="Competitive 1080p240" FontSize="20" FontWeight="SemiBold" Foreground="#FFE8B45A" />
              <TextBlock Text="Virtual display 1920x1080 @ 240 Hz, high performance plan, priority high" FontSize="12" Foreground="#FFB4B4B4" TextWrapping="Wrap" Margin="0,6,0,0" />
              <Border Margin="0,22,0,0" Height="46" Width="180" HorizontalAlignment="Left" CornerRadius="13">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFF0C066" Offset="0" />
                    <GradientStop Color="#FFD9A345" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="Play" FontSize="15" FontWeight="SemiBold" Foreground="#FF16130B" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </ctl:GlassPanel.Child>
        </ctl:GlassPanel>
      </Canvas>
    </Grid>

    <WrapPanel Grid.Row="1" Margin="0,10,0,0" ItemHeight="30" ItemWidth="300">
      <DockPanel Margin="0,0,16,0">
        <TextBlock Text="blur" Width="64" VerticalAlignment="Center" FontSize="11.5" Foreground="#FF8F8F8F" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding BlurRadius, ElementName=Panel, StringFormat={}{0:0}}" Width="36" VerticalAlignment="Center" FontSize="11.5" TextAlignment="Right" />
        <Slider Minimum="0" Maximum="64" Value="{Binding BlurRadius, ElementName=Panel, Mode=TwoWay}" VerticalAlignment="Center" />
      </DockPanel>
      <DockPanel Margin="0,0,16,0">
        <TextBlock Text="refraction" Width="64" VerticalAlignment="Center" FontSize="11.5" Foreground="#FF8F8F8F" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Glass.Refract, ElementName=Panel, StringFormat={}{0:0}}" Width="36" VerticalAlignment="Center" FontSize="11.5" TextAlignment="Right" />
        <Slider Minimum="0" Maximum="40" Value="{Binding Glass.Refract, ElementName=Panel, Mode=TwoWay}" VerticalAlignment="Center" />
      </DockPanel>
      <DockPanel Margin="0,0,16,0">
        <TextBlock Text="edge" Width="64" VerticalAlignment="Center" FontSize="11.5" Foreground="#FF8F8F8F" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Glass.Edge, ElementName=Panel, StringFormat={}{0:0}}" Width="36" VerticalAlignment="Center" FontSize="11.5" TextAlignment="Right" />
        <Slider Minimum="4" Maximum="80" Value="{Binding Glass.Edge, ElementName=Panel, Mode=TwoWay}" VerticalAlignment="Center" />
      </DockPanel>
      <DockPanel Margin="0,0,16,0">
        <TextBlock Text="chroma" Width="64" VerticalAlignment="Center" FontSize="11.5" Foreground="#FF8F8F8F" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Glass.Chroma, ElementName=Panel, StringFormat={}{0:0.00}}" Width="36" VerticalAlignment="Center" FontSize="11.5" TextAlignment="Right" />
        <Slider Minimum="0" Maximum="1" Value="{Binding Glass.Chroma, ElementName=Panel, Mode=TwoWay}" VerticalAlignment="Center" />
      </DockPanel>
      <DockPanel Margin="0,0,16,0">
        <TextBlock Text="specular" Width="64" VerticalAlignment="Center" FontSize="11.5" Foreground="#FF8F8F8F" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Glass.Specular, ElementName=Panel, StringFormat={}{0:0.00}}" Width="36" VerticalAlignment="Center" FontSize="11.5" TextAlignment="Right" />
        <Slider Minimum="0" Maximum="2" Value="{Binding Glass.Specular, ElementName=Panel, Mode=TwoWay}" VerticalAlignment="Center" />
      </DockPanel>
      <DockPanel Margin="0,0,16,0">
        <TextBlock Text="downsample" Width="64" VerticalAlignment="Center" FontSize="11.5" Foreground="#FF8F8F8F" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Downsample, ElementName=Panel, StringFormat={}{0:0.0}}" Width="36" VerticalAlignment="Center" FontSize="11.5" TextAlignment="Right" />
        <Slider Minimum="1" Maximum="4" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding Downsample, ElementName=Panel, Mode=TwoWay}" VerticalAlignment="Center" />
      </DockPanel>
      <DockPanel Margin="0,0,16,0">
        <TextBlock Text="radius" Width="64" VerticalAlignment="Center" FontSize="11.5" Foreground="#FF8F8F8F" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding CornerRadius, ElementName=Panel, StringFormat={}{0:0}}" Width="36" VerticalAlignment="Center" FontSize="11.5" TextAlignment="Right" />
        <Slider Minimum="0" Maximum="60" Value="{Binding CornerRadius, ElementName=Panel, Mode=TwoWay}" VerticalAlignment="Center" />
      </DockPanel>
      <CheckBox x:Name="DriftBox" Content="ambient drift" IsChecked="True" Checked="OnDriftChanged" Unchecked="OnDriftChanged" VerticalAlignment="Center" />
      <CheckBox x:Name="ForceMotionBox" Content="ignore Windows animation setting (lab only)" IsChecked="False" Checked="OnDriftChanged" Unchecked="OnDriftChanged" VerticalAlignment="Center" />
      <TextBlock x:Name="Readout" Text="fps --" VerticalAlignment="Center" FontSize="11.5" Foreground="#FFB4B4B4" FontFamily="{StaticResource Font.Mono}" />
    </WrapPanel>
  </Grid>
</UserControl>
