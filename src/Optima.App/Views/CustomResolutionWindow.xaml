<Window x:Class="Optima.App.Views.CustomResolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Optima.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Optima"
        Width="620" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0"
                        CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border Background="{DynamicResource Brush.Background}"
          TextElement.Foreground="{DynamicResource Brush.Text}"
          TextElement.FontFamily="{StaticResource Font.Body}"
          TextElement.FontSize="{StaticResource Type.Body}">
    <Grid>
      <ctl:AmbientField x:Name="Ambient" />
      <Grid Margin="12" ctl:GlassPanel.Backdrop="{Binding ElementName=Ambient}">
        <Grid.RowDefinitions>
          <RowDefinition Height="28" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ctl:TitleBar Grid.Row="0" ShowMinimize="False" ShowMaximize="False" Breadcrumb="OPTIMA · CUSTOM RESOLUTION" />

        <ctl:GlassPanel Grid.Row="1" Chamfer="{StaticResource Chamfer.Strip}" Padding="20,16,20,16"
                        Tint="{DynamicResource Color.Glass.Tint}"
                        ctl:Flow.Open="True"
                        BottomLine="{DynamicResource Brush.Strip.Bottom}"
                        LeadingEdge="{DynamicResource Brush.Strip.Edge}">
          <ctl:GlassPanel.Child>
            <StackPanel>
              <TextBlock Text="Custom resolution" FontSize="{StaticResource Type.Title}" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Text.Micro}" Margin="0,6,0,0" TextWrapping="Wrap"
                         Text="Changes the resolution of your own monitor. The virtual display is not used. Nothing is saved to Windows: the change lasts until you restore it here or restart the PC." />

              <StackPanel x:Name="Form" Margin="0,14,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="monitor" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                  <ComboBox x:Name="MonitorCombo" Grid.Column="1" SelectionChanged="OnMonitorChanged" />
                </Grid>

                <WrapPanel Margin="0,12,0,0">
                  <TextBlock Text="resolution" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Width="90" />
                  <TextBox x:Name="WidthBox" Width="80" TextChanged="OnSizeTyped" />
                  <TextBlock Text="x" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="8,0" />
                  <TextBox x:Name="HeightBox" Width="80" TextChanged="OnSizeTyped" Margin="0,0,16,0" />
                  <ComboBox x:Name="RateCombo" Width="90" />
                  <TextBlock Text="Hz" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </WrapPanel>

                <WrapPanel Margin="90,10,0,0">
                  <Button Style="{StaticResource ChipButton}" Content="1920 x 1440" Tag="1920,1440" Padding="12,5" Margin="0,0,8,0" Click="OnPreset" />
                  <Button Style="{StaticResource ChipButton}" Content="1440 x 1080" Tag="1440,1080" Padding="12,5" Margin="0,0,8,0" Click="OnPreset" />
                  <Button Style="{StaticResource ChipButton}" Content="1280 x 960" Tag="1280,960" Padding="12,5" Click="OnPreset" />
                </WrapPanel>

                <TextBlock x:Name="ListedText" Style="{StaticResource Text.Micro}" Margin="90,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock Style="{StaticResource Text.Micro}" Margin="90,6,0,0" TextWrapping="Wrap"
                           Text="Whether the picture stretches or gets black bars is your graphics card's scaling setting." />
              </StackPanel>

              <!-- A wrong mode can leave the screen black, so a change only stays when someone who can see it says so. -->
              <Border x:Name="KeepPanel" Style="{StaticResource Callout}" BorderBrush="{DynamicResource Brush.Warn}" Margin="0,14,0,0"
                      Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="KeepText" Style="{StaticResource Text.Prose}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Content="Go back" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnGoBack" />
                    <Button Content="Keep" Style="{StaticResource PrimaryButton}" MinWidth="80" Click="OnKeep" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border x:Name="MessagePanel" Style="{StaticResource Callout}" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="MessageText" Style="{StaticResource Text.Prose}" TextWrapping="Wrap" />
              </Border>

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="RestoreButton" Content="Restore" Style="{StaticResource SecondaryButton}" Padding="14,5"
                        IsEnabled="False" Click="OnRestore" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <Button Content="Close" Style="{StaticResource GhostButton}" MinWidth="90" Margin="0,0,8,0" IsCancel="True" />
                  <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource PrimaryButton}" MinWidth="120"
                          IsDefault="True" IsEnabled="False" Click="OnApply" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </ctl:GlassPanel.Child>
        </ctl:GlassPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
