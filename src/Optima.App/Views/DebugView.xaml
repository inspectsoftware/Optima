<UserControl x:Class="Optima.App.Views.DebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Optima.App.ViewModels"
             xmlns:views="clr-namespace:Optima.App.Views"
             xmlns:tabs="clr-namespace:Optima.App.Views.DebugTabs">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <StackPanel Margin="24,14,24,0">
      <TextBlock Text="Debug" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="What went wrong, why, and how to put it right · Alt+F9 floats the log over the game"
                 Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,10" />
    </StackPanel>

    <!-- The tabs are a strip of chips over one star row. The tab bodies all live in that row and
         only their visibility changes: the log list needs a bounded viewport to virtualize, and a
         page that stacked its sections in a scroller would give it an unbounded one. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,0,24,10">
      <Button Style="{StaticResource ChipButton}" Content="CHECKS" Margin="0,0,6,0" Tag="{Binding IsChecks}"
              Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:DebugTab.Checks}"
              ToolTip="Is this PC set up to run the game: each check with its reason and its fix" />
      <Button Style="{StaticResource ChipButton}" Content="LOG" Margin="0,0,6,0" Tag="{Binding IsLog}"
              Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:DebugTab.Log}"
              ToolTip="Everything Optima did, newest at the bottom. Click a line for its full error" />
      <Button Style="{StaticResource ChipButton}" Content="CRASHES" Margin="0,0,6,0" Tag="{Binding IsCrashes}"
              Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:DebugTab.Crashes}"
              ToolTip="Bundles saved when the game ended badly" />
      <Button Style="{StaticResource ChipButton}" Content="ERROR GUIDE" Tag="{Binding IsGuide}"
              Command="{Binding SelectTabCommand}" CommandParameter="{x:Static vm:DebugTab.Guide}"
              ToolTip="What every error code means and how to fix it" />
    </StackPanel>

    <tabs:ChecksTab Grid.Row="2" DataContext="{Binding Checks}"
                     Visibility="{Binding DataContext.IsChecks, RelativeSource={RelativeSource AncestorType=views:DebugView}, Converter={StaticResource BoolToVis}}" />
    <views:LogStreamView Grid.Row="2" DataContext="{Binding Stream}"
                         Visibility="{Binding DataContext.IsLog, RelativeSource={RelativeSource AncestorType=views:DebugView}, Converter={StaticResource BoolToVis}}" />
    <tabs:CrashesTab Grid.Row="2" DataContext="{Binding Crashes}"
                      Visibility="{Binding DataContext.IsCrashes, RelativeSource={RelativeSource AncestorType=views:DebugView}, Converter={StaticResource BoolToVis}}" />
    <tabs:GuideTab Grid.Row="2"
                    Visibility="{Binding IsGuide, Converter={StaticResource BoolToVis}}" />
  </Grid>
</UserControl>
