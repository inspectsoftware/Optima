<UserControl x:Class="Optima.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Optima.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRoot}">

      <TextBlock Text="Diagnostics" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Environment checks · each result carries a reason and a fix"
                 Style="{StaticResource Text.PageSubtitle}" />

      <HeaderedContentControl Style="{StaticResource Section}" Header="CHECKS">
        <HeaderedContentControl.Tag>
          <StackPanel Orientation="Horizontal">
            <ctl:AsciiSpinner Cells="10" Margin="0,0,12,0"
                              Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            <Button Style="{StaticResource SecondaryButton}" Content="run all"
                    Command="{Binding RunAllCommand}" Padding="10,3" />
          </StackPanel>
        </HeaderedContentControl.Tag>

        <StackPanel>
          <!--
            One line per check, appended as each completes. The reason trails dimmed on
            the same row; the fix line only appears under a WARN or FAIL.
          -->
          <ItemsControl ItemsSource="{Binding Results}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,3">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" MinWidth="16" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Status, Converter={StaticResource DiagStatusTag}}"
                               Foreground="{Binding Status, Converter={StaticResource DiagStatusBrush}}"
                               FontSize="{StaticResource Type.Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding CheckName}" Style="{StaticResource Text.Value}"
                               Margin="10,0,0,0" />
                    <Rectangle Grid.Column="2" Style="{StaticResource Leader}" />
                    <TextBlock Grid.Column="3" Text="{Binding Reason}" Style="{StaticResource Text.Prose}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="{StaticResource Type.Micro}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="440" />
                  </Grid>

                  <!-- Fix, shown only where there is a problem to fix -->
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,2"
                              Visibility="{Binding Status, Converter={StaticResource DiagStatusIsProblem}}">
                    <TextBlock Text="&#x2514;" Foreground="{DynamicResource Brush.Hairline}"
                               Margin="6,0,8,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding RecommendedFix}" Style="{StaticResource Text.Prose}"
                               Foreground="{DynamicResource Brush.Warn}" MaxWidth="720" />
                  </StackPanel>

                  <Expander Header="details" Margin="24,0,0,4"
                            Visibility="{Binding Details, Converter={StaticResource EmptyToCollapsed}}">
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Micro}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               TextWrapping="Wrap" TextTrimming="None" />
                  </Expander>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Cursor block while checks are still arriving -->
          <TextBlock Text="&#x258C;" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"
                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

          <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Value}" Margin="0,12,0,0"
                     Visibility="{Binding Summary, Converter={StaticResource EmptyToCollapsed}}" />
        </StackPanel>
      </HeaderedContentControl>

      <!-- Repair: the actions that fix a broken environment without a reinstall. -->
      <HeaderedContentControl Style="{StaticResource Section}" Header="REPAIR">
        <HeaderedContentControl.Tag>
          <Button Style="{StaticResource GhostButton}" Content="run setup wizard again" Padding="6,0"
                  Command="{Binding RerunSetupCommand}" />
        </HeaderedContentControl.Tag>
        <StackPanel>
          <Grid Margin="0,0,0,8" MaxWidth="720" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="16" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Google Play Games heartbeat" Style="{StaticResource Text.Label}" />
            <Rectangle Grid.Column="1" Style="{StaticResource Leader}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <TextBlock Text="{Binding HeartbeatText}" Style="{StaticResource Text.Value}" />
              <Button Style="{StaticResource GhostButton}" Content="refresh" Padding="5,0" Margin="8,0,0,0"
                      Command="{Binding RefreshHeartbeatCommand}" />
            </StackPanel>
          </Grid>
          <WrapPanel>
            <Button Style="{StaticResource SecondaryButton}" Content="restart Google Play Games cleanly"
                    Command="{Binding RestartPlatformCommand}" Margin="0,0,8,8"
                    ToolTip="Stops the platform's own processes in order and relaunches it" />
            <Button Style="{StaticResource SecondaryButton}" Content="re-detect installation"
                    Command="{Binding RedetectCommand}" Margin="0,0,8,8"
                    ToolTip="Clears the cached paths and searches again (for moved installs)" />
            <Button Style="{StaticResource SecondaryButton}" Content="graphics settings"
                    Command="{Binding OpenGraphicsSettingsCommand}" Margin="0,0,8,8" />
            <Button Style="{StaticResource SecondaryButton}" Content="installed apps"
                    Command="{Binding OpenAppsSettingsCommand}" Margin="0,0,8,8" />
            <Button Style="{StaticResource SecondaryButton}" Content="restore settings backups"
                    Command="{Binding RestoreSettingsBackupsCommand}" Margin="0,0,8,8"
                    ToolTip="Puts back the previous saved generation of Optima's own settings files" />
            <Button Style="{StaticResource SecondaryButton}" Content="create support archive"
                    Command="{Binding CreateSupportArchiveCommand}" Margin="0,0,8,8"
                    ToolTip="Redacted zip: logs, diagnostics, newest crash bundle, settings" />
          </WrapPanel>
          <TextBlock Text="{Binding RepairStatus}" Style="{StaticResource Text.Value}"
                     Foreground="{DynamicResource Brush.Ok}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                     Visibility="{Binding RepairStatus, Converter={StaticResource EmptyToCollapsed}}" />
        </StackPanel>
      </HeaderedContentControl>

      <!-- Crash bundles captured by the Watchdog on game exits with failure markers. -->
      <HeaderedContentControl Style="{StaticResource Section}" Header="CRASHES">
        <HeaderedContentControl.Tag>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource GhostButton}" Content="capture now" Padding="6,0"
                    Command="{Binding CaptureCrashNowCommand}"
                    ToolTip="Writes a bundle from the current platform logs even without a crash" />
            <Button Style="{StaticResource GhostButton}" Content="open folder" Padding="6,0"
                    Command="{Binding OpenCrashesFolderCommand}" />
          </StackPanel>
        </HeaderedContentControl.Tag>
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Prose}" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,6"
                     Text="When Critical Ops ends with failure markers in Google Play Games' own logs, the Watchdog saves a bundle here: a plain-text timeline plus the relevant log excerpt. Export makes a redacted zip that is safe to share with developers." />
          <ItemsControl ItemsSource="{Binding Crashes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource TableRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="260" />
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Cell}" />
                    <TextBlock Grid.Column="1" Text="{Binding CapturedText}" Style="{StaticResource Text.CellDim}" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="export redacted zip" Padding="6,0"
                            Command="{Binding DataContext.ExportCrashRedactedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="no crash bundles captured" Margin="0,4,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Crashes.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding CrashStatus}" Style="{StaticResource Text.Micro}"
                     Foreground="{DynamicResource Brush.Ok}" Margin="0,6,0,0"
                     Visibility="{Binding CrashStatus, Converter={StaticResource EmptyToCollapsed}}" />
        </StackPanel>
      </HeaderedContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
