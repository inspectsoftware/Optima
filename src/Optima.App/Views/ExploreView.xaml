<UserControl x:Class="Optima.App.Views.ExploreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Optima.App.Controls">
  <UserControl.Resources>
    <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource Text.Micro}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <StackPanel Margin="22,18,22,0">
      <TextBlock Text="Explore" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Critical Ops leaderboards and clan lookup, straight from Critical Force's public API"
                 Style="{StaticResource Text.PageSubtitle}" />
    </StackPanel>

    <!-- Tabs + search + refresh. -->
    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,1" Padding="22,7" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Content="elite ops"
                  Command="{Binding ShowTabCommand}" CommandParameter="elite">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsEliteTab}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="ranked"
                  Command="{Binding ShowTabCommand}" CommandParameter="ranked">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsRankedTab}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="casual"
                  Command="{Binding ShowTabCommand}" CommandParameter="casual">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCasualTab}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="clans"
                  Command="{Binding ShowTabCommand}" CommandParameter="clans">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsClansTab}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="search" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220"
                   VerticalAlignment="Center" MaxWidth="320"
                   ToolTip="Filter the lists — or type an account id / in-game name and press Enter to open any player's profile" KeyDown="OnSearchKeyDown" />
          <Button Style="{StaticResource GhostButton}" Content="refresh" Margin="10,0,0,0"
                  Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status strip. -->
    <Grid Grid.Row="2" Margin="22,6,22,0">
      <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Micro}"
                 Foreground="{DynamicResource Brush.Warn}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="{Binding TotalCountText}" Style="{StaticResource Text.Micro}"
                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,14,0" />
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Micro}"
                   Foreground="{DynamicResource Brush.TextMuted}" />
      </StackPanel>
    </Grid>

    <!-- Player profile pane over the tables. -->
    <Grid Grid.Row="3">
      <ScrollViewer Margin="22,8,22,12" VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding IsProfileOpen, Converter={StaticResource BoolToVis}}">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding ProfileName}" Style="{StaticResource Text.PageTitle}" FontSize="{StaticResource Type.Title}" />
              <ctl:RankEmblem Width="34" VerticalAlignment="Center" Margin="12,0,0,0"
                              Visibility="{Binding HasProfileRank, Converter={StaticResource BoolToVis}}"
                              Tier="{Binding ProfileTier}" Division="{Binding ProfileDivision}"
                              ColorHex="{Binding ProfileColorHex}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="close"
                    Command="{Binding CloseProfileCommand}" VerticalAlignment="Top" />
          </Grid>
          <TextBlock Text="{Binding ProfileStatusText}" Style="{StaticResource Text.Micro}"
                     Foreground="{DynamicResource Brush.Warn}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                     Visibility="{Binding ProfileStatusText, Converter={StaticResource EmptyToCollapsed}}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="{Binding ProfileRankText}" Style="{StaticResource Text.Label}"
                       Foreground="{Binding ProfileColorHex, Converter={StaticResource HexToBrush}}"
                       Visibility="{Binding HasProfileRank, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding ProfileEloText}" Style="{StaticResource Text.Micro}" Margin="10,0,0,0"
                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"
                       Visibility="{Binding HasProfileRank, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="{Binding ProfileClanText}" Style="{StaticResource Text.Label}"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Visibility="{Binding HasProfileClan, Converter={StaticResource BoolToVis}}" />
            <Button Style="{StaticResource GhostButton}" Content="view clan" Padding="8,2" Margin="10,0,0,0"
                    Command="{Binding OpenProfileClanCommand}"
                    Visibility="{Binding HasProfileClan, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="{Binding ProfileLevelText}" Style="{StaticResource Text.Label}" Margin="0,0,14,0" />
            <TextBlock Text="{Binding ProfileSeasonText}" Style="{StaticResource Text.Label}" Margin="0,0,14,0" />
            <TextBlock Text="{Binding ProfileIdText}" Style="{StaticResource Text.Label}"
                       Foreground="{DynamicResource Brush.TextMuted}" />
          </StackPanel>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="MODE" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="1" Text="K" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="2" Text="D" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="3" Text="A" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="4" Text="RECORD" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="5" Text="K/D" Style="{StaticResource HeaderText}" />
            <ItemsControl Grid.Row="0" ItemsSource="{Binding ProfileModes}" Grid.ColumnSpan="6" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Mode}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding Kills}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="2" Text="{Binding Deaths}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="3" Text="{Binding Assists}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="4" Text="{Binding Record}" Style="{StaticResource Text.Label}" />
                    <TextBlock Grid.Column="5" Text="{Binding Kd}" Style="{StaticResource Text.Label}"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- Clan detail pane over the tables. -->
      <Grid Grid.Row="3" Visibility="{Binding IsProfileOpen, Converter={StaticResource InverseBoolToVis}}">
      <ScrollViewer Margin="22,8,22,12" VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding IsClanDetailOpen, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding ClanDetailTitle}" Style="{StaticResource Text.PageTitle}" FontSize="{StaticResource Type.Title}" />
              <!-- Real clan stats from the leaderboard row, when the clan is on the top-100 board. -->
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                          Visibility="{Binding HasClanStats, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Badge}" BorderBrush="{DynamicResource Brush.Accent}" Margin="0,0,10,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="BOARD #" Style="{StaticResource Text.Badge}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding SelectedClan.Rank}" Style="{StaticResource Text.Badge}" Foreground="{DynamicResource Brush.Accent}" />
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding SelectedClan.RatingText, StringFormat='rating {}{0}'}" Style="{StaticResource Text.Label}" Margin="0,0,14,0" />
                <TextBlock Text="{Binding SelectedClan.PlayersText, StringFormat='{}{0} players'}" Style="{StaticResource Text.Label}" Margin="0,0,14,0"
                           Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBlock Text="{Binding SelectedClan.AverageRatingText, StringFormat='avg {}{0} elo'}" Style="{StaticResource Text.Label}"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,14,0" />
                <TextBlock Text="{Binding SelectedClan.KdrText, StringFormat='K/D {}{0}'}" Style="{StaticResource Text.Label}"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,14,0" />
                <TextBlock Text="{Binding SelectedClan.WlrText, StringFormat='W/L {}{0}'}" Style="{StaticResource Text.Label}"
                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,14,0" />
                <TextBlock Text="{Binding SelectedClan.RecordText}" Style="{StaticResource Text.Label}"
                           Foreground="{DynamicResource Brush.TextMuted}" />
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="close"
                    Command="{Binding CloseClanCommand}" VerticalAlignment="Top" />
          </Grid>
          <TextBlock Text="{Binding RosterHint}" Style="{StaticResource Text.Micro}" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,8" MaxWidth="720" HorizontalAlignment="Left" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="roster" Style="{StaticResource Text.Label}" VerticalAlignment="Top" Margin="0,6,12,0" />
            <TextBox Grid.Column="1" Text="{Binding RosterText, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="120" MaxHeight="240" Width="340" HorizontalAlignment="Left" VerticalAlignment="Top"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     ToolTip="One account id or in-game name per line; ids are exact and survive renames" />
            <StackPanel Grid.Column="2" VerticalAlignment="Top">
              <Button Style="{StaticResource PrimaryButton}" Content="resolve roster" MinWidth="150" Margin="0,0,0,8"
                      Command="{Binding ResolveRosterCommand}" IsEnabled="{Binding IsResolvingRoster, Converter={StaticResource InverseBool}}" />
              <Button Style="{StaticResource SecondaryButton}" Content="save roster" MinWidth="150"
                      Command="{Binding SaveAndResolveRosterCommand}" IsEnabled="{Binding IsResolvingRoster, Converter={StaticResource InverseBool}}" />
              <ctl:AsciiSpinner Cells="10" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Visibility="{Binding IsResolvingRoster, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
          </Grid>

          <ItemsControl ItemsSource="{Binding ClanMembers}" Margin="0,14,0,0"
                        Visibility="{Binding HasClanMembers, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="52" />
                      <ColumnDefinition Width="190" />
                      <ColumnDefinition Width="60" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RankText}" Style="{StaticResource Text.Label}"
                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Fail}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding LevelText}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding RankText2}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding EloText}" Style="{StaticResource Text.Label}"
                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding KdText}" Style="{StaticResource Text.Label}"
                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{Binding ClanText}" Style="{StaticResource Text.Label}"
                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="{Binding StateText}" Style="{StaticResource Text.Micro}"
                               Foreground="{DynamicResource Brush.Warn}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Leaderboard tables. -->
      <Grid Margin="22,8,22,12"
            Visibility="{Binding IsClanDetailOpen, Converter={StaticResource InverseBoolToVis}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Clan table. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsClansTab, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="RANK" Style="{StaticResource HeaderText}" />
              <TextBlock Grid.Column="1" Text="CLAN" Style="{StaticResource HeaderText}" />
              <TextBlock Grid.Column="2" Text="RATING" Style="{StaticResource HeaderText}" />
              <TextBlock Grid.Column="3" Text="PLAYERS" Style="{StaticResource HeaderText}" />
              <TextBlock Grid.Column="4" Text="AVG" Style="{StaticResource HeaderText}" />
              <TextBlock Grid.Column="5" Text="KDR" Style="{StaticResource HeaderText}" />
              <TextBlock Grid.Column="6" Text="WLR" Style="{StaticResource HeaderText}" />
              <TextBlock Grid.Column="7" Text="KILLS" Style="{StaticResource HeaderText}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding VisibleClanRows}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="0,5"
                          Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnClanClick"
                          ToolTip="Open the clan pane to look up its members">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Rank}" Style="{StaticResource Text.Label}"
                                 Foreground="{DynamicResource Brush.TextMuted}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource Text.Label}" Foreground="{DynamicResource Brush.Text}">
                        <Run Text="{Binding Name, Mode=OneWay}" />
                        <Run Text="{Binding Tag, Mode=OneWay, StringFormat='[{0}]'}" Foreground="{DynamicResource Brush.Accent}" />
                      </TextBlock>
                      <TextBlock Grid.Column="2" Text="{Binding RatingText}" Style="{StaticResource Text.Label}" />
                      <TextBlock Grid.Column="3" Text="{Binding PlayersText}" Style="{StaticResource Text.Label}"
                                 Foreground="{DynamicResource Brush.TextMuted}" />
                      <TextBlock Grid.Column="4" Text="{Binding AverageRatingText}" Style="{StaticResource Text.Label}"
                                 Foreground="{DynamicResource Brush.TextMuted}" />
                      <TextBlock Grid.Column="5" Text="{Binding KdrText}" Style="{StaticResource Text.Label}"
                                 Foreground="{DynamicResource Brush.TextMuted}" />
                      <TextBlock Grid.Column="6" Text="{Binding WlrText}" Style="{StaticResource Text.Label}"
                                 Foreground="{DynamicResource Brush.TextMuted}" />
                      <TextBlock Grid.Column="7" Text="{Binding KillsText}" Style="{StaticResource Text.Label}"
                                 Foreground="{DynamicResource Brush.TextMuted}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Player table (elite / ranked / casual). -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsClansTab, Converter={StaticResource InverseBoolToVis}}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="90" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="RANK" Style="{StaticResource HeaderText}" />
              <TextBlock Grid.Column="1" Text="PLAYER" Style="{StaticResource HeaderText}" />
              <TextBlock Grid.Column="2" Text="KILLS" Style="{StaticResource HeaderText}" />
              <TextBlock Grid.Column="3" Text="DEATHS" Style="{StaticResource HeaderText}" />
              <TextBlock Grid.Column="4" Text="ASSISTS" Style="{StaticResource HeaderText}" />
              <TextBlock Grid.Column="5" Text="K/D" Style="{StaticResource HeaderText}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding VisiblePlayerRows}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="0,5">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Rank}" Style="{StaticResource Text.Label}"
                                 Foreground="{DynamicResource Brush.TextMuted}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Label}"
                                 Foreground="{DynamicResource Brush.Text}" />
                      <TextBlock Grid.Column="2" Text="{Binding KillsText}" Style="{StaticResource Text.Label}" />
                      <TextBlock Grid.Column="3" Text="{Binding DeathsText}" Style="{StaticResource Text.Label}"
                                 Foreground="{DynamicResource Brush.TextMuted}" />
                      <TextBlock Grid.Column="4" Text="{Binding AssistsText}" Style="{StaticResource Text.Label}"
                                 Foreground="{DynamicResource Brush.TextMuted}" />
                      <TextBlock Grid.Column="5" Text="{Binding RatioText}" Style="{StaticResource Text.Label}"
                                 Foreground="{DynamicResource Brush.TextMuted}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
