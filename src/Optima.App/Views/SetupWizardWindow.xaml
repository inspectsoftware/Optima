<Window x:Class="Optima.App.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Optima.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Welcome to Optima"
        Width="700" Height="720" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}" ResizeMode="NoResize"
        UseLayoutRounding="True">

  <!-- Same chrome as the main window, so the wizard cannot end up with a light title bar. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                        CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border Background="{DynamicResource Brush.Background}"
          TextElement.Foreground="{DynamicResource Brush.Text}"
          TextElement.FontFamily="{StaticResource Font.Mono}"
          TextElement.FontSize="{StaticResource Type.Body}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ctl:TitleBar Grid.Row="0" ShowMinimize="False" ShowMaximize="False" />

      <StackPanel Grid.Row="1" Margin="24,20,24,0">
        <TextBlock Text="First run" Style="{StaticResource Text.PageTitle}" />
        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.PageSubtitle}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                    Visibility="{Binding IsDetecting, Converter={StaticResource BoolToVis}}">
          <ctl:AsciiSpinner Cells="14" Margin="0,0,10,0" />
          <TextBlock Text="detecting" Style="{StaticResource Text.Micro}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="24,14,24,0">
        <StackPanel>
          <HeaderedContentControl Style="{StaticResource Section}" Header="DETECTION">
            <StackPanel>
              <ContentControl Content="{Binding Status.GooglePlayGames}" ContentTemplate="{StaticResource StatusItemTemplate}" />
              <ContentControl Content="{Binding Status.CriticalOps}" ContentTemplate="{StaticResource StatusItemTemplate}" />
              <ContentControl Content="{Binding Status.VirtualDisplay}" ContentTemplate="{StaticResource StatusItemTemplate}" />
              <ContentControl Content="{Binding Status.Virtualization}" ContentTemplate="{StaticResource StatusItemTemplate}" />
              <ContentControl Content="{Binding Status.Display}" ContentTemplate="{StaticResource StatusItemTemplate}" />
            </StackPanel>
          </HeaderedContentControl>

          <!-- The one-consent fix-everything card (Q7) -->
          <Border Style="{StaticResource Callout}" Margin="0,0,0,18"
                  Visibility="{Binding ShowFixAll, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Text="{Binding FixSummary}" Style="{StaticResource Text.Prose}"
                         MaxWidth="600" HorizontalAlignment="Left" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource PrimaryButton}" Padding="18,8" FontSize="{StaticResource Type.Label}"
                        Content="Fix everything" Command="{Binding FixEverythingCommand}"
                        IsEnabled="{Binding Fixing, Converter={StaticResource InverseBool}}" />
                <ctl:AsciiSpinner Cells="12" Margin="12,0,0,0"
                                  Visibility="{Binding Fixing, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding FixLog}" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource Text.Label}" Margin="0,2" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource Callout}" BorderBrush="{DynamicResource Brush.Warn}" Margin="0,0,0,18"
                  Visibility="{Binding RestartNeeded, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Prose}" MaxWidth="600" HorizontalAlignment="Left"
                         Text="Windows needs one restart to finish enabling the virtualization features. Optima reopens this setup afterwards by itself." />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Restart now" Command="{Binding RestartNowCommand}" />
                <TextBlock Text="{Binding RestartStatus}" Style="{StaticResource Text.Micro}" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- The firmware case is guided, never faked (no software can flip BIOS settings). -->
          <Border Style="{StaticResource Callout}" BorderBrush="{DynamicResource Brush.Fail}" Margin="0,0,0,18"
                  Visibility="{Binding FirmwareGuideVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Text="CPU virtualization is disabled in your BIOS/UEFI" Foreground="{DynamicResource Brush.Fail}"
                         FontSize="{StaticResource Type.Label}" />
              <TextBlock Style="{StaticResource Text.Prose}" Margin="0,6,0,0" MaxWidth="600" HorizontalAlignment="Left"
                         Text="No software can change this setting; it takes one visit to your BIOS: restart the PC and tap the setup key while it boots (usually Del or F2, sometimes F10 or Esc), find the CPU or Advanced section, enable Intel VT-x or AMD SVM, then save and exit. Optima will pick it up from there." />
            </StackPanel>
          </Border>

          <HeaderedContentControl Style="{StaticResource Section}" Header="ENVIRONMENT CHECKS">
            <ItemsControl ItemsSource="{Binding Diagnostics.Results}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" MinWidth="16" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status, Converter={StaticResource DiagStatusTag}}"
                               Foreground="{Binding Status, Converter={StaticResource DiagStatusBrush}}"
                               FontSize="{StaticResource Type.Label}" />
                    <TextBlock Grid.Column="1" Text="{Binding CheckName}" Style="{StaticResource Text.Value}"
                               Margin="10,0,0,0" />
                    <Rectangle Grid.Column="2" Style="{StaticResource Leader}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Section}" Header="MAKE IT YOURS">
            <StackPanel>
              <CheckBox IsChecked="{Binding StartWithWindows}" Margin="0,2"
                        Content="start the Optima Watchdog with Windows (minimized to the tray)" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="in-game name" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
                <TextBox Grid.Column="1" Text="{Binding PlayerIgn, UpdateSourceTrigger=PropertyChanged}" Width="220"
                         HorizontalAlignment="Left" Margin="0,4"
                         ToolTip="Optional: enables ranked session stats from your public profile" />
                <TextBlock Grid.Row="1" Text="Discord app id" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DiscordApplicationId, UpdateSourceTrigger=PropertyChanged}" Width="220"
                         HorizontalAlignment="Left" Margin="0,4"
                         ToolTip="Optional: enables Discord game activity (see Settings for the how-to)" />
              </Grid>
              <TextBlock Style="{StaticResource Text.Micro}" Margin="0,8,0,0" MaxWidth="580" HorizontalAlignment="Left" TextWrapping="Wrap"
                         Text="Both fields are optional and can be set later in Settings. Default profiles are ready: Default, Balanced, Competitive 1080p240 and Competitive 1440p165." />
            </StackPanel>
          </HeaderedContentControl>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,0"
              Background="{DynamicResource Brush.Surface}" Padding="24,14">
        <Button Style="{StaticResource PrimaryButton}" Content="Get started"
                Command="{Binding FinishCommand}" HorizontalAlignment="Right" MinWidth="190" Padding="20,9" />
      </Border>
    </Grid>
  </Border>
</Window>
