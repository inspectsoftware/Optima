<UserControl x:Class="Optima.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Optima.App.Controls">
  <UserControl.Resources>
    <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,6,12,6" />
    </Style>

    <!-- The hint inside the empty PLAYER box. -->
    <Style x:Key="Placeholder" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="11,0,0,0" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding PlayerQuery}" Value="">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="NoSavedPlayers" TargetType="TextBlock" BasedOn="{StaticResource Text.Micro}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding SavedPlayers.Count}" Value="0">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The tracked player: who HOME, the session stats and Discord follow. -->
    <DataTemplate x:Key="TrackedCard">
      <Border Background="{DynamicResource Brush.Tile}" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1"
              Padding="16" SnapsToDevicePixels="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="56" Height="56" Background="{DynamicResource Brush.Glass.Surface2}"
                  BorderBrush="{DynamicResource Brush.HairlineStrong}" BorderThickness="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding TrackedInitial}" Style="{StaticResource Text.Base}" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
            <WrapPanel>
              <TextBlock Text="{Binding TrackedName}" Style="{StaticResource Text.Base}" FontSize="18" FontWeight="SemiBold"
                         Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding TrackedIdText}" Style="{StaticResource Text.Micro}" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock Text="{Binding TrackedSummary}" Style="{StaticResource Text.Micro}" Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,6,0,0" TextWrapping="Wrap"
                       Visibility="{Binding TrackedSummary, Converter={StaticResource EmptyToCollapsed}}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource Brush.Ok}" VerticalAlignment="Center" />
              <TextBlock x:Name="Status" Grid.Column="1" Text="{Binding TrackedStatus}" Style="{StaticResource Text.Label}"
                         Foreground="{DynamicResource Brush.Ok}" TextWrapping="Wrap" Margin="8,0,0,0" />
            </Grid>
          </StackPanel>
          <Button x:Name="Save" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Save to Optima" Padding="16,8"
                  VerticalAlignment="Center" Command="{Binding SaveTrackedCommand}"
                  ToolTip="Keeps this player in Optima, so tracking them again is one click here or in the title bar" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding TrackedStatusOk}" Value="False">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Warn}" />
          <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Brush.Warn}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsTrackedSaved}" Value="True">
          <Setter TargetName="Save" Property="Content" Value="Saved in Optima" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One saved player: the name tracks them, the x forgets them. -->
    <DataTemplate x:Key="SavedChip">
      <Border x:Name="Chip" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="1"
              Background="{DynamicResource Brush.Tile}" Margin="0,0,8,8" SnapsToDevicePixels="True">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource GhostButton}" Padding="12,0" MinHeight="34"
                  Command="{Binding DataContext.UseSavedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}" ToolTip="Track this player">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Base}" FontSize="{StaticResource Type.Label}" />
              <TextBlock Text="{Binding AccountId}" Style="{StaticResource Text.Micro}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Width="1" Background="{DynamicResource Brush.Hairline}" />
          <Button Style="{StaticResource GhostButton}" Content="×" Width="34" FontSize="14"
                  Command="{Binding DataContext.RemoveSavedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}" ToolTip="Remove from Optima" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRoot}" MaxWidth="1100" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="%LOCALAPPDATA%\Optima" Style="{StaticResource Text.PageSubtitle}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="12" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <HeaderedContentControl Style="{StaticResource Section}" Header="APPEARANCE">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
              </Grid.RowDefinitions>

              <TextBlock Text="theme" Style="{StaticResource RowLabel}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"
                        Width="200" HorizontalAlignment="Left" Margin="0,5" />

              <TextBlock Grid.Row="1" Text="accent" Style="{StaticResource RowLabel}" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                <ItemsControl ItemsSource="{Binding AccentPresets}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" Cursor="Hand"
                              ToolTip="{Binding Name}" Margin="0,0,8,0">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="Swatch" Width="22" Height="22"
                                    Background="{Binding Hex, Converter={StaticResource HexToBrush}}"
                                    BorderBrush="{DynamicResource Brush.Glass.Highlight}" BorderThickness="1" />
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource Brush.Text}" />
                                <Setter TargetName="Swatch" Property="BorderThickness" Value="2" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" Width="92"
                         Margin="4,0,0,0" VerticalAlignment="Center"
                         ToolTip="Custom accent as #RRGGBB" />
                <Border Width="22" Height="22" Margin="8,0,0,0" VerticalAlignment="Center"
                        Background="{Binding AccentColor, Converter={StaticResource HexToBrush}}"
                        BorderBrush="{DynamicResource Brush.Glass.Border}" BorderThickness="1"
                        ToolTip="Preview of the accent that will apply on save" />
              </StackPanel>

              <TextBlock Grid.Row="2" Text="animations" Style="{StaticResource RowLabel}" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AnimationOptions}" SelectedItem="{Binding Animations}"
                        Width="200" HorizontalAlignment="Left" Margin="0,5" />

              <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Text.Micro}" Margin="0,2,0,4" TextWrapping="Wrap"
                         Text="Theme and accent apply the moment you save. Animations follow the Windows setting by default (Settings, Accessibility, Visual effects). Off makes everything arrive at once. Nothing is animated while a game is running." />
            </Grid>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Section}" Header="DISCORD">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
              </Grid.RowDefinitions>

              <TextBlock Text="game activity" Style="{StaticResource RowLabel}" />
              <CheckBox Grid.Column="1" IsChecked="{Binding DiscordPresenceEnabled}"
                        VerticalAlignment="Center" Margin="0,5"
                        Content="show Critical Ops activity while the game runs" />

              <TextBlock Grid.Row="1" Text="launcher activity" Style="{StaticResource RowLabel}" />
              <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding DiscordPresenceInLauncher}"
                        IsEnabled="{Binding DiscordPresenceEnabled}"
                        VerticalAlignment="Center" Margin="0,5"
                        Content="also show presence while browsing the launcher" />

              <TextBlock Grid.Row="2" Text="card fields" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,10,12,6" />
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,5">
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource SecondaryButton}" Content="choose what is shown…" Padding="12,6"
                          Command="{Binding ChooseDiscordPresenceCommand}"
                          IsEnabled="{Binding DiscordPresenceEnabled}" />
                  <TextBlock Text="{Binding DiscordOptionsSummary}" Style="{StaticResource Text.Label}"
                             VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Micro}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Pick exactly which facts the card carries: your name, rank, emblem, ranked record, rating and the session timer, plus which line Discord shows as your status. Start from a preset or tick each field yourself. Nothing is sent while the game and the launcher card are off." />
              </StackPanel>

              <TextBlock Grid.Row="3" Text="application id" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,10,12,6" />
              <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,5">
                <TextBox Text="{Binding DiscordApplicationId, UpdateSourceTrigger=PropertyChanged}" Width="240" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Text.Micro}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Prefilled with Optima's own Discord application. Change it only to use your own; clear it to keep presence off. Presence goes to your local Discord client; the only request over the network asks discord.com which artwork the application has." />
              </StackPanel>

              <TextBlock Grid.Row="4" Text="bot account link" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,10,12,6" />
              <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,5">
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource SecondaryButton}" Content="link account…" Padding="12,6"
                          Command="{Binding LinkDiscordCommand}" />
                  <TextBlock Text="{Binding DiscordBotLinkSummary}" Style="{StaticResource Text.Label}"
                             VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Micro}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Run /link with OptimaBot in Discord, then type the code it sends you into the window this button opens. Optima links the account above, so your own card needs no name and carries a linked badge. To undo it, run the bot's unlink command where the bot is hosted." />
              </StackPanel>

              <TextBlock Grid.Row="6" Text="tracker webhook" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,10,12,6" />
              <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,5">
                <WrapPanel>
                  <TextBox Text="{Binding DiscordBotWebhookUrl, UpdateSourceTrigger=PropertyChanged}" Width="420"
                           VerticalAlignment="Center" />
                  <Button Style="{StaticResource SecondaryButton}" Content="send test image" Padding="12,6" Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          Command="{Binding TestTrackerCommand}"
                          ToolTip="Sends one sample report through the bot to the webhook above, so you can see it arrive before a real match does." />
                </WrapPanel>
                <TextBlock Style="{StaticResource Text.Micro}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Optional. Paste a Discord channel webhook (channel settings, Integrations, Webhooks) and OptimaBot posts your new matches and rank changes there as a report image. Clear it to link without tracking. The test button sends a sample image through the bot, so the channel and the URL can be checked before a match happens." />
              </StackPanel>
            </Grid>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Section}" Header="OVERLAY AND WATCHDOG">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
              </Grid.RowDefinitions>

              <TextBlock Text="fps overlay" Style="{StaticResource RowLabel}" />
              <CheckBox Grid.Column="1" IsChecked="{Binding OverlayEnabled}" VerticalAlignment="Center" Margin="0,5"
                        Content="show fps over the game (Alt+F10 toggles it any time)" />

              <TextBlock Grid.Row="1" Text="overlay corner" Style="{StaticResource RowLabel}" />
              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CornerOptions}" SelectedItem="{Binding OverlayCorner}"
                        Width="200" HorizontalAlignment="Left" Margin="0,5" />

              <TextBlock Grid.Row="2" Text="overlay opacity" Style="{StaticResource RowLabel}" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding OpacityOptions}" SelectedItem="{Binding OverlayOpacity}"
                        Width="200" HorizontalAlignment="Left" Margin="0,5" />

              <TextBlock Grid.Row="3" Text="network line" Style="{StaticResource RowLabel}" />
              <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding OverlayShowNetwork}" VerticalAlignment="Center" Margin="0,5"
                        Content="show ping, jitter and loss below the fps readout" />

              <TextBlock Grid.Row="4" Text="reference host" Style="{StaticResource RowLabel}" />
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding NetworkReferenceHost}" Width="200"
                       HorizontalAlignment="Left" Margin="0,5"
                       ToolTip="pinged for link quality when no game endpoint answers ICMP" />

              <TextBlock Grid.Row="5" Text="crash relaunch" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,10,12,6" />
              <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,5">
                <CheckBox IsChecked="{Binding AutoRelaunchOnCrash}" VerticalAlignment="Center"
                          Content="relaunch once if the game dies within five minutes" />
                <TextBlock Style="{StaticResource Text.Micro}" Margin="25,3,0,0" TextWrapping="Wrap"
                           Text="A normal quit is never relaunched: only a game process that dies on its own early in a session triggers one automatic relaunch of the same profile. Off by default." />
              </StackPanel>

              <TextBlock Grid.Row="6" Text="watchdog auto-attach" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,10,12,6" />
              <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,5">
                <CheckBox IsChecked="{Binding EnableWatchMode}" VerticalAlignment="Center"
                          Content="apply the profile when the game starts outside Optima" />
                <TextBlock Style="{StaticResource Text.Micro}" Margin="25,3,0,0" TextWrapping="Wrap"
                           Text="Applies the full profile including the virtual display, so the screen can visibly reconfigure when the game is detected. Everything is restored when the game exits." />
              </StackPanel>
            </Grid>
          </HeaderedContentControl>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <HeaderedContentControl Style="{StaticResource Section}" Header="PLAYER">
            <StackPanel>
              <TextBlock Text="In-game name or account ID" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding PlayerQuery, UpdateSourceTrigger=PropertyChanged}" MinHeight="38">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding TrackCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="e.g. Kestrel or 48211907" Style="{StaticResource Placeholder}" />
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Track" Padding="22,8" Margin="10,0,0,0"
                        Command="{Binding TrackCommand}" />
              </Grid>
              <TextBlock Text="{Binding TrackMessage}" Style="{StaticResource Text.Label}" Foreground="{DynamicResource Brush.Warn}"
                         TextWrapping="Wrap" Margin="0,8,0,0"
                         Visibility="{Binding TrackMessage, Converter={StaticResource EmptyToCollapsed}}" />
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TrackedCard}" Margin="0,14,0,0"
                              Visibility="{Binding HasTrackedPlayer, Converter={StaticResource BoolToVis}}" />
              <TextBlock Text="Saved in Optima" Style="{StaticResource Text.Label}" Margin="0,16,0,8" />
              <ItemsControl ItemsSource="{Binding SavedPlayers}" ItemTemplate="{StaticResource SavedChip}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Text="Nobody saved yet. Track a player, then save them to Optima." Style="{StaticResource NoSavedPlayers}" />
              <TextBlock Style="{StaticResource Text.Micro}" Margin="0,10,0,0" TextWrapping="Wrap"
                         Text="Stats come from Critical Force's public profile API. An ID is exact and survives a rename; a name is looked up as typed." />
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Section}" Header="GENERAL">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
              </Grid.RowDefinitions>

              <TextBlock Text="display provider" Style="{StaticResource RowLabel}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding Provider}"
                        Width="200" HorizontalAlignment="Left" Margin="0,5" />

              <TextBlock Grid.Row="1" Text="frametime capture" Style="{StaticResource RowLabel}" />
              <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding EnableFrametimeCapture}" VerticalAlignment="Center" Margin="0,5"
                        Content="collect FPS via event tracing (elevated helper)" />

              <TextBlock Grid.Row="2" Text="minimum log level" Style="{StaticResource RowLabel}" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding LogLevel}"
                        Width="200" HorizontalAlignment="Left" Margin="0,5" />

              <TextBlock Grid.Row="3" Text="developer mode" Style="{StaticResource RowLabel}" />
              <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding DeveloperMode}" VerticalAlignment="Center" Margin="0,5"
                        Content="show the Developer page (Alt+D)" />

              <TextBlock Grid.Row="4" Text="keep in tray" Style="{StaticResource RowLabel}" />
              <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding KeepInTrayOnClose}" VerticalAlignment="Center" Margin="0,5"
                        Content="closing the window keeps Optima in the tray" />

              <TextBlock Grid.Row="5" Text="start with Windows" Style="{StaticResource RowLabel}" />
              <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" Margin="0,5"
                        Content="launch the Watchdog minimized to the tray at sign-in" />

              <TextBlock Grid.Row="6" Text="updates" Style="{StaticResource RowLabel}" />
              <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding CheckForUpdatesAtStart}" VerticalAlignment="Center" Margin="0,5"
                        Content="check for a newer Optima at every start (one request to GitHub)" />

              <TextBlock Grid.Row="7" Text="mock fps provider" Style="{StaticResource RowLabel}" />
              <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding UseMockMetricsProvider}" VerticalAlignment="Center" Margin="0,5"
                        Content="developer: synthetic fps data (applies after restart)" />

            </Grid>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Section}" Header="PATH OVERRIDES">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Micro}" Margin="0,0,0,8" TextWrapping="Wrap"
                         Text="Leave empty for automatic detection. Fallbacks for unusual installations, so a Google Play Games update can be accommodated without a new build." />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Text="play games folder" Style="{StaticResource RowLabel}" />
                <TextBox Grid.Column="1" Text="{Binding ManualInstallPath}" Margin="0,5" />

                <TextBlock Grid.Row="1" Text="vdd settings xml" Style="{StaticResource RowLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VddSettingsPath}" Margin="0,5"
                         ToolTip="default: C:\VirtualDisplayDriver\vdd_settings.xml" />

                <TextBlock Grid.Row="2" Text="custom launch command" Style="{StaticResource RowLabel}" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomLaunchCommand}" Margin="0,5"
                         ToolTip="last launch strategy. placeholders: {uri} and {package}" />

              </Grid>
            </StackPanel>
          </HeaderedContentControl>
        </StackPanel>
      </Grid>

    </StackPanel>
  </ScrollViewer>

  <!-- Pinned save bar: the one save control on the page. It appears whenever anything
       differs from the last save, and confirms in place with [ OK ] before fading out. -->
  <Border x:Name="SaveBar" VerticalAlignment="Bottom" ctl:Flow.Arrive="14"
          Background="{DynamicResource Brush.Surface}"
          BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="0,1,0,0"
          Padding="22,10" Visibility="{Binding SaveBarVisible, Converter={StaticResource BoolToVis}}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding SaveBarMark}" FontSize="{StaticResource Type.Label}"
                   Foreground="{Binding SaveBarMark, Converter={StaticResource SaveMarkBrush}}"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Text="{Binding SaveBarText}" Style="{StaticResource Text.Label}"
                   VerticalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Padding="28,10" MinWidth="200" MinHeight="40"
              Content="Save settings" Command="{Binding SaveCommand}"
              Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </Border>
  </Grid>
</UserControl>
