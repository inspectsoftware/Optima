<UserControl x:Class="Optima.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRoot}" MaxWidth="820" HorizontalAlignment="Left">

      <TextBlock Text="Settings" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="%LOCALAPPDATA%\Optima" Style="{StaticResource Text.PageSubtitle}" />

      <HeaderedContentControl Style="{StaticResource Section}" Header="APPEARANCE">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition /><RowDefinition /><RowDefinition />
          </Grid.RowDefinitions>

          <TextBlock Text="theme" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"
                    Width="210" HorizontalAlignment="Left" Margin="0,5" />

          <TextBlock Grid.Row="1" Text="accent" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
            <ItemsControl ItemsSource="{Binding AccentPresets}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" Cursor="Hand"
                          ToolTip="{Binding Name}" Margin="0,0,7,0">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch" Width="22" Height="22" CornerRadius="7"
                                Background="{Binding Hex, Converter={StaticResource HexToBrush}}"
                                BorderBrush="{DynamicResource Brush.Glass.Highlight}" BorderThickness="1" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource Brush.Text}" />
                            <Setter TargetName="Swatch" Property="BorderThickness" Value="2" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" Width="92"
                     Margin="6,0,0,0" VerticalAlignment="Center"
                     ToolTip="Custom accent as #RRGGBB" />
            <Border Width="22" Height="22" CornerRadius="7" Margin="8,0,0,0" VerticalAlignment="Center"
                    Background="{Binding AccentColor, Converter={StaticResource HexToBrush}}"
                    BorderBrush="{DynamicResource Brush.Glass.Border}" BorderThickness="1"
                    ToolTip="Preview of the accent that will apply on save" />
          </StackPanel>

          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.Micro}" Margin="0,2,0,4"
                     Text="Theme and accent apply the moment you save · no restart needed" />
        </Grid>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="PLAYER">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <TextBlock Text="in-game name" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <StackPanel Grid.Column="1" Margin="0,5">
            <TextBox Text="{Binding PlayerIgn, UpdateSourceTrigger=PropertyChanged}" Width="240" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Text.Micro}" Margin="0,4,0,0" MaxWidth="560" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Text="Your Critical Ops player name, used only to read your public profile from Critical Force's public API so sessions can record ranked kills, deaths and wins. Leave empty to disable all stat lookups." />
          </StackPanel>
        </Grid>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="DISCORD">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition /><RowDefinition /><RowDefinition />
          </Grid.RowDefinitions>

          <TextBlock Text="game activity" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <CheckBox Grid.Column="1" IsChecked="{Binding DiscordPresenceEnabled}"
                    VerticalAlignment="Center" Margin="0,5"
                    Content="show Critical Ops activity on Discord while the game runs" />

          <TextBlock Grid.Row="1" Text="launcher activity" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding DiscordPresenceInLauncher}"
                    IsEnabled="{Binding DiscordPresenceEnabled}"
                    VerticalAlignment="Center" Margin="0,5"
                    Content="also show presence while browsing the launcher (never from the tray)" />

          <TextBlock Grid.Row="2" Text="application id" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,5">
            <TextBox Text="{Binding DiscordApplicationId, UpdateSourceTrigger=PropertyChanged}" Width="240" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Text.Micro}" Margin="0,4,0,0" MaxWidth="560" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Text="Prefilled with Optima's own Discord application, so activity works out of the box. Change it only to use your own Discord application; clear it to keep presence off entirely. Presence talks only to your local Discord client." />
          </StackPanel>
        </Grid>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="GENERAL">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
          </Grid.RowDefinitions>

          <TextBlock Text="virtual display provider" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ProviderOptions}" SelectedItem="{Binding Provider}"
                    Width="210" HorizontalAlignment="Left" Margin="0,5" />

          <TextBlock Grid.Row="1" Text="frametime capture" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding EnableFrametimeCapture}"
                    VerticalAlignment="Center" Margin="0,5"
                    Content="collect FPS externally via event tracing (needs the elevated helper)" />

          <TextBlock Grid.Row="2" Text="minimum log level" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding LogLevel}"
                    Width="210" HorizontalAlignment="Left" Margin="0,5" />

          <TextBlock Grid.Row="3" Text="developer mode" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding DeveloperMode}"
                    VerticalAlignment="Center" Margin="0,5"
                    Content="show the DEVELOPER page (Alt+D)" />

          <TextBlock Grid.Row="4" Text="keep in tray" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding KeepInTrayOnClose}"
                    VerticalAlignment="Center" Margin="0,5"
                    Content="closing the window keeps Optima in the tray (quit via EXIT in the tray menu)" />

          <TextBlock Grid.Row="5" Text="start with Windows" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding StartWithWindows}"
                    VerticalAlignment="Center" Margin="0,5"
                    Content="launch the Optima Watchdog minimized to the tray at sign-in" />

          <TextBlock Grid.Row="6" Text="mock fps provider" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding UseMockMetricsProvider}"
                    VerticalAlignment="Center" Margin="0,5"
                    Content="developer: synthetic fps data instead of the ETW trace (applies after restart)" />
        </Grid>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="OVERLAY AND WATCHDOG">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
          </Grid.RowDefinitions>

          <TextBlock Text="fps overlay" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <CheckBox Grid.Column="1" IsChecked="{Binding OverlayEnabled}"
                    VerticalAlignment="Center" Margin="0,5"
                    Content="show fps over the game while a session runs (alt+f10 toggles it any time)" />

          <TextBlock Grid.Row="1" Text="overlay corner" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CornerOptions}" SelectedItem="{Binding OverlayCorner}"
                    Width="210" HorizontalAlignment="Left" Margin="0,5" />

          <TextBlock Grid.Row="2" Text="overlay opacity" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding OpacityOptions}" SelectedItem="{Binding OverlayOpacity}"
                    Width="210" HorizontalAlignment="Left" Margin="0,5" />

          <TextBlock Grid.Row="3" Text="overlay network line" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding OverlayShowNetwork}"
                    VerticalAlignment="Center" Margin="0,5"
                    Content="show ping · jitter · loss below the fps readout" />

          <TextBlock Grid.Row="4" Text="network reference host" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding NetworkReferenceHost}" Width="210"
                   HorizontalAlignment="Left" Margin="0,5"
                   ToolTip="pinged for link quality when no game endpoint answers ICMP" />

          <TextBlock Grid.Row="5" Text="watchdog auto-attach" Style="{StaticResource Text.Label}"
                     VerticalAlignment="Center" Margin="0,5" />
          <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,5">
            <CheckBox IsChecked="{Binding EnableWatchMode}" VerticalAlignment="Center"
                      Content="apply the selected profile automatically when the game starts outside Optima" />
            <TextBlock Style="{StaticResource Text.Micro}" Margin="24,3,0,0" MaxWidth="560" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Text="applies the full profile including the virtual display, so the screen can visibly reconfigure when the game is detected · everything is restored when the game exits" />
          </StackPanel>
        </Grid>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="PATH OVERRIDES">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Prose}" Margin="0,0,0,10" MaxWidth="700" HorizontalAlignment="Left"
                     Text="Leave empty for automatic detection. These are the fallbacks for unusual installations, and they let a Google Play Games update be accommodated without a new build." />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="210" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Text="google play games folder" Style="{StaticResource Text.Label}"
                       VerticalAlignment="Center" Margin="0,5" />
            <TextBox Grid.Column="1" Text="{Binding ManualInstallPath}" Margin="0,5" />

            <TextBlock Grid.Row="1" Text="vdd settings xml" Style="{StaticResource Text.Label}"
                       VerticalAlignment="Center" Margin="0,5" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VddSettingsPath}" Margin="0,5"
                     ToolTip="default: C:\VirtualDisplayDriver\vdd_settings.xml" />

            <TextBlock Grid.Row="2" Text="custom launch command" Style="{StaticResource Text.Label}"
                       VerticalAlignment="Center" Margin="0,5" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomLaunchCommand}" Margin="0,5"
                     ToolTip="last launch strategy. placeholders: {uri} and {package}" />
          </Grid>
        </StackPanel>
      </HeaderedContentControl>

      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource PrimaryButton}" Padding="18,8" FontSize="{StaticResource Type.Label}"
                Content="Save settings" Command="{Binding SaveCommand}" />
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Ok}"
                   FontSize="{StaticResource Type.Label}" VerticalAlignment="Center" Margin="14,0,0,0" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
