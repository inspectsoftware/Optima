<UserControl x:Class="Optima.App.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Optima.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRoot}" MaxWidth="940" HorizontalAlignment="Left">

      <TextBlock Text="Display" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Virtual display control and attached monitors" Style="{StaticResource Text.PageSubtitle}" />

      <HeaderedContentControl Style="{StaticResource Section}" Header="OPTIMA VIRTUALIZATION">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ProviderName}" FontSize="{StaticResource Type.Title}"
                           Foreground="{DynamicResource Brush.Text}" />
                <Border Margin="12,0,0,0" VerticalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding VirtualDisplayActive}" Value="True">
                          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ok}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock>
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Badge}">
                        <Setter Property="Text" Value="OFF" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding VirtualDisplayActive}" Value="True">
                            <Setter Property="Text" Value="ACTIVE" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding ProviderCapabilities}" Style="{StaticResource Text.Micro}" Margin="0,5,0,0" />
              <TextBlock Text="{Binding VirtualDisplayModeText, StringFormat='mode · {0}'}"
                         Style="{StaticResource Text.Value}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Style="{StaticResource SecondaryButton}" Content="enable"
                      Command="{Binding EnableVirtualDisplayCommand}" Margin="0,0,8,0" />
              <Button Style="{StaticResource SecondaryButton}" Content="disable"
                      Command="{Binding DisableVirtualDisplayCommand}" Margin="0,0,8,0" />
              <Button Style="{StaticResource GhostButton}" Content="uninstall driver"
                      Command="{Binding UninstallDriverCommand}"
                      Visibility="{Binding DriverMissing, Converter={StaticResource InverseBoolToVis}}"
                      ToolTip="Removes the virtual display device Optima installed" />
            </StackPanel>
          </Grid>

          <Rectangle Height="1" Fill="{DynamicResource Brush.Hairline}" Margin="0,14" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="preset" Style="{StaticResource Text.Label}" VerticalAlignment="Center"
                       Width="70" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ComboBox ItemsSource="{Binding ModePresets}" SelectedItem="{Binding SelectedPreset}" Width="210" />
              <Button Style="{StaticResource SecondaryButton}" Content="apply"
                      Command="{Binding ApplyPresetCommand}" Margin="10,0,0,0" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="custom" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Width="70" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBox Text="{Binding CustomWidth}" Width="76" />
              <TextBlock Text="x" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding CustomHeight}" Width="76" />
              <TextBlock Text="@" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}" />
              <TextBox Text="{Binding CustomRefreshRate}" Width="64" />
              <TextBlock Text="Hz" Margin="6,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}" />
              <Button Style="{StaticResource SecondaryButton}" Content="apply"
                      Command="{Binding ApplyCustomModeCommand}" Margin="10,0,0,0" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ctl:AsciiSpinner Cells="12" Margin="0,0,10,0" />
            <TextBlock Text="working" Style="{StaticResource Text.Micro}" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Prose}"
                     Foreground="{DynamicResource Brush.Warn}" Margin="0,10,0,0" MaxWidth="760"
                     HorizontalAlignment="Left"
                     Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToCollapsed}}" />

          <!-- No driver device: offer to install the bundled package rather than dead-ending. -->
          <Border Style="{StaticResource Callout}" BorderBrush="{DynamicResource Brush.Warn}" Margin="0,12,0,0"
                  Visibility="{Binding DriverMissing, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="No virtual display device" Foreground="{DynamicResource Brush.Warn}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DriverBannerText}" Style="{StaticResource Text.Prose}"
                           Margin="0,4,0,0" MaxWidth="620" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding DriverPackageText}" Style="{StaticResource Text.Micro}" Margin="0,5,0,0"
                           Visibility="{Binding DriverPackageText, Converter={StaticResource EmptyToCollapsed}}" />
              </StackPanel>
              <!-- Only offer the install when there is something to install from; otherwise
                   offer the folder to put a package in, rather than an unpressable button. -->
              <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                      Padding="16,8" FontSize="{StaticResource Type.Label}"
                      Content="Install driver" Command="{Binding InstallDriverCommand}"
                      Margin="12,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding CanInstallDriver, Converter={StaticResource BoolToVis}}" />
              <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                      Padding="14,8" Content="open drivers folder"
                      Command="{Binding OpenDriversFolderCommand}"
                      Margin="12,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding CanInstallDriver, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>
          </Border>

          <Border Style="{StaticResource Callout}" BorderBrush="{DynamicResource Brush.Warn}" Margin="0,10,0,0"
                  Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource Text.Prose}" MaxWidth="760" HorizontalAlignment="Left"
                       Foreground="{DynamicResource Brush.Warn}"
                       Text="Windows asked for a restart to finish installing the display driver. The virtual display will not appear until you restart." />
          </Border>

          <!-- Safety net: the topology captured before any change can always be put back -->
          <Border Style="{StaticResource Callout}" BorderBrush="{DynamicResource Brush.Warn}" Margin="0,12,0,0"
                  Visibility="{Binding CanEmergencyRestore, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Display configuration changed this session"
                           Foreground="{DynamicResource Brush.Warn}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Text.Prose}" Margin="0,4,0,0" MaxWidth="560"
                           HorizontalAlignment="Left"
                           Text="If anything looks wrong, this puts the previous layout back immediately." />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Emergency restore"
                      Command="{Binding EmergencyRestoreCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="ATTACHED DISPLAYS">
        <HeaderedContentControl.Tag>
          <StackPanel Orientation="Horizontal">
            <CheckBox Content="hide inactive" IsChecked="{Binding HideInactive}"
                      FontSize="{StaticResource Type.Micro}" VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="Hide attached outputs that are not driving a desktop (0x0 @ 0 Hz)" />
            <CheckBox Content="show hidden" IsChecked="{Binding ShowHidden}"
                      FontSize="{StaticResource Type.Micro}" VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="Reveal displays you removed from this list" />
            <Button Style="{StaticResource GhostButton}" Content="refresh" Command="{Binding RefreshCommand}" Padding="6,0" />
          </StackPanel>
        </HeaderedContentControl.Tag>
        <ItemsControl ItemsSource="{Binding DisplayRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource TableRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding DeviceName}" Style="{StaticResource Text.CellDim}" />

                  <!-- Name cell: custom name when set (original in the tooltip), or an inline editor. -->
                  <TextBlock Grid.Column="1" Text="{Binding DisplayedName}" ToolTip="{Binding OriginalName}"
                             Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Cell}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsHidden}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,0,10,0" VerticalAlignment="Center"
                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                           ToolTip="Leave empty to restore the original name">
                    <TextBox.InputBindings>
                      <KeyBinding Key="Return"
                                  Command="{Binding DataContext.SaveNameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" />
                      <KeyBinding Key="Escape"
                                  Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" />
                    </TextBox.InputBindings>
                  </TextBox>

                  <TextBlock Grid.Column="2" Text="{Binding CurrentMode}" Style="{StaticResource Text.Cell}" />
                  <TextBlock Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Badge}">
                        <Setter Property="Text" Value="" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Hairline}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                            <Setter Property="Text" Value="PRIMARY" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                          </DataTrigger>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsActive}" Value="True" />
                              <Condition Binding="{Binding IsPrimary}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Text" Value="ACTIVE" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                          </MultiDataTrigger>
                          <DataTrigger Binding="{Binding IsHidden}" Value="True">
                            <Setter Property="Text" Value="HIDDEN" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>

                  <!-- Row controls: reorder / rename / hide, swapping to save / cancel while editing. -->
                  <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                      <Button Style="{StaticResource GhostButton}" Content="&#x2191;" Padding="5,0" ToolTip="Move up"
                              Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                      <Button Style="{StaticResource GhostButton}" Content="&#x2193;" Padding="5,0" ToolTip="Move down"
                              Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                      <Button Style="{StaticResource GhostButton}" Content="rename" Padding="5,0"
                              Command="{Binding DataContext.StartRenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                      <Button Padding="5,0"
                              Command="{Binding DataContext.ToggleHiddenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Setter Property="Content" Value="hide" />
                            <Setter Property="ToolTip" Value="Remove this display from the list (Optima only; Windows is untouched)" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter Property="Content" Value="unhide" />
                                <Setter Property="ToolTip" Value="Put this display back in the list" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                      <Button Style="{StaticResource GhostButton}" Content="save" Padding="5,0"
                              Command="{Binding DataContext.SaveNameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                      <Button Style="{StaticResource GhostButton}" Content="cancel" Padding="5,0"
                              Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </HeaderedContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
