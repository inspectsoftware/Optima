<UserControl x:Class="Optima.App.Views.UpdateLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRoot}" MaxWidth="920" HorizontalAlignment="Left">

      <TextBlock Text="Updates" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="{Binding BuildInfo}" Style="{StaticResource Text.PageSubtitle}" />

      <!-- Launcher self-update -->
      <HeaderedContentControl Style="{StaticResource Section}" Header="LAUNCHER">
        <HeaderedContentControl.Tag>
          <Button Style="{StaticResource GhostButton}" Content="check now" Padding="6,0"
                  Command="{Binding CheckNowCommand}" />
        </HeaderedContentControl.Tag>
        <StackPanel>
          <TextBlock Text="{Binding LauncherStatus}" Style="{StaticResource Text.Value}" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource PrimaryButton}" Padding="16,8" FontSize="{StaticResource Type.Label}"
                    Content="Download and restart" Command="{Binding DownloadAndInstallCommand}"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                    IsEnabled="{Binding UpdateBusy, Converter={StaticResource InverseBool}}" />
            <Button Style="{StaticResource SecondaryButton}" Content="roll back to the previous build"
                    Command="{Binding RollbackCommand}" Margin="10,0,0,0"
                    Visibility="{Binding RollbackAvailable, Converter={StaticResource BoolToVis}}"
                    IsEnabled="{Binding UpdateBusy, Converter={StaticResource InverseBool}}" />
          </StackPanel>
          <TextBlock Style="{StaticResource Text.Micro}" Margin="0,8,0,0" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap"
                     Text="Updates come from the project's GitHub releases. Applying an update keeps the previous build for one-click rollback; the install folder is managed by the updater." />
        </StackPanel>
      </HeaderedContentControl>

      <!-- Critical Ops news -->
      <HeaderedContentControl Style="{StaticResource Section}" Header="CRITICAL OPS NEWS">
        <HeaderedContentControl.Tag>
          <TextBox Text="{Binding NewsFilter, UpdateSourceTrigger=PropertyChanged}" Width="180"
                   VerticalAlignment="Center" ToolTip="Filter the feed (e.g. controls, map, clan)" />
        </HeaderedContentControl.Tag>
        <StackPanel>
          <TextBlock Text="{Binding NewsStatus}" Style="{StaticResource Text.Label}"
                     Visibility="{Binding NewsStatus, Converter={StaticResource EmptyToCollapsed}}" />
          <ItemsControl ItemsSource="{Binding News}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,10">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Font.Body}"
                                 FontSize="{StaticResource Type.Title}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.Text}" />
                      <TextBlock Grid.Column="1" Text="{Binding StatusTag}" Margin="10,0"
                                 FontSize="{StaticResource Type.Micro}" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                            <Setter Property="FontSize" Value="{StaticResource Type.Micro}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="full notes" Padding="6,0"
                              Command="{Binding OpenNotesCommand}"
                              ToolTip="Opens the official patch notes in your browser" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Headlines}" Margin="0,8,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Border Width="4" Height="4" CornerRadius="2" Margin="1,0,9,0"
                                    Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Label}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </HeaderedContentControl>

      <!-- Optima changelog (the shipped CHANGELOG.md) -->
      <HeaderedContentControl Style="{StaticResource Section}" Header="OPTIMA UPDATE LOG">
        <StackPanel>
          <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Label}" Margin="0,0,0,6"
                     Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}" />
          <ItemsControl ItemsSource="{Binding Entries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <HeaderedContentControl Style="{StaticResource Section}" Header="{Binding Title}">
                  <HeaderedContentControl.Tag>
                    <TextBlock Text="{Binding Date, StringFormat=[ {0} ]}" Style="{StaticResource Text.Micro}"
                               VerticalAlignment="Center" />
                  </HeaderedContentControl.Tag>
                  <ItemsControl ItemsSource="{Binding Changes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,3">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text=">" Style="{StaticResource Text.Micro}" />
                          <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Text.Prose}"
                                     TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </HeaderedContentControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </HeaderedContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
