<UserControl x:Class="Optima.App.Views.UpdateLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRoot}" MaxWidth="920" HorizontalAlignment="Left">
      <TextBlock Text="Updates" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="{Binding BuildInfo}" Style="{StaticResource Text.PageSubtitle}" />

      <HeaderedContentControl Style="{StaticResource Section}" Header="NEW VERSIONS">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource SecondaryButton}" Content="check now" Padding="12,6"
                    Command="{Binding Updates.CheckNowCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Content="Update" Padding="18,6" Margin="8,0,0,0"
                    Command="{Binding Updates.InstallCommand}"
                    Visibility="{Binding Updates.UpdateAvailable, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Updates.Status}" Style="{StaticResource Text.Label}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding Updates.BannerText}" Style="{StaticResource Text.Prose}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding Updates.Problem}" Style="{StaticResource Text.Prose}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Foreground="{DynamicResource Brush.Warn}"
                     Visibility="{Binding Updates.Problem, Converter={StaticResource EmptyToCollapsed}}" />
          <TextBlock Style="{StaticResource Text.Micro}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="Optima asks GitHub once at every start whether a newer version is out (Settings turns that off). Nothing is downloaded until you press Update. The setup is checked against Optima's own signature before it runs, and Windows asks once for administrator approval." />
        </StackPanel>
      </HeaderedContentControl>

      <HeaderedContentControl Style="{StaticResource Section}" Header="OPTIMA UPDATE LOG">
        <StackPanel>
          <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Label}" Margin="0,0,0,6"
                     Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}" />
          <ItemsControl ItemsSource="{Binding Entries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <HeaderedContentControl Style="{StaticResource Section}" Header="{Binding Title}">
                  <HeaderedContentControl.Tag>
                    <TextBlock Text="{Binding Date}" Style="{StaticResource Text.Micro}"
                               VerticalAlignment="Center" />
                  </HeaderedContentControl.Tag>
                  <ItemsControl ItemsSource="{Binding Changes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,3">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text=">" Style="{StaticResource Text.Micro}" />
                          <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Text.Prose}"
                                     TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </HeaderedContentControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </HeaderedContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
