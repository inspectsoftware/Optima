<UserControl x:Class="Optima.App.Views.UpdateLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRoot}" MaxWidth="880" HorizontalAlignment="Left">

      <TextBlock Text="Update log" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="{Binding BuildInfo}" Style="{StaticResource Text.PageSubtitle}" />

      <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Label}" Margin="0,10,0,0"
                 Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}" />

      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <HeaderedContentControl Style="{StaticResource Section}" Header="{Binding Title}">
              <HeaderedContentControl.Tag>
                <TextBlock Text="{Binding Date, StringFormat=[ {0} ]}" Style="{StaticResource Text.Micro}"
                           VerticalAlignment="Center" />
              </HeaderedContentControl.Tag>
              <ItemsControl ItemsSource="{Binding Changes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text=">" Style="{StaticResource Text.Micro}" />
                      <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Text.Prose}"
                                 TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </HeaderedContentControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
