<UserControl x:Class="Optima.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Style="{StaticResource PageRoot}" MaxWidth="1000" HorizontalAlignment="Left">

      <TextBlock Text="Performance" Style="{StaticResource Text.PageTitle}" />
      <TextBlock Text="Windows tweaks · profiles · per-setting disclosure" Style="{StaticResource Text.PageSubtitle}" />

      <!-- Windows tweak catalog: persistent per-tweak toggles, originals captured before
           any write, individually reversible. -->
      <HeaderedContentControl Style="{StaticResource Section}" Header="WINDOWS TWEAKS">
        <HeaderedContentControl.Tag>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource GhostButton}" Content="revert all" Padding="6,0"
                    Command="{Binding DisableAllTweaksCommand}"
                    ToolTip="Disables every enabled tweak and restores the captured original values" />
            <Button Style="{StaticResource GhostButton}" Content="refresh" Padding="6,0"
                    Command="{Binding ReloadTweaksCommand}" />
          </StackPanel>
        </HeaderedContentControl.Tag>
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding TweaksBusy}" Value="True">
                  <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <TextBlock Style="{StaticResource Text.Prose}" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,0,8"
                     Text="These stay on until you turn them off, unlike profile settings which only last for a session. Before a tweak is first applied, Optima records the exact registry values it is replacing; disabling puts those originals back. Expand any row to see what it really does before deciding." />

          <ItemsControl ItemsSource="{Binding TweakGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,2,0,8">
                  <TextBlock Text="{Binding Category}" Style="{StaticResource Text.TableHeader}" Margin="0,4,0,2" />
                  <ItemsControl ItemsSource="{Binding Tweaks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource TableRow}">
                          <Expander Margin="0,1">
                            <Expander.Header>
                              <StackPanel Orientation="Horizontal">
                                <Button Padding="4,0" MinWidth="76"
                                        Command="{Binding DataContext.ToggleTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Click to toggle">
                                  <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                      <Setter Property="Content" Value="[ OFF ]" />
                                      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Enabled">
                                          <Setter Property="Content" Value="[ ON ]" />
                                          <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Mixed">
                                          <Setter Property="Content" Value="[ MIXED ]" />
                                          <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Button.Style>
                                </Button>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Value}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock Text="[ ADMIN ]" FontSize="{StaticResource Type.Micro}"
                                           Foreground="{DynamicResource Brush.Warn}" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="[ RESTART ]" FontSize="{StaticResource Type.Micro}"
                                           Foreground="{DynamicResource Brush.Warn}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="[ MODERATE ]" FontSize="{StaticResource Type.Micro}"
                                           Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           ToolTip="Worth reading the downside before enabling"
                                           Visibility="{Binding IsModerateRisk, Converter={StaticResource BoolToVis}}" />
                              </StackPanel>
                            </Expander.Header>
                            <Grid Margin="86,4,0,10">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition />
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                              </Grid.RowDefinitions>
                              <TextBlock Text="changes" Style="{StaticResource Text.Label}" Margin="0,3" />
                              <TextBlock Grid.Column="1" Text="{Binding WhatItChanges}" Style="{StaticResource Text.Prose}"
                                         MaxWidth="680" HorizontalAlignment="Left" Margin="0,3" />
                              <TextBlock Grid.Row="1" Text="benefit" Style="{StaticResource Text.Label}" Margin="0,3" />
                              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PotentialBenefit}" Style="{StaticResource Text.Prose}"
                                         Foreground="{DynamicResource Brush.Ok}" MaxWidth="680" HorizontalAlignment="Left" Margin="0,3" />
                              <TextBlock Grid.Row="2" Text="downside" Style="{StaticResource Text.Label}" Margin="0,3" />
                              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PotentialDownside}" Style="{StaticResource Text.Prose}"
                                         Foreground="{DynamicResource Brush.Warn}" MaxWidth="680" HorizontalAlignment="Left" Margin="0,3" />
                            </Grid>
                          </Expander>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding TweaksStatus}" Style="{StaticResource Text.Prose}"
                     Foreground="{DynamicResource Brush.Warn}" Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left"
                     Visibility="{Binding TweaksStatus, Converter={StaticResource EmptyToCollapsed}}" />
        </StackPanel>
      </HeaderedContentControl>

      <!-- Profile list + editor -->
      <HeaderedContentControl Style="{StaticResource Section}" Header="PROFILES">
        <HeaderedContentControl.Tag>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource GhostButton}" Content="import" Command="{Binding ImportProfileCommand}" Padding="6,0" />
            <Button Style="{StaticResource GhostButton}" Content="export" Command="{Binding ExportProfileCommand}" Padding="6,0" />
          </StackPanel>
        </HeaderedContentControl.Tag>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>

          <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MaxHeight="270">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,3">
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Value}" />
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Prose}"
                             FontSize="{StaticResource Type.Micro}" Foreground="{DynamicResource Brush.TextMuted}"
                             MaxWidth="230" HorizontalAlignment="Left" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Column="2">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                <RowDefinition /><RowDefinition /><RowDefinition />
              </Grid.RowDefinitions>

              <TextBlock Text="name" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
              <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

              <TextBlock Grid.Row="1" Text="virtual display" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
              <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding EditVirtualDisplay}" VerticalAlignment="Center" Margin="0,4"
                        Content="enable for this profile" />

              <TextBlock Grid.Row="2" Text="resolution" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                <TextBox Text="{Binding EditWidth}" Width="64" />
                <TextBlock Text="x" Margin="6,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding EditHeight}" Width="64" />
                <TextBlock Text="@" Margin="6,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}" />
                <TextBox Text="{Binding EditRefreshRate}" Width="52" />
                <TextBlock Text="Hz" Margin="6,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}" />
              </StackPanel>

              <TextBlock Grid.Row="3" Text="power plan" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
              <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding PowerPlanOptions}"
                        SelectedItem="{Binding EditPowerPlan}" Width="210" HorizontalAlignment="Left" Margin="0,4" />

              <TextBlock Grid.Row="4" Text="process priority" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding PriorityOptions}"
                        SelectedItem="{Binding EditPriority}" Width="210" HorizontalAlignment="Left" Margin="0,4" />

              <TextBlock Grid.Row="5" Text="power throttling" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4" />
              <CheckBox Grid.Row="5" Grid.Column="1" Content="disable for game processes"
                        IsChecked="{Binding EditDisableThrottling}" VerticalAlignment="Center" Margin="0,4" />

              <TextBlock Grid.Row="6" Text="close before launch" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,4"
                         ToolTip="Comma-separated process names. Only these are ever closed, and only when this profile runs." />
              <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding EditCleanupList}" Margin="0,4"
                       ToolTip="e.g. Discord, SteamWebHelper. System and Google Play Games processes are always refused" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Style="{StaticResource PrimaryButton}" Padding="16,7" FontSize="{StaticResource Type.Label}"
                      Content="Save profile" Command="{Binding SaveProfileCommand}" Margin="0,0,8,0" />
              <Button Style="{StaticResource SecondaryButton}" Content="delete" Command="{Binding DeleteProfileCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding EditorStatus}" Style="{StaticResource Text.Prose}"
                       Foreground="{DynamicResource Brush.Warn}" Margin="0,8,0,0" MaxWidth="560" HorizontalAlignment="Left"
                       Visibility="{Binding EditorStatus, Converter={StaticResource EmptyToCollapsed}}" />
          </StackPanel>
        </Grid>
      </HeaderedContentControl>

      <!-- Per-setting disclosure -->
      <HeaderedContentControl Style="{StaticResource Section}" Header="WHAT EACH SETTING DOES">
        <ItemsControl ItemsSource="{Binding Explanations}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Expander Margin="0,1">
                <Expander.Header>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Value}" />
                </Expander.Header>
                <Grid Margin="0,4,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                  </Grid.RowDefinitions>
                  <TextBlock Text="changes" Style="{StaticResource Text.Label}" Margin="0,3" />
                  <TextBlock Grid.Column="1" Text="{Binding WhatItChanges}" Style="{StaticResource Text.Prose}"
                             MaxWidth="700" HorizontalAlignment="Left" Margin="0,3" />
                  <TextBlock Grid.Row="1" Text="benefit" Style="{StaticResource Text.Label}" Margin="0,3" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PotentialBenefit}" Style="{StaticResource Text.Prose}"
                             Foreground="{DynamicResource Brush.Ok}" MaxWidth="700" HorizontalAlignment="Left" Margin="0,3" />
                  <TextBlock Grid.Row="2" Text="downside" Style="{StaticResource Text.Label}" Margin="0,3" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PotentialDownside}" Style="{StaticResource Text.Prose}"
                             Foreground="{DynamicResource Brush.Warn}" MaxWidth="700" HorizontalAlignment="Left" Margin="0,3" />
                  <TextBlock Grid.Row="3" Text="requires" Style="{StaticResource Text.Label}" Margin="0,3" />
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                    <TextBlock Text="[ RESTART ]" FontSize="{StaticResource Type.Micro}"
                               Foreground="{DynamicResource Brush.Warn}" Margin="0,0,10,0"
                               Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="[ ADMIN ]" FontSize="{StaticResource Type.Micro}"
                               Foreground="{DynamicResource Brush.Warn}"
                               Visibility="{Binding RequiresAdministrator, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="[ NOTHING ]" FontSize="{StaticResource Type.Micro}"
                               Foreground="{DynamicResource Brush.TextMuted}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RequiresRestart}" Value="False" />
                                <Condition Binding="{Binding RequiresAdministrator}" Value="False" />
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </HeaderedContentControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>
